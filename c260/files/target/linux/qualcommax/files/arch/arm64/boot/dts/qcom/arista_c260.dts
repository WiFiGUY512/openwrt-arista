// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Arista C-260 -- Qualcomm IPQ8078A based campus access point
 *
 * The vendor device tree is Qualcomm's HK01 reference with Arista's switch
 * values in it: model "Qualcomm Technologies, Inc. IPQ807x/AP-HK01-C1",
 * compatible "qcom,ipq807x-hk01", board-id <8 0>, machid 0x8010000. The kernel
 * names the part IPQ8078A, SoC version 2.0. 1 GiB DDR4; 32 MiB SPI NOR
 * (MX25U25635F) and 512 MiB NAND (Macronix MX30UF4G18AB).
 *
 * Here: the console, both 5 GbE ports, the IPQ8074's own 2.4 and 5 GHz
 * radios, the QCA988x third radio on PCIe 0, the LEDs (a 74LV164 chain on
 * gpio18-20), the button (gpio52, active low), USB, and the UART of the
 * Bluetooth controller (a CSR8811, blsp1_uart3, gpio46-49; its enable,
 * gpio51, is driven by arista-c260-bluetooth). The board has no
 * TPM: the C-360's TPM bus is disabled in the vendor tree, and the pin the
 * C-360 uses for it is the button here.
 *
 * Flash: OpenWrt lives in NAND slot 0 ("ubi": kernel, rootfs and rootfs_data
 * volumes, as sysupgrade writes them); Arista stays in slot 1 and in the SPI
 * NOR, as the fallback and as the source of the IPQ8074 board data. Only slot
 * 0 and U-Boot's environment (0:APPSBLENV, for fw_setenv) can be written;
 * every other partition is read-only, ART (calibration and MACs) above all.
 */

/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Arista C-260";
	/* "qcom,ipq8074" for qcom-cpufreq-nvmem, as on the C-360. */
	compatible = "arista,c260", "qcom,ipq8074";

	/*
	 * msm_serial numbers a UART by its alias: without serial1, the
	 * Bluetooth UART (probed first) takes ttyMSM0 from the console.
	 */
	aliases {
		serial0 = &blsp1_uart5;
		serial1 = &blsp1_uart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyMSM0,115200n8 rootwait pcie_ports=compat";
	};

	/* 1 GiB at 0x40000000. */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	/*
	 * The vendor tree's spans beyond what ipq8074.dtsi reserves (bootloader,
	 * sbl, smem and tz): U-Boot has loaded NSS firmware into the first, and
	 * the Wi-Fi spans belong to the radios' firmware. wifi_dump covers the
	 * vendor's overlapping wigig_dump, and the QCN9000's vendor base-addr.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		nss@40000000 {
			reg = <0x0 0x40000000 0x0 0x1000000>;
			no-map;
		};

		tzapp@4a400000 {
			reg = <0x0 0x4a400000 0x0 0x200000>;
			no-map;
		};

		wcnss@4b000000 {
			reg = <0x0 0x4b000000 0x0 0x5f00000>;
			no-map;
		};

		q6_etr_dump@50f00000 {
			reg = <0x0 0x50f00000 0x0 0x100000>;
			no-map;
		};

		m3_dump@51000000 {
			reg = <0x0 0x51000000 0x0 0x100000>;
			no-map;
		};

		wifi_dump@51100000 {
			reg = <0x0 0x51100000 0x0 0x600000>;
			no-map;
		};
	};
};

/* The console: ttyMSM0, by its serial0 alias. */
&blsp1_uart5 {
	status = "okay";
};

&blsp1_uart1 {
	status = "disabled";
};

/* The Bluetooth controller, a CSR8811 (Arista ships its csr8x11 patch). */
&blsp1_uart3 {
	pinctrl-0 = <&ble_uart_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb_0 {
	status = "okay";
};

&blsp1_uart6 {
	status = "disabled";
};

&sdhc_1 {
	status = "disabled";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "ubi";
				reg = <0x0 0x10000000>;
			};

			partition@10000000 {
				label = "rootfs_1";
				reg = <0x10000000 0x10000000>;
				read-only;
			};
		};
	};
};

&blsp1_spi1 {
	status = "okay";

	flash@0 {
		reg = <0>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x50000>;
				read-only;
			};

			partition@50000 {
				label = "0:MIBIB";
				reg = <0x50000 0x10000>;
				read-only;
			};

			partition@60000 {
				label = "0:BOOTCONFIG";
				reg = <0x60000 0x20000>;
				read-only;
			};

			partition@80000 {
				label = "0:BOOTCONFIG1";
				reg = <0x80000 0x20000>;
				read-only;
			};

			partition@a0000 {
				label = "0:QSEE";
				reg = <0xa0000 0x180000>;
				read-only;
			};

			partition@220000 {
				label = "0:QSEE_1";
				reg = <0x220000 0x180000>;
				read-only;
			};

			partition@3a0000 {
				label = "0:DEVCFG";
				reg = <0x3a0000 0x10000>;
				read-only;
			};

			partition@3b0000 {
				label = "0:DEVCFG_1";
				reg = <0x3b0000 0x10000>;
				read-only;
			};

			partition@3c0000 {
				label = "0:APDP";
				reg = <0x3c0000 0x10000>;
				read-only;
			};

			partition@3d0000 {
				label = "0:APDP_1";
				reg = <0x3d0000 0x10000>;
				read-only;
			};

			partition@3e0000 {
				label = "0:RPM";
				reg = <0x3e0000 0x40000>;
				read-only;
			};

			partition@420000 {
				label = "0:RPM_1";
				reg = <0x420000 0x40000>;
				read-only;
			};

			partition@460000 {
				label = "0:CDT";
				reg = <0x460000 0x10000>;
				read-only;
			};

			partition@470000 {
				label = "0:CDT_1";
				reg = <0x470000 0x10000>;
				read-only;
			};

			partition@480000 {
				label = "0:APPSBLENV";
				reg = <0x480000 0x10000>;
			};

			partition@490000 {
				label = "0:APPSBL";
				reg = <0x490000 0x100000>;
				read-only;
			};

			partition@590000 {
				label = "0:APPSBL_1";
				reg = <0x590000 0x100000>;
				read-only;
			};

			partition@690000 {
				label = "0:ART";
				reg = <0x690000 0x40000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/*
					 * ART starts with six MACs, U-Boot's ethaddr to
					 * eth5addr: the first four are Qualcomm's 00:03:7f
					 * placeholders, the last two Arista's own, for
					 * switch ports 5 and 6 (the C-360 has its own at 0x0
					 * and 0x6).
					 */
					macaddr_art_18: macaddr@18 {
						reg = <0x18 0x6>;
					};

					macaddr_art_1e: macaddr@1e {
						reg = <0x1e 0x6>;
					};

					/*
					 * The QCA988x's calibration, as Arista's
					 * read_caldata_to_fs.sh takes it for HK01
					 * (2116 bytes at 208896).
					 */
					cal_art_33000: calibration@33000 {
						reg = <0x33000 0x844>;
					};
				};
			};

			partition@6d0000 {
				label = "0:ETHPHYFW";
				reg = <0x6d0000 0x80000>;
				read-only;
			};

			partition@750000 {
				label = "0:HLOS";
				reg = <0x750000 0x800000>;
				read-only;
			};

			partition@f50000 {
				label = "0:HLOS_1";
				reg = <0xf50000 0x800000>;
				read-only;
			};

			partition@1750000 {
				label = "CONFIG";
				reg = <0x1750000 0x400000>;
				read-only;
			};

			partition@1b50000 {
				label = "LOGGING";
				reg = <0x1b50000 0x100000>;
				read-only;
			};

			partition@1c50000 {
				label = "RESERVED";
				reg = <0x1c50000 0x3b0000>;
				read-only;
			};
		};
	};
};

/* Two 5 GbE ports, as the C-360's two 10 GbE: Aquantia AQR114C PHYs at MDIO 8
 * and 0, on switch ports 5 and 6, each over USXGMII through its own Uniphy.
 * U-Boot loads the PHYs' firmware from 0:ETHPHYFW before Linux starts. */
&mdio {
	status = "okay";

	ethernet_phy_port5: ethernet-phy@8 {
		reg = <0x08>;
	};

	ethernet_phy_port6: ethernet-phy@0 {
		reg = <0x00>;
	};
};

&switch {
	status = "okay";

	switch_lan_bmp = <0x20>;	/* BIT(5) */
	switch_wan_bmp = <0x40>;	/* BIT(6) */

	qcom,port_phyinfo {
		port@4 {
			port_id = <5>;
			phy_address = <0x08>;
			ethernet-phy-ieee802.3-c45;
			mdiobus = <&mdio>;
		};

		port@5 {
			port_id = <6>;
			phy_address = <0x00>;
			ethernet-phy-ieee802.3-c45;
			mdiobus = <&mdio>;
		};
	};
};

&edma {
	status = "okay";
};

&dp5_syn {
	status = "okay";
	nvmem-cells = <&macaddr_art_18>;
	nvmem-cell-names = "mac-address";
	phy-handle = <&ethernet_phy_port5>;
};

&dp6_syn {
	status = "okay";
	nvmem-cells = <&macaddr_art_1e>;
	nvmem-cell-names = "mac-address";
	phy-handle = <&ethernet_phy_port6>;
};

/*
 * The scan radio: one card on PCIe 0, a Qualcomm Atheros QCA988x (168c:003c,
 * ath10k), Gen 1 x1. The vendor tree's qcom,cnss-qcn9000 nodes are disabled
 * reference leftovers. PCIe 1 links nothing.
 */
&pcie_qmp0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			compatible = "qcom,ath10k";
			reg = <0x00010000 0 0 0 0>;
			nvmem-cells = <&cal_art_33000>;
			nvmem-cell-names = "calibration";
		};
	};
};

&wifi {
	status = "okay";
	qcom,ath11k-calibration-variant = "Arista-C260";
};

&tlmm {
	ble_uart_pins: ble-uart-state {
		pins = "gpio46", "gpio47", "gpio48", "gpio49";
		function = "blsp2_uart";
		drive-strength = <8>;
		bias-disable;
	};

	button_pins: button-state {
		pins = "gpio52";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	/* The LED chain's clear line, held up, as on the C-360. */
	led-sr-clr-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "led-sr-clr";
	};
};

/ {
	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		/* "wps" in the vendor tree; the panel's only button. */
		reset {
			label = "reset";
			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	/*
	 * The LEDs hang off a 74LV164 chain clocked by gpio18 (clock) and gpio19
	 * (data), as on the C-360. Arista's ledc channel n drives output
	 * 15 - qcom,ledc_blink_indices[n] (checked against every known C-360
	 * LED). Its led daemon uses channels 11 and 8 for power (outputs 12 and
	 * 13) and five pairs for its indicators: outputs 8/9, 10/11, 4/5, 2/3 and
	 * 0/1. Which indicator is which, and the colours, are named once seen on
	 * the panel: until then each is named by its output.
	 */
	spi-leds {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sck-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;

		led_sr: gpio@0 {
			compatible = "fairchild,74hc595";
			reg = <0>;
			spi-max-frequency = <100000>;
			gpio-controller;
			#gpio-cells = <2>;
			registers-number = <2>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "c260:out0";
			gpios = <&led_sr 0 GPIO_ACTIVE_HIGH>;
		};

		led-1 {
			label = "c260:out1";
			gpios = <&led_sr 1 GPIO_ACTIVE_HIGH>;
		};

		led-2 {
			label = "c260:out2";
			gpios = <&led_sr 2 GPIO_ACTIVE_HIGH>;
		};

		led-3 {
			label = "c260:out3";
			gpios = <&led_sr 3 GPIO_ACTIVE_HIGH>;
		};

		led-4 {
			label = "c260:out4";
			gpios = <&led_sr 4 GPIO_ACTIVE_HIGH>;
		};

		led-5 {
			label = "c260:out5";
			gpios = <&led_sr 5 GPIO_ACTIVE_HIGH>;
		};

		led-8 {
			label = "c260:out8";
			gpios = <&led_sr 8 GPIO_ACTIVE_HIGH>;
		};

		led-9 {
			label = "c260:out9";
			gpios = <&led_sr 9 GPIO_ACTIVE_HIGH>;
		};

		led-10 {
			label = "c260:out10";
			gpios = <&led_sr 10 GPIO_ACTIVE_HIGH>;
		};

		led-11 {
			label = "c260:out11";
			gpios = <&led_sr 11 GPIO_ACTIVE_HIGH>;
		};

		led-12 {
			label = "c260:out12";
			gpios = <&led_sr 12 GPIO_ACTIVE_HIGH>;
		};

		led-13 {
			label = "c260:out13";
			gpios = <&led_sr 13 GPIO_ACTIVE_HIGH>;
		};
	};
};
