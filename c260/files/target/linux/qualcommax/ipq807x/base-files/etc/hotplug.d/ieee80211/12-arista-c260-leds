#!/bin/sh
# Arista C-260: tie each radio's green LED to its phy by device path, as phy
# numbers can change between boots. 2.4G and 5G are the IPQ8074's radios;
# "wlan" is the QCA988x on pcie0, the panel's scanning radio. "phyNradio"
# lights while the radio is enabled. The orange LEDs are left off.

[ "$ACTION" = add ] || exit 0
[ -n "$DEVICENAME" ] || exit 0
. /lib/functions.sh
[ "$(board_name)" = arista,c260 ] || exit 0

dev=$(readlink /sys/class/ieee80211/$DEVICENAME/device)
case "${dev##*/}" in
c000000.wifi)
	if iw phy "$DEVICENAME" info | grep -q "Band 1:"; then
		led=green:wlan-2ghz
	else
		led=green:wlan-5ghz
	fi
	;;
0000:01:00.0)
	led=green:wlan
	;;
*)
	exit 0
	;;
esac

[ -w /sys/class/leds/$led/trigger ] && echo "${DEVICENAME}radio" > /sys/class/leds/$led/trigger
