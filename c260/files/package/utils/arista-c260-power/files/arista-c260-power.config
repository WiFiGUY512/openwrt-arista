config policy 'main'
	# Arista's PoE power policy: on 802.3at (or af) power without a DC
	# supply, cap the serving radios' transmit power (whole dBm; Arista's
	# are 23.5 and 25.5) and turn the Bluetooth controller off. 0 here: full
	# power whatever the supply.
	option enabled '1'
	option radios '1'
	option txpower_2g '23'
	option txpower_5g '25'
	option bluetooth '1'
	# the power a switch allocated by LLDP decides the class
	option lldp '1'
	# seconds between readings of the input
	option interval '30'
