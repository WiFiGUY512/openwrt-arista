#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

START=60
USE_PROCD=1

start_service() {
	grep -q '^arista,c260$' /tmp/sysinfo/board_name 2>/dev/null || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/arista-c260-bluetooth
	procd_set_param respawn 3600 10 5
	procd_set_param stderr 1
	procd_close_instance
}
