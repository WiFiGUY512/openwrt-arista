Subject: qualcommax: ipq807x: Arista C-260 network roles

Ethernet 1 (eth0) is the LAN, a DHCP client as for this target's other APs, and there is no WAN. Ethernet 2 (eth1) stays free, as on the C-360, so two cables to one switch (as for PoE redundancy) make no loop; arista-c260-net attaches it to the LAN, a VLAN or a VXLAN, or makes the two ports a bond. The label MAC is Arista's base MAC, ART 0x18 (the port-5 MAC; ART 0x0 to 0x12 hold Qualcomm's placeholders). The ports keep the MACs their device tree gives them.

diff --git a/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network b/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
index 7a5f280a24..c0d74d981d 100644
--- a/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
+++ b/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
@@ -18,6 +18,9 @@ ipq807x_setup_interfaces()
 	zte,mf269)
 		ucidef_set_interfaces_lan_wan "lan" "wan"
 		;;
+	arista,c260)
+		ucidef_set_interface_lan "eth0" "dhcp"
+		;;
 	asus,rt-ax89x)
 		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4 lan5 lan6 lan7 lan8 10g-sfp 10g-copper" "wan"
 		;;
@@ -93,6 +96,9 @@ ipq807x_setup_macs()
 		lan_mac=$(macaddr_add "$wan_mac" 1)
 		label_mac="$wan_mac"
 		;;
+	arista,c260)
+		label_mac=$(mtd_get_mac_binary "0:ART" 0x18)
+		;;
 	tplink,deco-x80-5g)
 		label_mac=$(get_mac_binary /tmp/factory_data/default-mac 0)
 		lan_mac=$(macaddr_add $label_mac 1)
