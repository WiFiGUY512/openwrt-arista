Subject: qualcommax: ipq807x: add Arista C-260

The device recipe: a FIT kernel in UBI (kernel, rootfs, rootfs_data) in NAND slot 0, and the initramfs as the RAM system it is installed from. In the image: the QCA988x third radio (ath10k-ct) as the scan radio (airscan), the LEDs' shift registers, and the Bluetooth controller's bring-up.

diff --git a/target/linux/qualcommax/image/ipq807x.mk b/target/linux/qualcommax/image/ipq807x.mk
index f356bbbca5..9db96e483b 100644
--- a/target/linux/qualcommax/image/ipq807x.mk
+++ b/target/linux/qualcommax/image/ipq807x.mk
@@ -67,6 +67,37 @@ define Device/arcadyan_aw1000
 endef
 TARGET_DEVICES += arcadyan_aw1000
 
+# Arista C-260. Qualcomm IPQ8078A, 1 GiB, 32 MiB SPI NOR + 512 MiB NAND, the
+# IPQ8074's 2.4/5 GHz plus a QCA988x (ath10k) third radio on PCIe 0, a CSR8811
+# Bluetooth controller, two 5 GbE ports (Aquantia AQR114C), LEDs on a 74LV164.
+# OpenWrt lives in NAND slot 0 ("ubi"); Arista's slot 1 stays as the fallback
+# and as the source of the IPQ8074 board data and the Bluetooth PS keys. U-Boot
+# loads the "kernel" UBI volume with its own ubi commands, from a bootcmd the
+# installation sets (INSTALL.md); the initramfs is the RAM system it is
+# installed from. The QCA988x is the scan radio (airscan), as the C-360's
+# QCN9072 is: the IPQ8074's radios serve clients, it does everything else.
+# Two 5 GbE ports, both PoE in: bonding (LACP, 802.3ad) is in the image, so
+# the pair can be one uplink, and vxlan (netifd's proto handler, with
+# kmod-vxlan), as on the C-360. kmod-tls is there because kmod-bonding
+# depends on it optionally ("!kmod-tls || kmod-tls"): with every module built
+# as m (ALL_KMODS), that caps bonding at m, out of the image, unless tls is y.
+define Device/arista_c260
+	$(call Device/FitImage)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := Arista
+	DEVICE_MODEL := C-260
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	SOC := ipq8074
+	DEVICE_DTS := arista_c260
+	DEVICE_DTS_CONFIG := config@1
+	DEVICE_PACKAGES := kmod-ath10k-ct ath10k-firmware-qca988x-ct \
+		ubi-utils squashfs-tools-unsquashfs kmod-spi-gpio kmod-spi-bitbang \
+		kmod-gpio-nxp-74hc164 kmod-leds-gpio arista-c260-bluetooth airscan \
+		kmod-bonding proto-bonding kmod-tls vxlan
+endef
+TARGET_DEVICES += arista_c260
+
 define Device/asus_rt-ax89x
 	DEVICE_VENDOR := Asus
 	DEVICE_MODEL := RT-AX89X
