Subject: qualcommax: ipq807x: add Arista C-360

The device recipe: a FIT kernel in UBI (kernel, rootfs, rootfs_data) in NAND slot 0, and the initramfs as the installer, which reads factory.ubi from a FAT32 USB stick. In the image: the TPM and its tools (tpm2-tss, tpm2-tools), Bluetooth LE, airscan, USB storage, bonding (LACP) and VXLAN.

diff --git a/target/linux/qualcommax/image/ipq807x.mk b/target/linux/qualcommax/image/ipq807x.mk
index f356bbb..c45cc83 100644
--- a/target/linux/qualcommax/image/ipq807x.mk
+++ b/target/linux/qualcommax/image/ipq807x.mk
@@ -564,3 +564,40 @@ define Device/zyxel_nwa210ax
 	IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-nwa210ax-fit
 endef
 TARGET_DEVICES += zyxel_nwa210ax
+
+# Arista C-360 (MODEL_STRING=C-360, VENDOR_NAME=ARISTA, PLATFORM_SUB_ID=1).
+# Qualcomm IPQ8076A, 2 GiB, 32 MiB SPI NOR + 1 GiB NAND, IPQ8074 2.4/5 GHz plus
+# a QCN9074 (6 GHz serving radio) and a QCN9072 (2.4/5/6 GHz scan radio).
+# OpenWrt lives in NAND slot 0 ("ubi"); Arista's slot 1 stays as fallback and
+# as the source of the QCN9074 firmware and board data. U-Boot
+# loads the "kernel" UBI volume with its own ubi commands; the vendor bootipq
+# path authenticates images, so installation sets a bootcmd (see INSTALL).
+# The initramfs is the installer (arista-c360-install), which reads factory.ubi
+# from a FAT32 USB stick: hence usb-storage, vfat and its two codepages.
+# Two 10 GbE ports, both PoE in: bonding (LACP, 802.3ad) is in the image, so
+# the pair can be one uplink. kmod-tls is there because kmod-bonding depends on
+# it optionally ("!kmod-tls || kmod-tls"): with every module built as m
+# (ALL_KMODS), that caps bonding at m, out of the image, unless tls is y too.
+# vxlan (netifd's proto handler, with kmod-vxlan) is in the image too: VXLAN
+# tunnels are part of what the AP does. libtss2 and tpm2-tools make the TPM
+# (an Infineon SLB 9670) usable from userspace: keys, signing, sealing, and the
+# unit's factory identity certificates it holds.
+define Device/arista_c360
+	$(call Device/FitImage)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := Arista
+	DEVICE_MODEL := C-360
+	BLOCKSIZE := 256k
+	PAGESIZE := 4096
+	SOC := ipq8074
+	DEVICE_DTS := arista_c360
+	DEVICE_DTS_CONFIG := config@1
+	DEVICE_PACKAGES := kmod-ath11k-pci kmod-phy-aquantia ubi-utils \
+		squashfs-tools-unsquashfs kmod-spi-gpio kmod-spi-bitbang \
+		kmod-gpio-nxp-74hc164 kmod-leds-gpio kmod-tpm-tis-spi airscan \
+		kmod-bluetooth kmod-hci-uart bluez-utils bluez-utils-extra \
+		kmod-usb-storage kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1 \
+		kmod-bonding proto-bonding kmod-tls vxlan \
+		libtss2 tpm2-tools
+endef
+TARGET_DEVICES += arista_c360
