#!/bin/sh
# Arista C-360: tie the radio LEDs to their phys by device path. The phy numbers
# of the two QCN9074 cards change between boots, so phyN triggers cannot be
# fixed in board.d. 2.4G and 5G are the IPQ8074 radios, 5/6G the 6 GHz card on
# pcie0; the multifunction card on pcie1 has no LED. "phyNradio" lights while
# the radio is enabled.

[ "$ACTION" = add ] || exit 0
[ -n "$DEVICENAME" ] || exit 0
. /lib/functions.sh
[ "$(board_name)" = arista,c360 ] || exit 0

dev=$(readlink /sys/class/ieee80211/$DEVICENAME/device)
case "${dev##*/}" in
c000000.wifi)
	if iw phy "$DEVICENAME" info | grep -q "Band 1:"; then
		led=green:wlan-2ghz
	else
		led=green:wlan-5ghz
	fi
	;;
0000:01:00.0)
	led=green:wlan-6ghz
	;;
*)
	exit 0
	;;
esac

[ -w /sys/class/leds/$led/trigger ] && echo "${DEVICENAME}radio" > /sys/class/leds/$led/trigger
