#!/bin/sh
# Arista C-360: install this unit's own Wi-Fi firmware and board data.
#
# The two QCN9074 cards run only Arista's build of the Qualcomm firmware
# (WLAN.HK.2.5.r4); every public ath11k-firmware build tried (2.5.0.1 to
# 2.9.0.1, fifteen in all) stops at the QMI capability request on these cards.
# That firmware cannot be redistributed, but every C-360 carries it in its
# Arista system on NAND. This copies it, unmodified, from the unit's own Arista
# slot into /lib/firmware (overlay), with Arista's board data for both cards
# and the IPQ8074. Nothing on flash is written except the overlay; the Arista
# partitions are read-only.
#
# Called from preinit (/lib/preinit/81_arista_c360_wifi), after the overlay is
# mounted and before any ath11k driver loads, so the radios start with the
# right firmware. It never rebinds a running card: unbinding a QCN9074 while
# its first QMI exchange is still pending crashes ath11k (2026-10-07).

. /lib/functions.sh

MARK=/lib/firmware/ath11k/.arista-c360-vendor
Q=/lib/firmware/ath11k/QCN9074/hw1.0
I=/lib/firmware/ath11k/IPQ8074/hw2.0
SRC=lib/firmware/IPQ8074/WIFI_FW
UBIDEV=9
TMP=/tmp/arista-c360-wifi

log() {
	echo "arista-c360-wifi: $*" > /dev/kmsg
}

le32() {
	# busybox ash does not expand "\\$(...)", so an inner printf builds the escapes
	printf "$(printf '\\%03o\\%03o\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)) \
		$((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"
}

pad4() {
	local n=$(((4 - $1 % 4) % 4))
	[ $n -eq 0 ] || head -c $n /dev/zero
}

# One board-2.bin BOARD element: { 0, len, { 0 (NAME), len, name }, { 1 (DATA), len, data } }
board_ie() {
	local name="$1" file="$2" nlen dlen
	nlen=${#name}
	dlen=$(wc -c < "$file")
	le32 0
	le32 $((8 + nlen + (4 - nlen % 4) % 4 + 8 + dlen + (4 - dlen % 4) % 4))
	le32 0; le32 $nlen; printf %s "$name"; pad4 $nlen
	le32 1; le32 $dlen; cat "$file"; pad4 $dlen
}

# Copy the firmware out of an Arista slot (UBI volume "ubi_rootfs", squashfs).
# The kernel will not mount Arista's squashfs (non-standard xz options), so
# unsquashfs reads the UBI volume directly.
#
# In preinit the hotplug handler may not have created the UBI device nodes yet
# when ubiattach returns, so the volume is found through sysfs and its node is
# created here if it is missing.
extract() {
	local part mtd v vol node rc
	for part in rootfs_1 rootfs; do
		mtd=$(find_mtd_index "$part")
		[ -n "$mtd" ] || continue
		if ! ubiattach -m "$mtd" -d $UBIDEV > /dev/null 2>&1; then
			log "ubiattach of '$part' (mtd$mtd) failed"
			continue
		fi
		vol=
		for v in /sys/class/ubi/ubi${UBIDEV}_*; do
			[ "$(cat "$v/name" 2> /dev/null)" = ubi_rootfs ] && vol=${v##*_}
		done
		if [ -n "$vol" ]; then
			node=/dev/ubi${UBIDEV}_$vol
			[ -c $node ] || mknod $node c $(sed 's/:/ /' /sys/class/ubi/ubi${UBIDEV}_$vol/dev)
			rm -rf $TMP
			unsquashfs -n -d $TMP $node \
				$SRC/qcn9000/amss.bin $SRC/qcn9000/m3.bin \
				$SRC/qcn9000/bdwlan.bab $SRC/qcn9000/bdwlan.baa \
				$SRC/bdwlan.b290 > /dev/null 2>&1
			rc=$?
			[ $rc -eq 0 ] || log "unsquashfs of '$part' exited $rc"
		else
			log "no ubi_rootfs volume in '$part'"
		fi
		ubidetach -d $UBIDEV > /dev/null 2>&1
		if [ -s $TMP/$SRC/qcn9000/amss.bin ] && [ -s $TMP/$SRC/bdwlan.b290 ]; then
			log "firmware found in Arista slot '$part'"
			return 0
		fi
	done
	return 1
}

install_fw() {
	local s=$TMP/$SRC base=$Q/board-2.bin
	[ -f /rom$Q/board-2.bin ] && base=/rom$Q/board-2.bin
	mkdir -p $Q $I
	{
		cat $base
		board_ie "bus=pci,qmi-chip-id=0,qmi-board-id=255,variant=Arista-C360-pcie0" $s/qcn9000/bdwlan.bab
		board_ie "bus=pci,qmi-chip-id=0,qmi-board-id=255,variant=Arista-C360-pcie1" $s/qcn9000/bdwlan.baa
	} > $TMP/board-2.bin || return 1
	cp $s/qcn9000/amss.bin $Q/amss.bin &&
	cp $s/qcn9000/m3.bin $Q/m3.bin &&
	mv $TMP/board-2.bin $Q/board-2.bin &&
	cp $s/bdwlan.b290 $I/board.bin || return 1
	sync
	touch $MARK
}

[ -e $MARK ] && [ "$1" != "-f" ] && exit 0

if ! extract; then
	log "no Arista slot with Wi-Fi firmware found; QCN9074 radios stay down"
	rm -rf $TMP
	exit 1
fi
if ! install_fw; then
	log "installing the firmware failed"
	rm -rf $TMP
	exit 1
fi
rm -rf $TMP
log "installed Arista Wi-Fi firmware and board data"
exit 0
