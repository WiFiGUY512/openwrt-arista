# Arista C-360: copy the unit's own Wi-Fi firmware out of its Arista slot
# before any ath11k driver loads (see /usr/sbin/arista-c360-wifi-fw).

arista_c360_wifi_fw() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "arista,c360" ] || return 0
	[ -e /lib/firmware/ath11k/.arista-c360-vendor ] && return 0
	/usr/sbin/arista-c360-wifi-fw
}

boot_hook_add preinit_main arista_c360_wifi_fw
boot_hook_add initramfs arista_c360_wifi_fw
