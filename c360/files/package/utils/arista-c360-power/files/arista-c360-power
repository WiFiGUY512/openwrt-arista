#!/bin/sh
# arista-c360-power: the Arista C-360's PoE power policy, as Arista's own
# system applies it (/sbin/ap_power.sh, /etc/poe_prof.cfg).
#
# The PoE controller reports the class each input negotiated on GPIOs: PoE 1
# (Ethernet 1) on gpio54/55/56, PoE 2 (Ethernet 2) on gpio2/66/27, reading
# 1 1 1 for 802.3af, 1 0 1 for 802.3at, 0 1 0 for 802.3bt. gpio64 is 0 when a
# DC supply is plugged in. A DC supply or 802.3bt on either input is full
# power. On 802.3at (or af) alone the USB port is turned off, the serving
# radios' transmit power is capped (Arista's values: 15 dBm at 2.4 GHz, 18 dBm
# at 5 and 6 GHz), and the 2.4 GHz radio uses 2 of its 4 chains (mask 3, TX
# and RX). The scan radio is left alone.
#
# Without a DC supply, the power a switch reports by LLDP that it allocated
# on a port (lldpd, Power via MDI TLV) decides that input's class instead of
# its pins, as on Arista's system: 38.1 W or more is 802.3bt, 25 W or more
# 802.3at, less 802.3af.
#
#	arista-c360-power status	what the inputs read, and what is applied
#	arista-c360-power apply		read the inputs, apply the policy
#	arista-c360-power radios	apply the radio caps again (after Wi-Fi restarts)
#	arista-c360-power monitor	apply again whenever the inputs change

STATE=/var/run/arista-c360-power
# The USB controller, dwc3-qcom's: 8a00000.usb in OpenWrt main's device tree,
# 8af8800.usb (the glue node) in 25.12's.
USBDRV=/sys/bus/platform/drivers/dwc3-qcom
USB=8a00000.usb
[ -e /sys/bus/platform/devices/$USB ] || USB=8af8800.usb
# uci writes are staged in a save directory of their own, so they never show
# among anyone else's changes. A commit still takes what is staged in
# /tmp/.uci too (uci reads both), so nothing is committed while someone has
# changes to the same config staged there (others_staged).
UCI="uci -q -t /var/run/arista-c360-power.uci"

log() { logger -t arista-c360-power "$*"; }

others_staged() { [ -n "$(uci -q changes $1)" ]; }

opt() { uci -q get arista-c360-power.main.$1 || echo "$2"; }

scan_section() { ubus call airscan status 2>/dev/null | jsonfilter -e '@.section' 2>/dev/null; }

wifi_devices() { uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"; }

tlmm_base() {
	local c
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat $c/label 2>/dev/null)" = 1000000.pinctrl ] && { cat $c/base; return; }
	done
}

pin() { # pin <tlmm gpio>: its level, as an input
	local n=$(( $(tlmm_base) + $1 ))
	if [ ! -e /sys/class/gpio/gpio$n ]; then
		echo $n > /sys/class/gpio/export 2>/dev/null
		echo in > /sys/class/gpio/gpio$n/direction 2>/dev/null
	fi
	cat /sys/class/gpio/gpio$n/value 2>/dev/null
}

class() {
	case "$1$2$3" in
	111) echo 802.3af ;;
	101) echo 802.3at ;;
	010) echo 802.3bt ;;
	*) echo none ;;
	esac
}

# Ethernet 1 and 2: eth0/eth1, or lan1/lan2 with DSA port names
port() { # port 1|2
	local p
	for p in eth$(($1 - 1)) lan$1; do
		[ -e /sys/class/net/$p ] && { echo $p; return; }
	done
}

lldp_mw() { # lldp_mw <port>: the power (mW) a switch allocated on it, by LLDP
	local kv mw
	if [ -n "$C360_POWER_LLDP" ]; then
		# test hook: C360_POWER_LLDP="eth0=25000 eth1=40000"
		mw=$(echo "$C360_POWER_LLDP" | tr ' ' '\n' | sed -n "s/^$1=//p")
	else
		command -v lldpcli > /dev/null || return 0
		kv=$(lldpcli -f keyvalue show neighbors ports "$1" details 2>/dev/null)
		echo "$kv" | grep -q "^lldp\.$1\.port\.power\.device-type=PSE$" || return 0
		echo "$kv" | grep -q "^lldp\.$1\.port\.power\.enabled=yes$" || return 0
		mw=$(echo "$kv" | sed -n "s/^lldp\.$1\.port\.power\.allocated=\([0-9]*\)$/\1/p" | head -1)
	fi
	[ "${mw:-0}" -gt 0 ] 2>/dev/null && echo $mw
}

mw_class() { # Arista's thresholds (ap_power.sh)
	if [ $1 -ge 38100 ]; then echo 802.3bt
	elif [ $1 -ge 25000 ]; then echo 802.3at
	else echo 802.3af
	fi
}

read_inputs() {
	PINS1=$(class $(pin 54) $(pin 55) $(pin 56))
	PINS2=$(class $(pin 2) $(pin 66) $(pin 27))
	POE1=$PINS1 POE2=$PINS2 LLDP1= LLDP2=
	DC=0
	[ "$(pin 64)" = 0 ] && DC=1
	if [ $DC = 0 ] && [ "$(opt lldp 1)" = 1 ]; then
		LLDP1=$(lldp_mw "$(port 1)")
		LLDP2=$(lldp_mw "$(port 2)")
		[ -n "$LLDP1" ] && POE1=$(mw_class $LLDP1)
		[ -n "$LLDP2" ] && POE2=$(mw_class $LLDP2)
	fi
	if [ $DC = 1 ] || [ $POE1 = 802.3bt ] || [ $POE2 = 802.3bt ]; then
		LEVEL=full
	elif [ $POE1 != none ] || [ $POE2 != none ]; then
		LEVEL=limited
	else
		LEVEL=full    # nothing readable: never degrade on a guess
	fi
	# test hook: act as on another supply (C360_POWER_LEVEL=limited|full)
	[ -n "$C360_POWER_LEVEL" ] && LEVEL=$C360_POWER_LEVEL
}

usb_set() { # on|off
	local bound=0
	[ -e $USBDRV/$USB ] && bound=1
	if [ $1 = off ] && [ $bound = 1 ]; then
		echo $USB > $USBDRV/unbind && log "USB port off"
	elif [ $1 = on ] && [ $bound = 0 ]; then
		echo $USB > $USBDRV/bind && log "USB port on"
	fi
}

band_cap() { # band_cap <phy>: the cap in dBm for the phy's band
	local info=$(iw phy $1 info 2>/dev/null)
	if echo "$info" | grep -q "Band 4:"; then opt txpower_6g 18
	elif echo "$info" | grep -q "Band 2:"; then opt txpower_5g 18
	else opt txpower_2g 15
	fi
}

# The caps, on every serving radio; a lower txpower set in uci is kept.
# mac80211.sh sets each radio's power again when Wi-Fi restarts, so this runs
# again then (hotplug).
radios_apply() {
	local level=$(cat $STATE.level 2>/dev/null || echo full)
	local scan=$(scan_section)
	local sec phy cap user
	rm -f $STATE.caps.new
	for sec in $(wifi_devices); do
		[ "$sec" = "$scan" ] && continue
		phy=$(iwinfo nl80211 phyname $sec 2>/dev/null)
		[ -n "$phy" ] && [ -e /sys/class/ieee80211/$phy ] || continue
		user=$(uci -q get wireless.$sec.txpower)
		if [ $level = limited ] && [ "$(opt radios 1)" = 1 ]; then
			cap=$(band_cap $phy)
			[ -n "$user" ] && [ "$user" -le "$cap" ] 2>/dev/null && continue
			iw phy $phy set txpower limit $((cap * 100)) && echo "$sec $phy $cap" >> $STATE.caps.new
		elif grep -q "^$sec " $STATE.caps 2>/dev/null; then
			# was capped: back to what the config says
			if [ -n "$user" ]; then iw phy $phy set txpower fixed $((user * 100))
			else iw phy $phy set txpower auto
			fi
		fi
	done
	mv -f $STATE.caps.new $STATE.caps 2>/dev/null || : > $STATE.caps
}

# The 2.4 GHz serving radio's chains. A radio's antennas can change only while
# it is down, and Wi-Fi sets them from the config whenever it starts a radio,
# so they go into the radio's config (txantenna/rxantenna) and Wi-Fi reloads
# that radio. What it had before is kept in this package's config (section
# 'chains') and put back on full power, unless the antennas were changed in
# the meantime. A radio with antennas of its own in the config is left alone.
# Runs from apply, and again from monitor while it waits for changes someone
# else has staged to wireless or this package's config to be committed or
# reverted. A Wi-Fi restart does not bring it back.
chains_apply() { # chains_apply limited|full
	local level=$1 mask=$(opt chains_2g 3) scan=$(scan_section) sec saved tx rx wifi=0 own=0
	if others_staged wireless || others_staged arista-c360-power; then
		[ -e $STATE.chains-wait ] ||
			log "changes to wireless or arista-c360-power are staged and not committed: the 2.4 GHz chains wait"
		echo $level > $STATE.chains-wait
		return 0
	fi
	rm -f $STATE.chains-wait
	mkdir -p /var/run/arista-c360-power.uci
	for sec in $(wifi_devices); do
		[ "$sec" = "$scan" ] && continue
		[ "$(uci -q get wireless.$sec.band)" = 2g ] || continue
		saved=$(uci -q get arista-c360-power.chains.$sec)
		tx=$(uci -q get wireless.$sec.txantenna)
		rx=$(uci -q get wireless.$sec.rxantenna)
		if [ $level = limited ] && [ "$(opt chains 1)" = 1 ]; then
			[ -n "$saved" ] && continue
			case "${tx:-all} ${rx:-all}" in
			"all all") ;;
			*) log "$sec keeps the antennas it is configured with ($tx/$rx)"; continue ;;
			esac
			uci -q get arista-c360-power.chains > /dev/null || $UCI set arista-c360-power.chains=state
			$UCI set arista-c360-power.chains.$sec="${tx:--} ${rx:--}"
			$UCI set wireless.$sec.txantenna=$mask
			$UCI set wireless.$sec.rxantenna=$mask
			log "$sec: 2.4 GHz chains to mask $mask"
			wifi=1 own=1
		elif [ -n "$saved" ]; then
			if [ "$tx" = "$mask" ] && [ "$rx" = "$mask" ]; then
				tx=${saved% *} rx=${saved#* }
				if [ "$tx" = - ]; then $UCI delete wireless.$sec.txantenna; else $UCI set wireless.$sec.txantenna=$tx; fi
				if [ "$rx" = - ]; then $UCI delete wireless.$sec.rxantenna; else $UCI set wireless.$sec.rxantenna=$rx; fi
				log "$sec: 2.4 GHz chains back to the configured antennas"
				wifi=1
			else
				log "$sec: antennas changed since the reduction ($tx/$rx), kept"
			fi
			$UCI delete arista-c360-power.chains.$sec
			own=1
		fi
	done
	if [ $own = 1 ]; then
		$UCI commit arista-c360-power
		# the section goes once no radio is reduced
		[ "$(uci -q show arista-c360-power.chains | wc -l)" = 1 ] &&
			$UCI delete arista-c360-power.chains && $UCI commit arista-c360-power
	fi
	[ $wifi = 1 ] && $UCI commit wireless && wifi reload
	return 0
}

# The power LED shows the level: green at full power, orange (the W-318's is
# amber) while the power is reduced. Option led '0' leaves it green. OpenWrt
# lights it green once the boot is done; this runs after that.
power_led() { # power_led full|limited
	local g=/sys/class/leds/green:power o= l on off
	for l in orange amber; do
		[ -e /sys/class/leds/$l:power ] && o=/sys/class/leds/$l:power
	done
	[ -e $g ] && [ -n "$o" ] || return 0
	[ "$(opt led 1)" = 1 ] || set -- full
	if [ $1 = limited ]; then on=$o off=$g; else on=$g off=$o; fi
	echo none > $off/trigger
	echo 0 > $off/brightness
	echo none > $on/trigger
	cat $on/max_brightness > $on/brightness
	l=${on##*/}
	echo ${l%:power} > $STATE.led
}

apply() {
	read_inputs
	echo $LEVEL > $STATE.level
	if [ "$(opt enabled 1)" != 1 ]; then
		usb_set on
		echo full > $STATE.level
		chains_apply full
		radios_apply
		power_led full
		log "disabled: full power regardless (PoE 1 $POE1, PoE 2 $POE2, DC $DC)"
		return
	fi
	log "power: $LEVEL (PoE 1 $POE1, PoE 2 $POE2, DC $DC)"
	if [ $LEVEL = limited ] && [ "$(opt usb 1)" = 1 ]; then usb_set off; else usb_set on; fi
	chains_apply $LEVEL
	radios_apply
	power_led $LEVEL
	{
		echo "level=$LEVEL"
		echo "poe1=$POE1"
		echo "poe2=$POE2"
		echo "dc=$DC"
	} > $STATE
}

# Read the inputs every 30 s; apply again once a new level has been read twice
# in a row, so LLDP that arrives after boot, or a supply that changes, takes
# effect without a flap on one odd reading.
monitor() {
	local seen= applied
	while :; do
		sleep $(opt interval 30)
		[ "$(opt enabled 1)" = 1 ] || { seen=; continue; }
		[ -e $STATE.chains-wait ] && chains_apply "$(cat $STATE.chains-wait)"
		read_inputs
		applied=$(cat $STATE.level 2>/dev/null)
		if [ "$LEVEL" = "$applied" ]; then
			seen=
		elif [ "$LEVEL" = "$seen" ]; then
			apply
			seen=
		else
			seen=$LEVEL
		fi
	done
}

status() {
	read_inputs
	echo "PoE 1 (Ethernet 1): $POE1 (pins $PINS1${LLDP1:+, LLDP $LLDP1 mW allocated})"
	echo "PoE 2 (Ethernet 2): $POE2 (pins $PINS2${LLDP2:+, LLDP $LLDP2 mW allocated})"
	echo "DC supply: $([ $DC = 1 ] && echo yes || echo no)"
	echo "power: $LEVEL (applied: $(cat $STATE.level 2>/dev/null || echo nothing yet))"
	echo "USB port: $([ -e $USBDRV/$USB ] && echo on || echo off)"
	echo "power LED: $(cat $STATE.led 2>/dev/null || echo not set)"
	[ -s $STATE.caps ] && sed 's/^\(.*\) \(.*\) \(.*\)$/radio \1 (\2): capped at \3 dBm/' $STATE.caps
	uci -q show arista-c360-power.chains | sed -n "s/^arista-c360-power\.chains\.\([^=]*\)=.*/radio \1: 2.4 GHz chains reduced to mask $(opt chains_2g 3)/p"
	return 0
}

case "$1" in
apply) apply ;;
radios) radios_apply ;;
monitor) monitor ;;
status|"") status ;;
*) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
