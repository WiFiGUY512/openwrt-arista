config policy 'main'
	# Arista's PoE power policy: on 802.3at (or af) power, without a DC supply
	# or 802.3bt on the other input, turn the USB port off and cap the serving
	# radios' transmit power (dBm). 0 here: full power whatever the supply.
	option enabled '1'
	option usb '1'
	option radios '1'
	option txpower_2g '15'
	option txpower_5g '18'
	option txpower_6g '18'
