config policy 'main'
	# Arista's PoE power policy: on 802.3at (or af) power, without a DC supply
	# or 802.3bt on the other input, turn the USB port off, cap the serving
	# radios' transmit power (dBm) and run the 2.4 GHz radio on 2 of its 4
	# chains (antenna mask, TX and RX). 0 here: full power whatever the supply.
	option enabled '1'
	option usb '1'
	option radios '1'
	option txpower_2g '15'
	option txpower_5g '18'
	option txpower_6g '18'
	option chains '1'
	option chains_2g '3'
