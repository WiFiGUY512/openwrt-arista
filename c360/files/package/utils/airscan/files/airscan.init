#!/bin/sh /etc/rc.common
# airscan: survey service on the dedicated scan radio

START=99
USE_PROCD=1

start_service() {
	. /lib/functions.sh
	case "$(board_name)" in
	arista,c260|\
	arista,c360) ;;
	*) return 0 ;;
	esac
	[ "$(uci -q get airscan.main.enabled)" = 0 ] && return 0
	procd_open_instance
	procd_set_param command /usr/sbin/airscan
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger airscan
}
