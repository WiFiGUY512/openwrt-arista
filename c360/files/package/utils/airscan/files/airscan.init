#!/bin/sh /etc/rc.common
# airscan: survey service on the dedicated scan radio

START=99
USE_PROCD=1

# airscan marks the radio it takes (wireless.<radio>.airscan '1'): what reads
# the mark keeps the serving radios off scanning, Aeolus among them. Turned
# off, airscan takes the mark away: the radio is like the others again, its
# country theirs (airscan took its own off), and the serving radios behave as
# on any AP. Whether it then serves clients is the wireless config's (its
# disabled option).
unmark() {
	local s c changed=
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.airscan='1'$/\1/p"); do
		uci -q delete wireless.$s.airscan && changed=1
		[ -n "$(uci -q get wireless.$s.country)" ] && continue
		c=$(uci -q show wireless | sed -n "/^wireless\.$s\./d; s/^wireless\.[^.]*\.country='\(.*\)'$/\1/p" | head -n 1)
		[ -z "$c" ] || uci set wireless.$s.country="$c"
	done
	[ -z "$changed" ] || uci commit wireless
}

start_service() {
	. /lib/functions.sh
	case "$(board_name)" in
	arista,c260|arista,c-260|\
	arista,c360|arista,c-360|\
	arista,w318|arista,w-318) ;;
	*) return 0 ;;
	esac
	if [ "$(uci -q get airscan.main.enabled)" = 0 ]; then
		unmark
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/airscan
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger airscan
}
