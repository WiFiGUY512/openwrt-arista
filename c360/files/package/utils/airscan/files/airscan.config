config airscan 'main'
	option enabled '1'
	# seconds between full spectral sweeps / passive BSS scans
	option spectral_interval '900'
	option bss_interval '300'
	# FFT samples per window (~0.23 ms each) and FFT size (in-band bins = half)
	option spectral_samples '2048'
	option spectral_fft '256'
	# monitor dwell per channel (ms) and how long an unseen client is kept (s)
	option client_dwell '1000'
	option client_expire '900'
	# Wired probe: an ARP probe (sender IP 0.0.0.0, from this AP's own MAC) on
	# every L2 domain the AP is on, once per dwell plus once mid-dwell. A BSS
	# that relays it over the air is bridged into this LAN: with one of your
	# SSIDs it is verified, with any other SSID it is a wired rogue. A BSS with
	# one of your SSIDs that never relays it after probe_evidence dwells is an
	# evil twin.
	option wired_probe '1'
	option probe_evidence '5'
	# Bluetooth LE survey on the board's BLE controller (hci0), on its own
	# timer: seconds between scans, scan length, and how long a device not
	# heard again is kept. The controller must be powered (C-360: done by
	# /etc/init.d/arista-c360-ble); the survey never changes its state.
	option ble_enabled '1'
	option ble_interval '120'
	option ble_duration '10'
	option ble_expire '900'
	# Your SSIDs. SSIDs this AP serves count automatically; list SSIDs served
	# by other APs on this LAN here. trusted_bssid entries (prefixes allowed,
	# e.g. '00:11:22') are always accepted, e.g. APs that filter broadcast ARP.
	# list trusted_ssid 'MyNetwork'
	# list trusted_bssid '00:11:22'
