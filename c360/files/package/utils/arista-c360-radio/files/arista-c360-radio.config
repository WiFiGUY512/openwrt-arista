config radio 'main'
	# 6g: the IPQ8074 on 2.4 GHz and all of 5 GHz, the serving QCN9074 on
	# 6 GHz (Arista's default). dual5g: the IPQ8074 on 2.4 GHz and lower
	# 5 GHz, the serving QCN9074 on upper 5 GHz. Change it with
	# arista-c360-radio-mode, which also moves the radios' wireless settings.
	option mode '6g'
