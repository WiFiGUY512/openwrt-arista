From d645bfc6d4d11c8764c91f4d0d297d6ea4a42c15 Mon Sep 17 00:00:00 2001
From: openwrt-arista <build@invalid>
Date: Thu, 8 Oct 2026 18:36:16 -0500
Subject: [PATCH] bluez: bluez-daemon: depend on kmod-crypto-user

bluetoothd's crypto (src/shared/crypto.c) uses the kernel's AF_ALG
sockets. Without them it cannot generate the static random address a
controller without a public address needs ("Failed to open crypto",
"No Bluetooth address for index 0"), and never uses that controller.
Seen on the Arista C-360 (Nordic nRF52833 with a Zephyr HCI UART
controller): with kmod-crypto-user, bluetoothd powers it on and scans.

---
 utils/bluez/Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/utils/bluez/Makefile b/utils/bluez/Makefile
index 667bcac..c7fd787 100644
--- a/utils/bluez/Makefile
+++ b/utils/bluez/Makefile
@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=bluez
 PKG_VERSION:=5.86
-PKG_RELEASE:=2
+PKG_RELEASE:=3
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=@KERNEL/linux/bluetooth/
@@ -69,7 +69,7 @@ $(call Package/bluez/Default)
   SECTION:=utils
   CATEGORY:=Utilities
   TITLE+= daemon
-  DEPENDS:=+bluez-libs +bluez-utils +bluez-utils-extra +glib2 +libncurses +libreadline +dbus +libical $(INTL_DEPENDS) $(ICONV_DEPENDS)
+  DEPENDS:=+bluez-libs +bluez-utils +bluez-utils-extra +glib2 +libncurses +libreadline +dbus +libical +kmod-crypto-user $(INTL_DEPENDS) $(ICONV_DEPENDS)
 endef
 
 define Package/bluez-daemon/conffiles
-- 
