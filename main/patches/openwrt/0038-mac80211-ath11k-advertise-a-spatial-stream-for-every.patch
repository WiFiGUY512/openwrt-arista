From 3aae4b295efdf0c8aa8ef447316b1344aa7fff86 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Wed, 28 Oct 2026 13:35:00 -0500
Subject: [PATCH] mac80211: ath11k: advertise a spatial stream for every chain

ath11k patch 109 (for upstream): ath11k counted stream i only when bit
i of the radio's chainmask was set, so a radio whose chainmask is not
contiguous offered fewer streams than it has chains: the C-360's
QCN9072 (chainmask 0x5, two chains) showed one stream on every band in
iw phy and associated as a 1x1 client. Count streams up to the number
of chains; contiguous chainmasks are unchanged.

Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/kernel/mac80211/Makefile              |   2 +-
 ...ise-a-spatial-stream-for-every-chain.patch | 136 ++++++++++++++++++
 2 files changed, 137 insertions(+), 1 deletion(-)
 create mode 100644 package/kernel/mac80211/patches/ath11k/109-wifi-ath11k-advertise-a-spatial-stream-for-every-chain.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index 5de442146fa..5f323c3ba13 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
 
 PKG_SOURCE_VERSION:=7.2
 PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
-PKG_RELEASE:=17
+PKG_RELEASE:=18
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
diff --git a/package/kernel/mac80211/patches/ath11k/109-wifi-ath11k-advertise-a-spatial-stream-for-every-chain.patch b/package/kernel/mac80211/patches/ath11k/109-wifi-ath11k-advertise-a-spatial-stream-for-every-chain.patch
new file mode 100644
index 00000000000..25960c452cf
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/109-wifi-ath11k-advertise-a-spatial-stream-for-every-chain.patch
@@ -0,0 +1,136 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Wed, 28 Oct 2026 13:30:00 -0500
+Subject: [PATCH] wifi: ath11k: advertise a spatial stream for every chain
+
+ath11k counts stream i as supported only when bit i of the radio's
+chainmask is set: in the HT RX MCS mask (ath11k_create_ht_cap()), the
+VHT MCS maps (ath11k_create_vht_cap()) and the HE MCS maps
+(ath11k_mac_set_hemcsmap()). A chainmask need not be contiguous. The
+QCN9072 in an Arista C-360 reports 0x5, chains 0 and 2: it has two
+chains, and ar->num_tx_chains and ar->num_rx_chains say so, but bit 1
+is clear, so its HT, VHT and HE capabilities offer one stream ("2
+streams: not supported" in iw phy, on every band) and it associates as
+a 1x1 client.
+
+A radio can use as many streams as it has chains, whichever chains
+they are. Count the streams up to ar->num_tx_chains and
+ar->num_rx_chains, the chainmasks' weights, and take TX STBC away when
+there is one TX chain rather than when the shifted TX chainmask is at
+most 1. The rate-cap chainmasks that only fed these tests go. This also
+ends the HE RX map's use of tx_chain_mask_shift for the RX chainmask.
+
+Contiguous chainmasks (every IPQ8074 and QCN9074 radio here) get the
+same capabilities as before.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -5538,7 +5538,7 @@
+ }
+ 
+ static struct ieee80211_sta_ht_cap
+-ath11k_create_ht_cap(struct ath11k *ar, u32 ar_ht_cap, u32 rate_cap_rx_chainmask)
++ath11k_create_ht_cap(struct ath11k *ar, u32 ar_ht_cap)
+ {
+ 	int i;
+ 	struct ieee80211_sta_ht_cap ht_cap = {};
+@@ -5593,10 +5593,9 @@
+ 	if (ar_vht_cap & WMI_VHT_CAP_MAX_MPDU_LEN_MASK)
+ 		ht_cap.cap |= IEEE80211_HT_CAP_MAX_AMSDU;
+ 
+-	for (i = 0; i < ar->num_rx_chains; i++) {
+-		if (rate_cap_rx_chainmask & BIT(i))
+-			ht_cap.mcs.rx_mask[i] = 0xFF;
+-	}
++	/* a stream for every chain, whichever chains the chainmask names */
++	for (i = 0; i < ar->num_rx_chains; i++)
++		ht_cap.mcs.rx_mask[i] = 0xFF;
+ 
+ 	ht_cap.mcs.tx_params |= IEEE80211_HT_MCS_TX_DEFINED;
+ 
+@@ -5705,8 +5704,7 @@
+ }
+ 
+ static struct ieee80211_sta_vht_cap
+-ath11k_create_vht_cap(struct ath11k *ar, u32 rate_cap_tx_chainmask,
+-		      u32 rate_cap_rx_chainmask)
++ath11k_create_vht_cap(struct ath11k *ar)
+ {
+ 	struct ieee80211_sta_vht_cap vht_cap = {};
+ 	u16 txmcs_map, rxmcs_map;
+@@ -5724,18 +5722,18 @@
+ 	rxmcs_map = 0;
+ 	txmcs_map = 0;
+ 	for (i = 0; i < 8; i++) {
+-		if (i < ar->num_tx_chains && rate_cap_tx_chainmask & BIT(i))
++		if (i < ar->num_tx_chains)
+ 			txmcs_map |= IEEE80211_VHT_MCS_SUPPORT_0_9 << (i * 2);
+ 		else
+ 			txmcs_map |= IEEE80211_VHT_MCS_NOT_SUPPORTED << (i * 2);
+ 
+-		if (i < ar->num_rx_chains && rate_cap_rx_chainmask & BIT(i))
++		if (i < ar->num_rx_chains)
+ 			rxmcs_map |= IEEE80211_VHT_MCS_SUPPORT_0_9 << (i * 2);
+ 		else
+ 			rxmcs_map |= IEEE80211_VHT_MCS_NOT_SUPPORTED << (i * 2);
+ 	}
+ 
+-	if (rate_cap_tx_chainmask <= 1)
++	if (ar->num_tx_chains <= 1)
+ 		vht_cap.cap &= ~IEEE80211_VHT_CAP_TXSTBC;
+ 
+ 	vht_cap.vht_mcs.rx_mcs_map = cpu_to_le16(rxmcs_map);
+@@ -5749,20 +5747,14 @@
+ 					u32 *ht_cap_info)
+ {
+ 	struct ieee80211_supported_band *band;
+-	u32 rate_cap_tx_chainmask;
+-	u32 rate_cap_rx_chainmask;
+ 	u32 ht_cap;
+ 
+-	rate_cap_tx_chainmask = ar->cfg_tx_chainmask >> cap->tx_chain_mask_shift;
+-	rate_cap_rx_chainmask = ar->cfg_rx_chainmask >> cap->rx_chain_mask_shift;
+-
+ 	if (cap->supported_bands & WMI_HOST_WLAN_2G_CAP) {
+ 		band = &ar->mac.sbands[NL80211_BAND_2GHZ];
+ 		ht_cap = cap->band[NL80211_BAND_2GHZ].ht_cap_info;
+ 		if (ht_cap_info)
+ 			*ht_cap_info = ht_cap;
+-		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap,
+-						    rate_cap_rx_chainmask);
++		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap);
+ 	}
+ 
+ 	/* A 6 GHz capable radio may cover 5 GHz as well, as a QCN9074 does:
+@@ -5775,10 +5767,8 @@
+ 		ht_cap = cap->band[NL80211_BAND_5GHZ].ht_cap_info;
+ 		if (ht_cap_info)
+ 			*ht_cap_info = ht_cap;
+-		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap,
+-						    rate_cap_rx_chainmask);
+-		band->vht_cap = ath11k_create_vht_cap(ar, rate_cap_tx_chainmask,
+-						      rate_cap_rx_chainmask);
++		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap);
++		band->vht_cap = ath11k_create_vht_cap(ar);
+ 	}
+ }
+ 
+@@ -5931,14 +5921,12 @@
+ 	rxmcs_map = 0;
+ 	txmcs_map = 0;
+ 	for (i = 0; i < 8; i++) {
+-		if (i < ar->num_tx_chains &&
+-		    (ar->cfg_tx_chainmask >> cap->tx_chain_mask_shift) & BIT(i))
++		if (i < ar->num_tx_chains)
+ 			txmcs_map |= IEEE80211_HE_MCS_SUPPORT_0_11 << (i * 2);
+ 		else
+ 			txmcs_map |= IEEE80211_HE_MCS_NOT_SUPPORTED << (i * 2);
+ 
+-		if (i < ar->num_rx_chains &&
+-		    (ar->cfg_rx_chainmask >> cap->tx_chain_mask_shift) & BIT(i))
++		if (i < ar->num_rx_chains)
+ 			rxmcs_map |= IEEE80211_HE_MCS_SUPPORT_0_11 << (i * 2);
+ 		else
+ 			rxmcs_map |= IEEE80211_HE_MCS_NOT_SUPPORTED << (i * 2);
-- 
2.43.0

