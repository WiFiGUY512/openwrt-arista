From ab2be12bd20e9e306ccb4116053b62a22f21d9ca Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Fri, 16 Oct 2026 11:51:59 -0500
Subject: [PATCH] bluetooth-uart: add an option to disable flow control

btattach enables hardware flow control unless given -N. Some
controllers run without it: the Nordic nRF52833 on the Arista C-360
never answers HCI Reset (opcode 0x0c03 times out) with flow control on,
and works with it off. Add a flow_control option, on by default as
before, that passes -N to btattach when disabled.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/utils/bluetooth-uart/Makefile                    | 2 +-
 package/utils/bluetooth-uart/files/bluetooth-uart.config | 1 +
 package/utils/bluetooth-uart/files/bluetooth-uart.init   | 4 +++-
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/package/utils/bluetooth-uart/Makefile b/package/utils/bluetooth-uart/Makefile
index 0a2eefe8b7..87959a7e74 100644
--- a/package/utils/bluetooth-uart/Makefile
+++ b/package/utils/bluetooth-uart/Makefile
@@ -3,7 +3,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=bluetooth-uart
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=LICENSE
 PKG_MAINTAINER:=Satoshi Ikeuchi <satosan.ikm@gmail.com>
diff --git a/package/utils/bluetooth-uart/files/bluetooth-uart.config b/package/utils/bluetooth-uart/files/bluetooth-uart.config
index c6c73e2df8..e82b70186e 100644
--- a/package/utils/bluetooth-uart/files/bluetooth-uart.config
+++ b/package/utils/bluetooth-uart/files/bluetooth-uart.config
@@ -3,3 +3,4 @@ config uart 'main'
 	option device ''
 	option protocol 'h4'
 	option speed '115200'
+	option flow_control '1'
diff --git a/package/utils/bluetooth-uart/files/bluetooth-uart.init b/package/utils/bluetooth-uart/files/bluetooth-uart.init
index 68d3cc9781..8b38cd0292 100755
--- a/package/utils/bluetooth-uart/files/bluetooth-uart.init
+++ b/package/utils/bluetooth-uart/files/bluetooth-uart.init
@@ -6,16 +6,18 @@ STOP=10
 USE_PROCD=1
 
 start_uart() {
-	local section="$1" enabled device protocol speed
+	local section="$1" enabled device protocol speed flow_control
 	config_get_bool enabled "$section" enabled 0
 	[ "$enabled" = 1 ] || return 0
 	config_get device "$section" device
 	config_get protocol "$section" protocol h4
 	config_get speed "$section" speed 115200
+	config_get_bool flow_control "$section" flow_control 1
 	[ -c "$device" ] || return 1
 
 	procd_open_instance "$section"
 	procd_set_param command /usr/bin/btattach -B "$device" -P "$protocol" -S "$speed"
+	[ "$flow_control" = 1 ] || procd_append_param command -N
 	procd_set_param respawn 3600 5 3
 	procd_set_param stdout 1
 	procd_set_param stderr 1
-- 
2.43.0

