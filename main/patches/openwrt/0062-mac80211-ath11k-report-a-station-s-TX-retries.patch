From be5476ff2da13fb12c98af4c3c5f2e2ccc6a22e9 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sun, 1 Nov 2026 03:08:46 -0600
Subject: [PATCH] mac80211: ath11k: report a station's TX retries

ath11k patch 117 (for upstream), B62: ath11k gave mac80211 no rate
table in its TX status, so mac80211 counted no retries and iw showed
"tx retries: 0" for every ath11k station (C360-AP 6 GHz client: 0
after 55284 frames at HE-MCS 11). Count each completed frame's
transmit count less one per station and report it as
NL80211_STA_INFO_TX_RETRIES, as ath12k does.

Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/kernel/mac80211/Makefile              |  2 +-
 ...ath11k-report-a-station-s-TX-retries.patch | 53 +++++++++++++++++++
 2 files changed, 54 insertions(+), 1 deletion(-)
 create mode 100755 package/kernel/mac80211/patches/ath11k/117-wifi-ath11k-report-a-station-s-TX-retries.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index 65ed559be6..ba14dee5d2 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
 
 PKG_SOURCE_VERSION:=7.2
 PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
-PKG_RELEASE:=25
+PKG_RELEASE:=26
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
diff --git a/package/kernel/mac80211/patches/ath11k/117-wifi-ath11k-report-a-station-s-TX-retries.patch b/package/kernel/mac80211/patches/ath11k/117-wifi-ath11k-report-a-station-s-TX-retries.patch
new file mode 100755
index 0000000000..056bfb079d
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/117-wifi-ath11k-report-a-station-s-TX-retries.patch
@@ -0,0 +1,53 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Subject: [PATCH ath-next] wifi: ath11k: report a station's TX retries
+
+ath11k_dp_tx_complete_msdu() hands mac80211 a status with no entry in
+info->status.rates[], so that mac80211 does not update its rate
+statistics from it, and a single rate with a try count of 1. mac80211
+takes its retry count from info->status.rates[], so it counts none, and
+"iw station dump" shows "tx retries: 0" for every station: on an Arista
+C-360 (QCN9074, 6 GHz) a client showed 0 retries after 55284 frames at
+HE-MCS 11.
+
+The TX completion carries the frame's transmit count (try_cnt), which
+the extended TX stats already use. Count the retransmissions per
+station from it and report them as NL80211_STA_INFO_TX_RETRIES, as
+ath12k does. mac80211's TX failed count (frames never acked) is
+unchanged.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+--- a/drivers/net/wireless/ath/ath11k/core.h
++++ b/drivers/net/wireless/ath/ath11k/core.h
+@@ -561,6 +561,7 @@
+ 	struct rate_info last_txrate;
+ 	u64 rx_duration;
+ 	u64 tx_duration;
++	u64 tx_retries;
+ 	u8 rssi_comb;
+ 	struct ewma_avg_rssi avg_rssi;
+ 	s8 rssi_beacon;
+--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
++++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
+@@ -637,6 +637,8 @@
+ 		return;
+ 	}
+ 	arsta = ath11k_sta_to_arsta(peer->sta);
++	if (ts->try_cnt > 1)
++		arsta->tx_retries += ts->try_cnt - 1;
+ 	status.sta = peer->sta;
+ 	status.skb = msdu;
+ 	status.info = info;
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -9553,6 +9553,9 @@
+ 	sinfo->tx_duration = arsta->tx_duration;
+ 	sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_DURATION);
+ 
++	sinfo->tx_retries = arsta->tx_retries;
++	sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_RETRIES);
++
+ 	if (arsta->txrate.legacy || arsta->txrate.nss) {
+ 		if (arsta->txrate.legacy) {
+ 			sinfo->txrate.legacy = arsta->txrate.legacy;
-- 
