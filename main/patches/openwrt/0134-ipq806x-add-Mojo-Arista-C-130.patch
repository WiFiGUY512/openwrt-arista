 .../linux/ipq806x/dts/qcom-ipq8068-c-130.dts  | 313 ++++++++++++++++++
 target/linux/ipq806x/image/generic.mk         |  18 +
 7 files changed, 339 insertions(+), 1 deletion(-)
 create mode 100644 package/firmware/ipq-wifi/files/board-mojo_c-130.qca9984
