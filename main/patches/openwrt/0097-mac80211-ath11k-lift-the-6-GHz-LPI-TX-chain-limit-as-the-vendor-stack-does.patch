From b1b03118d34916d37ca5d21a395cc3ddda86773a Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Thu, 5 Nov 2026 14:38:04 -0600
Subject: [PATCH] mac80211: ath11k: lift the 6 GHz LPI TX-chain limit as the
 vendor stack does

B11: Arista's stack sends rate-control unit test 36 = 0 on every 6 GHz
radio; ath11k never did, so our QCN9074 APs kept the firmware's LPI
TX-chain limit. A/B/A on C360-AP 6 GHz (ch 69/160, FastConnect 7800):
client 5-6 dB stronger with it lifted, pinned HE-MCS 8x2 280 -> 871
Mbit/s, back with 36 = 1. Sent after each 6 GHz AP vdev start/restart;
ath11k.lpi_tx_chain_limit=1 keeps the limit. Griff 11-05: match Arista,
on by default. Port-only (vendor unit-test command). Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/kernel/mac80211/Makefile              |  2 +-
 ...chain-limit-as-the-vendor-stack-does.patch | 89 +++++++++++++++++++
 2 files changed, 90 insertions(+), 1 deletion(-)
 create mode 100644 package/kernel/mac80211/patches/ath11k/980-wifi-ath11k-lift-the-6-GHz-LPI-TX-chain-limit-as-the-vendor-stack-does.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index 019cf51..1f609e8 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
 
 PKG_SOURCE_VERSION:=7.2
 PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
-PKG_RELEASE:=32
+PKG_RELEASE:=33
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
diff --git a/package/kernel/mac80211/patches/ath11k/980-wifi-ath11k-lift-the-6-GHz-LPI-TX-chain-limit-as-the-vendor-stack-does.patch b/package/kernel/mac80211/patches/ath11k/980-wifi-ath11k-lift-the-6-GHz-LPI-TX-chain-limit-as-the-vendor-stack-does.patch
new file mode 100644
index 0000000..0ec2024
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/980-wifi-ath11k-lift-the-6-GHz-LPI-TX-chain-limit-as-the-vendor-stack-does.patch
@@ -0,0 +1,89 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Subject: [PATCH] wifi: ath11k: lift the 6 GHz LPI TX-chain limit as the vendor stack does
+
+The vendor's stack sends rate-control unit test 36 = 0 (module 10) on every
+6 GHz radio, which lifts the firmware's 6 GHz LPI TX-chain limit; ath11k
+never sends it. On an Arista C-360 (QCN9074, ch 69/160, txpower 20) a
+FastConnect 7800 heard the AP 5-6 dB stronger with the limit lifted, and
+pinned HE-MCS 8x2 went from 280 to 871 Mbit/s (retries 411% -> 59%); unit
+test 36 = 1 put the limit back (A/B/A), the AP's view of the client stayed
+at -52/-53 throughout.
+
+Send it after each 6 GHz AP vdev start or restart (a channel switch or a
+firmware recovery starts the vdev again). ath11k.lpi_tx_chain_limit=1
+keeps the firmware's limit. ath11k_wmi_send_unit_test_cmd() is exported
+for it.
+
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -7584,6 +7584,33 @@ static void ath11k_mac_op_remove_chanctx
+ 	mutex_unlock(&ar->conf_mutex);
+ }
+ 
++/* The vendor's own stack lifts the firmware's 6 GHz LPI TX-chain limit on
++ * every 6 GHz radio (rate control unit test 36 = 0), so that an AP sends on
++ * all its chains. Without it a QCN9074 AP is received about 5 dB weaker on
++ * 6 GHz and cannot hold HE-MCS 8 where the vendor image does.
++ */
++static bool ath11k_lpi_tx_chain_limit;
++module_param_named(lpi_tx_chain_limit, ath11k_lpi_tx_chain_limit, bool, 0644);
++MODULE_PARM_DESC(lpi_tx_chain_limit, "Keep the firmware's 6 GHz LPI TX-chain limit (default: lifted, as the vendor stack does)");
++
++static void ath11k_mac_lift_6ghz_lpi_chain_limit(struct ath11k *ar, u32 vdev_id)
++{
++	struct wmi_unit_test_cmd ut = {
++		.vdev_id = vdev_id,
++		.module_id = 10,	/* rate control */
++		.num_args = 2,
++	};
++	u32 args[2] = { 36, 0 };
++	int ret;
++
++	ret = ath11k_wmi_send_unit_test_cmd(ar, ut, args);
++	if (ret)
++		ath11k_warn(ar->ab, "failed to lift the 6 GHz LPI TX-chain limit on vdev %u: %d\n",
++		            vdev_id, ret);
++	else
++		ath11k_info(ar->ab, "vdev %u: 6 GHz LPI TX-chain limit lifted\n", vdev_id);
++}
++
+ static int
+ ath11k_mac_vdev_start_restart(struct ath11k_vif *arvif,
+ 			      struct ieee80211_chanctx_conf *ctx,
+@@ -7677,6 +7704,11 @@ ath11k_mac_vdev_start_restart(struct ath
+ 						   &arvif->reg_tpc_info);
+ 	}
+ 
++	if (arvif->vdev_type == WMI_VDEV_TYPE_AP &&
++	    chandef->chan->band == NL80211_BAND_6GHZ &&
++	    !ath11k_lpi_tx_chain_limit)
++		ath11k_mac_lift_6ghz_lpi_chain_limit(ar, arvif->vdev_id);
++
+ 	if (!restart)
+ 		ar->num_started_vdevs++;
+ 
+--- a/drivers/net/wireless/ath/ath11k/wmi.c
++++ b/drivers/net/wireless/ath/ath11k/wmi.c
+@@ -9108,7 +9108,7 @@ static int ath11k_connect_pdev_htc_servi
+ 	return 0;
+ }
+ 
+-static int
++int
+ ath11k_wmi_send_unit_test_cmd(struct ath11k *ar,
+ 			      struct wmi_unit_test_cmd ut_cmd,
+ 			      u32 *test_args)
+--- a/drivers/net/wireless/ath/ath11k/wmi.h
++++ b/drivers/net/wireless/ath/ath11k/wmi.h
+@@ -6545,6 +6545,9 @@ void ath11k_wmi_fw_stats_fill(struct ath
+ 			      struct ath11k_fw_stats *fw_stats, u32 stats_id,
+ 			      char *buf);
+ int ath11k_wmi_simulate_radar(struct ath11k *ar);
++int ath11k_wmi_send_unit_test_cmd(struct ath11k *ar,
++				  struct wmi_unit_test_cmd ut_cmd,
++				  u32 *test_args);
+ void ath11k_wmi_fill_default_twt_params(struct wmi_twt_enable_params *twt_params);
+ int ath11k_wmi_send_twt_enable_cmd(struct ath11k *ar, u32 pdev_id,
+ 				   struct wmi_twt_enable_params *params);
-- 
