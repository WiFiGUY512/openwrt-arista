From 498c3c9418c8ef2f9c1e14127da1ce4ea9e23627 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sun, 18 Oct 2026 08:54:37 -0500
Subject: [PATCH 12/18] qualcommax: ipq60xx: w-318: light the radio LEDs

The 2.4, 5 and 6 LEDs had no trigger. Phy numbers follow the order the
radios were first found in, which can differ between units, so board.d
cannot name them. A hotplug script ties each LED to its radio by device
path instead, with the radio's phyNradio trigger: the LED is lit while
the radio is enabled.

Tested on a unit: the three LEDs follow the IPQ6010's two radios and
the QCN9072 card.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 .../hotplug.d/ieee80211/12-arista-w-318-leds  | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)
 create mode 100755 target/linux/qualcommax/ipq60xx/base-files/etc/hotplug.d/ieee80211/12-arista-w-318-leds

diff --git a/target/linux/qualcommax/ipq60xx/base-files/etc/hotplug.d/ieee80211/12-arista-w-318-leds b/target/linux/qualcommax/ipq60xx/base-files/etc/hotplug.d/ieee80211/12-arista-w-318-leds
new file mode 100755
index 00000000..34a439ba
--- /dev/null
+++ b/target/linux/qualcommax/ipq60xx/base-files/etc/hotplug.d/ieee80211/12-arista-w-318-leds
@@ -0,0 +1,30 @@
+#!/bin/sh
+# Arista W-318: each radio LED follows its radio, found by device path.
+# Phy numbers follow the order the radios were first found in, which
+# differs between units. 2.4 and 5 are the IPQ6010's radios, 6 is the
+# QCN9072 card on pcie0. "phyNradio" lights the LED while the radio is
+# enabled.
+
+[ "$ACTION" = add ] || exit 0
+
+. /lib/functions.sh
+
+[ "$(board_name)" = arista,w-318 ] || exit 0
+
+case "$(readlink "/sys/class/ieee80211/$DEVICENAME/device")" in
+*/c000000.wifi)
+	if iw phy "$DEVICENAME" info | grep -q "Band 1:"; then
+		led=green:wlan-2ghz
+	else
+		led=green:wlan-5ghz
+	fi
+	;;
+*/0000:01:00.0)
+	led=green:wlan-6ghz
+	;;
+*)
+	exit 0
+	;;
+esac
+
+echo "${DEVICENAME}radio" > "/sys/class/leds/$led/trigger"
