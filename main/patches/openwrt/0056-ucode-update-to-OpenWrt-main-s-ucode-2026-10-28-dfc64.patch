- 	else if (!strcmp(p + 1, ".uc"))
- 		rv = uc_require_ucode(vm, buf->buf, NULL, res, true, module_mode);
- 
--	if (rv)
-+	if (rv && vm->exception.type == EXCEPTION_NONE)
- 		ucv_object_add(modtable, name, ucv_get(*res));
