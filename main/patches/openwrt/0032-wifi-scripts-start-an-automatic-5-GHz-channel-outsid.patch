From b11316577d41991efc587d4f23c4bf79552cda64 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Wed, 28 Oct 2026 09:00:00 -0500
Subject: [PATCH] wifi-scripts: start an automatic 5 GHz channel outside DFS

With channel auto, hostapd's ACS may pick a DFS channel, and the radio
then sends nothing for its radar check, 60 s in the US and up to 10
minutes on Europe's weather radar channels, at every start: a reboot, a
config change, a wifi reload. Clients that roam to or reconnect on the
radio find it silent.

Add a wifi-device option, dfs_look_first (on by default). Where the
channel is automatic on 5 GHz, it sets acs_exclude_dfs, so the radio
starts outside DFS and serves at once. Something that has looked at
the channels may then move it to a DFS one by hostapd's CHAN_SWITCH,
which does the radar check there. Where no block outside DFS fits the
radio's width and channel list (160 MHz, or a list of DFS channels
only), the radio starts as before.

dfs_look_first '0' gives the old behaviour; acs_exclude_dfs '1' keeps
the radio off DFS entirely, as before.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/network/config/wifi-scripts/Makefile  |  2 +-
 .../share/schema/wireless.wifi-device.json    |  5 +++
 .../usr/share/ucode/wifi/hostapd.uc           | 40 +++++++++++++++++++
 3 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/package/network/config/wifi-scripts/Makefile b/package/network/config/wifi-scripts/Makefile
index e3e1b8860a..a2c88bffdb 100644
--- a/package/network/config/wifi-scripts/Makefile
+++ b/package/network/config/wifi-scripts/Makefile
@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=wifi-scripts
 PKG_VERSION:=1.0
-PKG_RELEASE:=5
+PKG_RELEASE:=6
 PKG_LICENSE:=GPL-2.0
 
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
diff --git a/package/network/config/wifi-scripts/files-ucode/usr/share/schema/wireless.wifi-device.json b/package/network/config/wifi-scripts/files-ucode/usr/share/schema/wireless.wifi-device.json
index 8847dc370a..94d94eecb9 100644
--- a/package/network/config/wifi-scripts/files-ucode/usr/share/schema/wireless.wifi-device.json
+++ b/package/network/config/wifi-scripts/files-ucode/usr/share/schema/wireless.wifi-device.json
@@ -134,6 +134,11 @@
 			"type": "alias",
 			"default": "ieee80211d"
 		},
+		"dfs_look_first": {
+			"description": "Start an automatic 5 GHz channel outside DFS channels, where the width and channel list allow; a DFS channel may be moved to afterwards",
+			"type": "boolean",
+			"default": true
+		},
 		"disabled": {
 			"description": "When set to 1, wireless network is disabled",
 			"type": "boolean",
diff --git a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc
index 7da6d22ac9..0b64825642 100644
--- a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc
+++ b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc
@@ -50,6 +50,39 @@ function set_device_defaults(config) {
 		}
 }
 
+/* does the channel list (chanlist: channels and ranges such as "36-48")
+ * take in channel c? With no list, every channel is in it */
+function chanlist_has(list, c) {
+	if (!length(list))
+		return true;
+
+	for (let v in list)
+		for (let w in split(v, ' ')) {
+			let r = split(w, '-');
+			if (length(r) == 2 ? (c >= +r[0] && c <= +r[1]) : (+r[0] == c))
+				return true;
+		}
+
+	return false;
+}
+
+/* is there a 5 GHz block outside DFS channels (52-144) at the radio's
+ * width, wholly in its channel list, for ACS to start it on? */
+function dfs_free_start(config) {
+	let width = +(match(config.htmode ?? '', /([0-9]+)/)?.[1] ?? 20);
+	let blocks = {
+		'20': [ [ 36 ], [ 40 ], [ 44 ], [ 48 ], [ 149 ], [ 153 ], [ 157 ], [ 161 ], [ 165 ] ],
+		'40': [ [ 36, 40 ], [ 44, 48 ], [ 149, 153 ], [ 157, 161 ] ],
+		'80': [ [ 36, 40, 44, 48 ], [ 149, 153, 157, 161 ] ],
+	}[`${width}`];
+
+	for (let b in blocks ?? [])
+		if (length(filter(b, (c) => chanlist_has(config.chanlist, c))) == length(b))
+			return true;
+
+	return false;
+}
+
 /* setup sylog / stdout */
 function device_log_append(config) {
 	let log_mask = 0;
@@ -540,6 +573,13 @@ function generate(config) {
 	else
 		set_default(config, 'enable_background_radar', false);
 
+	/* an automatic 5 GHz channel starts outside DFS, so the radio serves at
+	 * once rather than after a radar check; dfs-look may move it to a DFS
+	 * channel once it has looked. A width or channel list with no block
+	 * outside DFS starts as before */
+	if (config.dfs_look_first && config.band == '5g' && !config.channel && dfs_free_start(config))
+		config.acs_exclude_dfs = true;
+
 	append_vars(config, [ 'acs_chan_bias', 'acs_exclude_dfs', 'enable_background_radar' ]);
 
 	/* TX Power */
-- 
