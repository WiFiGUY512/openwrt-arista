From dc77625f8f2cacbdc87398ce14291c697ac2eb1f Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Fri, 6 Nov 2026 00:53:06 -0600
Subject: [PATCH] mac80211: ath11k: print each user's sounding counts in
 htt_stats

B158: htt_stats type 22 printed user 0's sounding counts on every
"Sounding User" line; the array is per user (sounding[user * 4 + bw]),
as ath12k prints it. Going upstream. Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/kernel/mac80211/Makefile              |  2 +-
 ...-user-s-sounding-counts-in-htt_stats.patch | 54 +++++++++++++++++++
 2 files changed, 55 insertions(+), 1 deletion(-)
 create mode 100644 package/kernel/mac80211/patches/ath11k/125-wifi-ath11k-print-each-user-s-sounding-counts-in-htt_stats.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index 0d1cbfdecc..f979523b4d 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
 
 PKG_SOURCE_VERSION:=7.2
 PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
-PKG_RELEASE:=33
+PKG_RELEASE:=34
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
diff --git a/package/kernel/mac80211/patches/ath11k/125-wifi-ath11k-print-each-user-s-sounding-counts-in-htt_stats.patch b/package/kernel/mac80211/patches/ath11k/125-wifi-ath11k-print-each-user-s-sounding-counts-in-htt_stats.patch
new file mode 100644
index 0000000000..fde3ce2eb0
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/125-wifi-ath11k-print-each-user-s-sounding-counts-in-htt_stats.patch
@@ -0,0 +1,54 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Subject: [PATCH] wifi: ath11k: print each user's sounding counts in htt_stats
+
+The TX sounding stats of htt_stats print a "Sounding User" line for
+each of the 4 (11ac) or 8 (11ax) users, but every line shows
+sounding[0] to sounding[3], the 20/40/80/160 MHz counts of user 0. The
+array holds the counts of all users, at sounding[user * max_bw + bw]
+as the comment in struct htt_tx_sounding_stats_tlv says, and ath12k
+prints it that way.
+
+Print each user's own counts.
+
+Fixes: d5c65159f289 ("ath11k: driver for Qualcomm IEEE 802.11ax devices")
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+--- a/drivers/net/wireless/ath/ath11k/debugfs_htt_stats.c
++++ b/drivers/net/wireless/ath/ath11k/debugfs_htt_stats.c
+@@ -1235,13 +1235,12 @@ static inline void htt_print_tx_sounding
+ 				 cbf_160[HTT_EXPLICIT_TXBF_MU_RBO_STEER_STATS]);
+ 
+ 		for (i = 0; i < HTT_TX_PDEV_STATS_NUM_AC_MUMIMO_USER_STATS; i++) {
++			const u32 *snd = htt_stats_buf->sounding +
++					 i * HTT_TX_PDEV_STATS_NUM_BW_COUNTERS;
++
+ 			len += scnprintf(buf + len, buf_len - len,
+ 					 "Sounding User %u = 20MHz: %u, 40MHz : %u, 80MHz: %u, 160MHz: %u\n",
+-					 i,
+-					 htt_stats_buf->sounding[0],
+-					 htt_stats_buf->sounding[1],
+-					 htt_stats_buf->sounding[2],
+-					 htt_stats_buf->sounding[3]);
++					 i, snd[0], snd[1], snd[2], snd[3]);
+ 		}
+ 	} else if (htt_stats_buf->tx_sounding_mode == HTT_TX_AX_SOUNDING_MODE) {
+ 		len += scnprintf(buf + len, buf_len - len,
+@@ -1276,13 +1275,12 @@ static inline void htt_print_tx_sounding
+ 				 cbf_160[HTT_EXPLICIT_TXBF_MU_RBO_STEER_STATS]);
+ 
+ 		for (i = 0; i < HTT_TX_PDEV_STATS_NUM_AX_MUMIMO_USER_STATS; i++) {
++			const u32 *snd = htt_stats_buf->sounding +
++					 i * HTT_TX_PDEV_STATS_NUM_BW_COUNTERS;
++
+ 			len += scnprintf(buf + len, buf_len - len,
+ 					 "Sounding User %u = 20MHz: %u, 40MHz : %u, 80MHz: %u, 160MHz: %u\n",
+-					 i,
+-					 htt_stats_buf->sounding[0],
+-					 htt_stats_buf->sounding[1],
+-					 htt_stats_buf->sounding[2],
+-					 htt_stats_buf->sounding[3]);
++					 i, snd[0], snd[1], snd[2], snd[3]);
+ 		}
+ 	}
+ 
-- 
