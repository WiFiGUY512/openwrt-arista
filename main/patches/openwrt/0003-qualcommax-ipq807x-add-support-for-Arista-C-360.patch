--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq8074-c-360.dts
@@ -0,0 +1,576 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq8074.dtsi"
+#include "ipq8074-hk-cpu.dtsi"
+#include "ipq8074-ess.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Arista C-360";
+	compatible = "arista,c-360", "qcom,ipq8074";
+
+	aliases {
+		serial0 = &blsp1_uart5;
+		serial1 = &blsp1_uart3;
+		led-boot = &led_power_orange;
+		led-failsafe = &led_power_orange;
+		led-running = &led_power_green;
+		led-upgrade = &led_power_orange;
+		label-mac-device = &port_lan1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x80000000>;
+	};
+
+	reg_usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	gpio-export {
+		compatible = "gpio-export";
+
+		ble-nreset {
+			gpio-export,name = "ble-nreset";
+			gpio-export,output = <1>;
+			gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+		};
+
+		/*
+		 * the radio plan, as on the vendor firmware: low for 6 GHz (the
+		 * IPQ8074 on all of 5 GHz, the pcie0 QCN9074 on 6 GHz), high for
+		 * dual 5 GHz (the IPQ8074 on lower 5 GHz, the pcie0 QCN9074 on
+		 * upper 5 GHz)
+		 */
+		dual-5g {
+			gpio-export,name = "dual-5g";
+			gpio-export,output = <0>;
+			gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		reset {
+			label = "reset";
+			gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	led-spi {
+		compatible = "spi-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		sck-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+		mosi-gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
+
+		led_gpio: led-gpio@0 {
+			compatible = "fairchild,74hc595";
+			reg = <0>;
+			enable-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+			spi-max-frequency = <100000>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			registers-number = <2>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_power_green: led-0 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&led_gpio 0 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_power_orange: led-1 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&led_gpio 1 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-2 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_2GHZ;
+			gpios = <&led_gpio 2 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-3 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_5GHZ;
+			gpios = <&led_gpio 3 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-4 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_6GHZ;
+			gpios = <&led_gpio 4 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-5 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <1>;
+			gpios = <&led_gpio 5 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-6 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <1>;
+			gpios = <&led_gpio 6 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-8 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <2>;
+			gpios = <&led_gpio 8 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-9 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <2>;
+			gpios = <&led_gpio 9 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
+
+&blsp1_spi1 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:sbl1";
+				reg = <0x0 0x50000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "0:mibib";
+				reg = <0x50000 0x10000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "0:bootconfig";
+				reg = <0x60000 0x20000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "0:bootconfig1";
+				reg = <0x80000 0x20000>;
+				read-only;
+			};
+
+			partition@a0000 {
+				label = "0:qsee";
+				reg = <0xa0000 0x180000>;
+				read-only;
+			};
+
+			partition@220000 {
+				label = "0:qsee_1";
+				reg = <0x220000 0x180000>;
+				read-only;
+			};
+
+			partition@3a0000 {
+				label = "0:devcfg";
+				reg = <0x3a0000 0x10000>;
+				read-only;
+			};
+
+			partition@3b0000 {
+				label = "0:devcfg_1";
+				reg = <0x3b0000 0x10000>;
+				read-only;
+			};
+
+			partition@3c0000 {
+				label = "0:apdp";
+				reg = <0x3c0000 0x10000>;
+				read-only;
+			};
+
+			partition@3d0000 {
+				label = "0:apdp_1";
+				reg = <0x3d0000 0x10000>;
+				read-only;
+			};
+
+			partition@3e0000 {
+				label = "0:rpm";
+				reg = <0x3e0000 0x40000>;
+				read-only;
+			};
+
+			partition@420000 {
+				label = "0:rpm_1";
+				reg = <0x420000 0x40000>;
+				read-only;
+			};
+
+			partition@460000 {
+				label = "0:cdt";
+				reg = <0x460000 0x10000>;
+				read-only;
+			};
+
+			partition@470000 {
+				label = "0:cdt_1";
+				reg = <0x470000 0x10000>;
+				read-only;
+			};
+
+			partition@480000 {
+				label = "0:appsblenv";
+				reg = <0x480000 0x10000>;
+			};
+
+			partition@490000 {
+				label = "0:appsbl";
+				reg = <0x490000 0x100000>;
+				read-only;
+			};
+
+			partition@590000 {
+				label = "0:appsbl_1";
+				reg = <0x590000 0x100000>;
+				read-only;
+			};
+
+			partition@690000 {
+				label = "0:art";
+				reg = <0x690000 0x100000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_art_0: macaddr@0 {
+						reg = <0x0 0x6>;
+					};
+
+					macaddr_art_6: macaddr@6 {
+						reg = <0x6 0x6>;
+					};
+
+					caldata_ipq8074: calibration@1000 {
+						reg = <0x1000 0x20000>;
+					};
+
+					caldata_pcie0: calibration@26800 {
+						reg = <0x26800 0x20000>;
+					};
+
+					caldata_pcie1: calibration@4c000 {
+						reg = <0x4c000 0x20000>;
+					};
+				};
+			};
+
+			/* the Aquantia PHYs' firmware, which the bootloader loads */
+			partition@790000 {
+				label = "0:ethphyfw";
+				reg = <0x790000 0x80000>;
+				read-only;
+			};
+
+			partition@810000 {
+				label = "0:hlos";
+				reg = <0x810000 0x800000>;
+				read-only;
+			};
+
+			partition@1010000 {
+				label = "0:hlos_1";
+				reg = <0x1010000 0x800000>;
+				read-only;
+			};
+
+			partition@1810000 {
+				label = "config";
+				reg = <0x1810000 0x400000>;
+				read-only;
+			};
+
+			partition@1c10000 {
+				label = "devcert";
+				reg = <0x1c10000 0x20000>;
+				read-only;
+			};
+
+			partition@1c30000 {
+				label = "reserved1";
+				reg = <0x1c30000 0x20000>;
+				read-only;
+			};
+
+			partition@1c50000 {
+				label = "reserved2";
+				reg = <0x1c50000 0x3b0000>;
+				read-only;
+			};
+		};
+	};
+};
+
+/* Infineon SLB 9670 TPM 2.0 */
+&blsp1_spi4 {
+	pinctrl-0 = <&tpm_spi_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	tpm@0 {
+		compatible = "tcg,tpm_tis-spi";
+		reg = <0>;
+		spi-max-frequency = <12000000>;
+	};
+};
+
+/* the nRF52833 Bluetooth LE controller (HCI over UART, no flow control) */
+&blsp1_uart3 {
+	pinctrl-0 = <&ble_uart_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&blsp1_uart5 {
+	status = "okay";
+};
+
+&edma {
+	status = "okay";
+};
+
+&mdio {
+	status = "okay";
+
+	/* Ethernet 2 */
+	aqr113c_0: ethernet-phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <0>;
+	};
+
+	/* Ethernet 1 */
+	aqr113c_8: ethernet-phy@8 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <8>;
+	};
+};
+
+&pcie0 {
+	status = "okay";
+	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
+
+	pcie@0 {
+		/* QCN9074: the 6 GHz radio */
+		wifi@0,0 {
+			compatible = "pci17cb,1104";
+			reg = <0x00010000 0 0 0 0>;
+			/* as the vendor firmware: 16 + 1 interfaces, 512 clients */
+			qcom,ath11k-fw-memory-mode = <0>;
+			qcom,ath11k-calibration-variant = "Arista-C360-pcie0";
+			nvmem-cells = <&caldata_pcie0>;
+			nvmem-cell-names = "calibration";
+		};
+	};
+};
+
+&pcie1 {
+	status = "okay";
+	perst-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;
+
+	pcie@0 {
+		/* QCN9072, the 2x2 QCN9074: the 2.4/5/6 GHz radio */
+		wifi@0,0 {
+			compatible = "pci17cb,1104";
+			reg = <0x00010000 0 0 0 0>;
+			qcom,ath11k-fw-memory-mode = <0>;
+			qcom,ath11k-calibration-variant = "Arista-C360-pcie1";
+			nvmem-cells = <&caldata_pcie1>;
+			nvmem-cell-names = "calibration";
+		};
+	};
+};
+
+&pcie_qmp0 {
+	status = "okay";
+};
+
+&pcie_qmp1 {
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	/* absorbs the partitions the bootloader adds at boot */
+	partitions {
+		status = "disabled";
+	};
+
+	nand@0 {
+		reg = <0>;
+		nand-ecc-strength = <8>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* the stock firmware's first slot */
+			partition@0 {
+				label = "rootfs";
+				reg = <0x0 0x18000000>;
+				linux,rootfs;
+			};
+
+			/* the stock firmware's second slot, kept as a fallback */
+			partition@18000000 {
+				label = "rootfs_1";
+				reg = <0x18000000 0x18000000>;
+				read-only;
+			};
+
+			partition@30000000 {
+				label = "logging";
+				reg = <0x30000000 0x10000000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&qusb_phy_0 {
+	status = "okay";
+	vdd-supply = <&reg_usb_vbus>;
+};
+
+&ssphy_0 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			ethernet = <&edma>;
+			phy-mode = "internal";
+
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+
+		port_lan1: port@5 {
+			reg = <5>;
+			label = "lan1";
+			phy-handle = <&aqr113c_8>;
+			phy-mode = "usxgmii";
+			managed = "in-band-status";
+			pcs-handle = <&uniphy1 0>;
+			nvmem-cells = <&macaddr_art_0>;
+			nvmem-cell-names = "mac-address";
+		};
+
+		port@6 {
+			reg = <6>;
+			label = "lan2";
+			phy-handle = <&aqr113c_0>;
+			phy-mode = "usxgmii";
+			managed = "in-band-status";
+			pcs-handle = <&uniphy2 0>;
+			nvmem-cells = <&macaddr_art_6>;
+			nvmem-cell-names = "mac-address";
+		};
+	};
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio42";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	ble_uart_pins: ble-uart-state {
+		pins = "gpio46", "gpio47", "gpio48", "gpio49";
+		function = "blsp2_uart";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	tpm_spi_pins: tpm-spi-state {
+		pins = "gpio50", "gpio51", "gpio52", "gpio53";
+		function = "blsp3_spi";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
+
+&uniphy1 {
+	status = "okay";
+};
+
+&uniphy2 {
+	status = "okay";
+};
+
+&usb_0 {
+	status = "okay";
+};
+
+&wifi {
+	status = "okay";
+	qcom,ath11k-calibration-variant = "Arista-C360";
+	nvmem-cells = <&caldata_ipq8074>;
+	nvmem-cell-names = "calibration";
+};
