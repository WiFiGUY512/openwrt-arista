From a7a0f5080b00b0ed3310857d2917123f4632f55b Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sun, 1 Nov 2026 15:11:55 -0600
Subject: [PATCH] hostapd: let ubus switch_chan move a 6 GHz radio wider than
 20 MHz

hostapd_switch_chan() passed no segment indexes to
hostapd_set_freq_params(), which then sets center_freq1 to the 40 MHz
center (freq + sec_channel_offset * 10) and, unlike on 5 GHz, derives
no 80 or 160 MHz center on 6 GHz. A 6 GHz switch at 40 MHz or wider
went to the driver with that center and failed ("nl80211: kernel
reports: invalid channel definition", UBUS_STATUS_NOT_SUPPORTED), while
CHAN_SWITCH on the control socket, which passes the center frequency
through, moved the same radio. Seen on an Arista C-360 (QCN9074, HE80):
{"freq":6615,"center_freq1":6625,"bandwidth":80} failed, the same at
20 MHz worked.

Pass the requested center_freq1 and center_freq2 on as segment
indexes.

Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/network/services/hostapd/Makefile          | 2 +-
 package/network/services/hostapd/src/src/ap/ubus.c | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/package/network/services/hostapd/Makefile b/package/network/services/hostapd/Makefile
index 827f6c2ca0..45be25fee3 100644
--- a/package/network/services/hostapd/Makefile
+++ b/package/network/services/hostapd/Makefile
@@ -5,7 +5,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=hostapd
-PKG_RELEASE:=10
+PKG_RELEASE:=11
 
 PKG_SOURCE_URL:=https://w1.fi/hostap.git
 PKG_SOURCE_PROTO:=git
diff --git a/package/network/services/hostapd/src/src/ap/ubus.c b/package/network/services/hostapd/src/src/ap/ubus.c
index 1756c7e4a7..72d92027d8 100644
--- a/package/network/services/hostapd/src/src/ap/ubus.c
+++ b/package/network/services/hostapd/src/src/ap/ubus.c
@@ -1197,6 +1197,15 @@ hostapd_switch_chan(struct ubus_context *ctx, struct ubus_object *obj,
 	if (!css.freq_params.channel)
 		return UBUS_STATUS_NOT_SUPPORTED;
 
+	/* hostapd_set_freq_params() takes the center frequencies as channel
+	 * indexes and sets center_freq1 from them; without them it derives
+	 * an 80 or 160 MHz center only on 5 GHz, and a 6 GHz switch wider than
+	 * 20 MHz went to the driver with a 40 MHz center */
+	if (css.freq_params.center_freq1)
+		ieee80211_freq_to_chan(css.freq_params.center_freq1, &seg0);
+	if (css.freq_params.center_freq2)
+		ieee80211_freq_to_chan(css.freq_params.center_freq2, &seg1);
+
 	switch (css.freq_params.bandwidth) {
 	case 160:
 		chwidth = CHANWIDTH_160MHZ;
-- 
2.43.0

