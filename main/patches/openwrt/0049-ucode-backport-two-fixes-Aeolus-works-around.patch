From a79f4058cb1d8924b284f4d977d04bca038bbb16 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sat, 31 Oct 2026 01:23:09 -0500
Subject: [PATCH] ucode: backport two fixes Aeolus works around

Both reproduce on the images' ucode (b885dd0f) and are fixed upstream:

- 012 (153c627f, B69): a second require() of a module whose first load
  failed returned null instead of raising the error again.
- 013 (8a74d68a, B71): map(), filter() and call() kept their working
  values in C locals only, so a garbage collection triggered from the
  callback freed them; map() over 20000 values with gc("start") in the
  callback returned 1002 wrong entries.

Neither changes the ABI. (The uloop.task() descriptor leak, B72, is not
fixed by af8a3830 alone and comes with the full ucode update.)

Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/utils/ucode/Makefile                  |   2 +-
 ...-a-failed-module-in-the-module-table.patch |  88 +++++++++++++++
 ...filter-map-callfunc-across-user-code.patch | 103 ++++++++++++++++++
 3 files changed, 192 insertions(+), 1 deletion(-)
 create mode 100644 package/utils/ucode/patches/012-lib-do-not-store-a-failed-module-in-the-module-table.patch
 create mode 100644 package/utils/ucode/patches/013-lib-anchor-working-values-in-filter-map-callfunc-across-user-code.patch

diff --git a/package/utils/ucode/Makefile b/package/utils/ucode/Makefile
index 247f674012..4fe6cc8600 100644
--- a/package/utils/ucode/Makefile
+++ b/package/utils/ucode/Makefile
@@ -8,7 +8,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=ucode
-PKG_RELEASE:=3
+PKG_RELEASE:=4
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=https://github.com/ucode-lang/ucode.git
diff --git a/package/utils/ucode/patches/012-lib-do-not-store-a-failed-module-in-the-module-table.patch b/package/utils/ucode/patches/012-lib-do-not-store-a-failed-module-in-the-module-table.patch
new file mode 100644
index 0000000000..8817662890
--- /dev/null
+++ b/package/utils/ucode/patches/012-lib-do-not-store-a-failed-module-in-the-module-table.patch
@@ -0,0 +1,88 @@
+From 153c627fd44566b65e9694f9155842f5475315ef Mon Sep 17 00:00:00 2001
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 13 Oct 2026 11:59:12 +0200
+Subject: [PATCH] lib: do not store a failed module in the module table
+
+uc_require_path() stores the result of a load in the module table as
+soon as the file exists, also if the module raised an exception. The
+next import() or require() of that name then returns the incomplete
+result of the failed load, for example an empty namespace, and raises
+no error.
+
+Store the module only if the load raised no exception, so that a later
+load runs the module again.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+ lib.c                                         |  2 +-
+ .../04_modules/23_dynamic_import_failed       | 45 +++++++++++++++++++
+ 2 files changed, 46 insertions(+), 1 deletion(-)
+ create mode 100644 tests/custom/04_modules/23_dynamic_import_failed
+
+diff --git a/lib.c b/lib.c
+index 41ab339a..cfb7e7a6 100644
+--- a/lib.c
++++ b/lib.c
+@@ -3094,7 +3094,7 @@ uc_require_path(uc_vm_t *vm, const char *path_template, const char *name,
+ 	else if (!strcmp(p + 1, ".uc"))
+ 		rv = uc_require_ucode(vm, buf->buf, NULL, res, true, module_mode);
+ 
+-	if (rv)
++	if (rv && vm->exception.type == EXCEPTION_NONE)
+ 		ucv_object_add(modtable, name, ucv_get(*res));
+ 
+ out:
+diff --git a/tests/custom/04_modules/23_dynamic_import_failed b/tests/custom/04_modules/23_dynamic_import_failed
+new file mode 100644
+index 00000000..a31bc89d
+--- /dev/null
++++ b/tests/custom/04_modules/23_dynamic_import_failed
+@@ -0,0 +1,45 @@
++A dynamically loaded module whose body raises an exception is not stored in
++the module table. A later load runs the module again and does not return
++the incomplete namespace of the failed load.
++
++-- Testcase --
++function run(label, fn) {
++	try {
++		print(label, ": ", fn(), "\n");
++	}
++	catch (e) {
++		print(label, ": ", e.message, "\n");
++	}
++}
++
++global.fail = true;
++run("failed load #1", () => keys(import("failing")));
++run("failed load #2", () => keys(import("failing")));
++
++global.fail = false;
++run("good load", () => keys(import("failing")));
++run("stored module", () => keys(import("failing")));
++
++// A statement that only calls import() must not leak in the compiler.
++import("failing");
++-- End --
++
++-- File failing.uc --
++export const a = 1;
++
++if (global.fail)
++	die("module body failed");
++
++export const b = 2;
++-- End --
++
++-- Args --
++-R -L files/
++-- End --
++
++-- Expect stdout --
++failed load #1: module body failed
++failed load #2: module body failed
++good load: [ "a", "b" ]
++stored module: [ "a", "b" ]
++-- End --
+-- 
+2.43.0
+
diff --git a/package/utils/ucode/patches/013-lib-anchor-working-values-in-filter-map-callfunc-across-user-code.patch b/package/utils/ucode/patches/013-lib-anchor-working-values-in-filter-map-callfunc-across-user-code.patch
new file mode 100644
index 0000000000..4eebf0537b
--- /dev/null
+++ b/package/utils/ucode/patches/013-lib-anchor-working-values-in-filter-map-callfunc-across-user-code.patch
@@ -0,0 +1,103 @@
+From 8a74d68a34ab286a8c1a08f5de5de6e5fa29c114 Mon Sep 17 00:00:00 2001
+From: Matthew Cather <mattbob4@gmail.com>
+Date: Mon, 27 Apr 2026 21:18:53 -0700
+Subject: [PATCH] lib: anchor working values in filter/map/callfunc across user
+ code
+
+uc_filter and uc_map hold their result array in a C local; uc_callfunc
+holds the saved previous globals scope. A gc("collect") triggered from
+inside the user callback freed those values and left the builtin to
+dereference a dangling pointer once control returned.
+
+Push each onto the VM stack with ucv_get so they're rooted via vm->stack
+across the call.
+
+Signed-off-by: Matthew Cather <mattbob4@gmail.com>
+---
+ lib.c | 23 ++++++++++++++++-------
+ 1 file changed, 16 insertions(+), 7 deletions(-)
+
+diff --git a/lib.c b/lib.c
+index 70162260..fb7b6f63 100644
+--- a/lib.c
++++ b/lib.c
+@@ -934,6 +934,7 @@ uc_filter(uc_vm_t *vm, size_t nargs)
+ 		return NULL;
+ 
+ 	arr = ucv_array_new(vm);
++	uc_vm_stack_push(vm, ucv_get(arr));
+ 
+ 	for (arrlen = ucv_array_length(obj), arridx = 0; arridx < arrlen; arridx++) {
+ 		uc_vm_ctx_push(vm);
+@@ -956,6 +957,8 @@ uc_filter(uc_vm_t *vm, size_t nargs)
+ 		ucv_put(rv);
+ 	}
+ 
++	ucv_put(uc_vm_stack_pop(vm));
++
+ 	return arr;
+ }
+ 
+@@ -1224,6 +1227,7 @@ uc_map(uc_vm_t *vm, size_t nargs)
+ 		return NULL;
+ 
+ 	arr = ucv_array_new(vm);
++	uc_vm_stack_push(vm, ucv_get(arr));
+ 
+ 	for (arrlen = ucv_array_length(obj), arridx = 0; arridx < arrlen; arridx++) {
+ 		uc_vm_ctx_push(vm);
+@@ -1243,6 +1247,8 @@ uc_map(uc_vm_t *vm, size_t nargs)
+ 		ucv_array_push(arr, rv);
+ 	}
+ 
++	ucv_put(uc_vm_stack_pop(vm));
++
+ 	return arr;
+ }
+ 
+@@ -5741,7 +5747,7 @@ static uc_value_t *
+ uc_callfunc(uc_vm_t *vm, size_t nargs)
+ {
+ 	size_t argoff = vm->stack.count - nargs, i;
+-	uc_value_t *fn_scope, *prev_scope, *res;
++	uc_value_t *fn_scope, *prev_scope = NULL, *res;
+ 	uc_value_t *fn = uc_fn_arg(0);
+ 	uc_value_t *this = uc_fn_arg(1);
+ 	uc_value_t *scope = uc_fn_arg(2);
+@@ -5767,24 +5773,27 @@ uc_callfunc(uc_vm_t *vm, size_t nargs)
+ 		fn_scope = NULL;
+ 	}
+ 
++	if (fn_scope) {
++		prev_scope = ucv_get(uc_vm_scope_get(vm));
++		uc_vm_stack_push(vm, ucv_get(prev_scope));
++		uc_vm_scope_set(vm, fn_scope);
++	}
++
+ 	uc_vm_stack_push(vm, ucv_get(this));
+ 	uc_vm_stack_push(vm, ucv_get(fn));
+ 
+ 	for (i = 3; i < nargs; i++)
+ 		uc_vm_stack_push(vm, ucv_get(vm->stack.entries[3 + argoff++]));
+ 
+-	if (fn_scope) {
+-		prev_scope = ucv_get(uc_vm_scope_get(vm));
+-		uc_vm_scope_set(vm, fn_scope);
+-	}
+-
+ 	if (uc_vm_call(vm, true, i - 3) == EXCEPTION_NONE)
+ 		res = uc_vm_stack_pop(vm);
+ 	else
+ 		res = NULL;
+ 
+-	if (fn_scope)
++	if (fn_scope) {
+ 		uc_vm_scope_set(vm, prev_scope);
++		ucv_put(uc_vm_stack_pop(vm));
++	}
+ 
+ 	return res;
+ }
+-- 
+2.43.0
+
-- 
2.43.0

