From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sat, 31 Oct 2026 10:12:31 -0500
Subject: [PATCH] uhttpd: update to OpenWrt main's uhttpd (2026-10-19)

OpenWrt main's 20c44f41b2, which brings uhttpd's "ucode: add fallback
to avoid compilation error" (ca796d7dec56): without it uhttpd-mod-ucode
does not build against ucode dfc64d41 (port 0056).

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
diff --git a/package/network/services/uhttpd/Makefile b/package/network/services/uhttpd/Makefile
--- a/package/network/services/uhttpd/Makefile
+++ b/package/network/services/uhttpd/Makefile
@@ -5,13 +5,13 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=uhttpd
-PKG_RELEASE:=2
+PKG_RELEASE:=1
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=$(PROJECT_GIT)/project/uhttpd.git
-PKG_SOURCE_DATE:=2026-08-24
-PKG_SOURCE_VERSION:=373145f72c884c36a2b16f7f47e74ffae06bd754
-PKG_MIRROR_HASH:=3d1533281f0c78fc6f1118dd0635b7bd2d0c823e6c7ad63aec818769fac3cde9
+PKG_SOURCE_DATE:=2026-10-19
+PKG_SOURCE_VERSION:=ca796d7dec5697a2d1a7a42be79677f239b64282
+PKG_MIRROR_HASH:=6a2fbcc0dbd3f6c9d076037f23b8544356487aea6b00d2a82a3591b09ba4a8e4
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
 PKG_LICENSE:=ISC
 
