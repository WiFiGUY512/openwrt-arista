From 43b7b7ee6b532665b7868279be3215ee312ed616 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Mon, 26 Oct 2026 22:00:00 -0500
Subject: [PATCH 28/28] hostapd: remove the interfaces of a phy that is gone

When a wiphy goes away (its driver unloaded or unbound, or the PCI
device removed) and comes back under a new name, hostapd kept the old
phy's interfaces and their hostapd.<ifname> ubus objects next to the
new ones until wpad was restarted (seen on a C-260 after an ath11k
reload: hostapd.phy7-ap0..3 beside hostapd.phy9-ap0..3).

netifd does send the teardown, config_set with an empty config for the
old phy, but iface_set_config() opened the phy before acting on an
empty config, found it gone, and returned. Remove the interface (and
drop its config) when its phy cannot be opened; leave netdevs alone,
since their names may belong to the new phy by now.

wifi reconf can set a radio up on the new phy with no teardown at all,
so nothing ever names the old phy again: on config_set, also remove
the interfaces of any other phy that no longer exists.

Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/network/services/hostapd/Makefile     |  2 +-
 .../network/services/hostapd/files/hostapd.uc | 31 +++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/package/network/services/hostapd/Makefile b/package/network/services/hostapd/Makefile
index 1ba4ac61..8124c0d9 100644
--- a/package/network/services/hostapd/Makefile
+++ b/package/network/services/hostapd/Makefile
@@ -5,7 +5,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=hostapd
-PKG_RELEASE:=4
+PKG_RELEASE:=5
 
 PKG_SOURCE_URL:=https://w1.fi/hostap.git
 PKG_SOURCE_PROTO:=git
diff --git a/package/network/services/hostapd/files/hostapd.uc b/package/network/services/hostapd/files/hostapd.uc
index 9a01e811..87cfc42d 100644
--- a/package/network/services/hostapd/files/hostapd.uc
+++ b/package/network/services/hostapd/files/hostapd.uc
@@ -1211,6 +1211,33 @@ function iface_config_remove(name, old_config)
 	return iface_remove(old_config);
 }
 
+// A wiphy that goes away, e.g. with its driver, takes its netdevs along, but
+// hostapd only disables a BSS whose netdev is gone. The interface, its BSSes
+// and their hostapd.<ifname> ubus objects stay until they are removed here.
+// The netdev names can belong to another phy by now, so leave netdevs alone.
+function iface_phy_gone(name)
+{
+	if (hostapd.interfaces[name] || hostapd.data.pending_config[name])
+		hostapd.printf(`Remove the interface of phy ${name}, which is gone`);
+
+	iface_config_remove(name, null);
+}
+
+// netifd can set a radio up again on the phy that replaced a gone one with no
+// teardown first (wifi reconf), and then sends no config_set for the old name.
+function iface_prune_gone(cur_name)
+{
+	for (let name in keys(hostapd.data.config)) {
+		let config = hostapd.data.config[name];
+		if (name == cur_name || !config?.phy ||
+		    access(`/sys/class/ieee80211/${config.phy}`))
+			continue;
+
+		delete hostapd.data.config[name];
+		iface_phy_gone(name);
+	}
+}
+
 // No fallback to a PHY restart, which would take the other BSSes down.
 function mld_link_bss_remove(phy, name)
 {
@@ -1264,6 +1291,8 @@ function iface_set_config(name, config)
 	let phydev = phy_open(phy, config.radio_idx);
 	if (!phydev) {
 		hostapd.printf(`Failed to open phy ${phy}`);
+		delete hostapd.data.config[name];
+		iface_phy_gone(name);
 		return false;
 	}
 
@@ -1932,6 +1961,8 @@ let main_obj = {
 			if (!phy)
 				return libubus.STATUS_INVALID_ARGUMENT;
 
+			iface_prune_gone(name);
+
 			if (prev_file && !hostapd.data.config[name]) {
 				let config = iface_load_config(phy, radio, prev_file);
 				if (config)
