diff --git a/package/kernel/mac80211/patches/ath11k/036-wifi-ath11k-avoid-IDR-mutation-during-pending-mgmt-T.patch b/package/kernel/mac80211/patches/ath11k/036-wifi-ath11k-avoid-IDR-mutation-during-pending-mgmt-T.patch
