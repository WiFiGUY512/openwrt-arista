diff --git a/package/kernel/mac80211/patches/ath11k/034-wifi-ath11k-fix-reg_info_store-leak-in-ath11k_servic.patch b/package/kernel/mac80211/patches/ath11k/034-wifi-ath11k-fix-reg_info_store-leak-in-ath11k_servic.patch
