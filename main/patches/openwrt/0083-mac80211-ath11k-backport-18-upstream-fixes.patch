diff --git a/package/kernel/mac80211/patches/ath11k/032-wifi-ath11k-cleanup-arsta-in-ath11k_mac_peer_cleanup.patch b/package/kernel/mac80211/patches/ath11k/032-wifi-ath11k-cleanup-arsta-in-ath11k_mac_peer_cleanup.patch
