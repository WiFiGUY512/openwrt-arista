diff --git a/package/system/procd/patches/100-jail-bind-the-ubus-directory-not-the-socket.patch b/package/system/procd/patches/100-jail-bind-the-ubus-directory-not-the-socket.patch
new file mode 100644
index 0000000000..5bb7363e88
--- /dev/null
+++ b/package/system/procd/patches/100-jail-bind-the-ubus-directory-not-the-socket.patch
@@ -0,0 +1,49 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Mon, 26 Oct 2026 22:00:00 -0500
+Subject: [PATCH] jail: bind the ubus directory, not the socket
+
+ujail -u bind-mounted /var/run/ubus/ubus.sock, the socket file. A
+restarted ubusd unlinks it and creates a new socket, but inside the jail
+the path stays on the old inode, so a jailed service (dnsmasq, ntpd)
+could never reach ubus again: every connect() was refused.
+
+Bind the directory instead, so the jail sees the socket ubusd creates.
+Bind it read-only: a jailed service must not be able to replace the
+socket that every other client connects to. connect() on a socket is
+not refused by a read-only mount.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+  jail/jail.c | 9 +++++++--
+  1 file changed, 7 insertions(+), 2 deletions(-)
+
+diff --git a/jail/jail.c b/jail/jail.c
+index 49aabe3..8818259 100644
+--- a/jail/jail.c
++++ b/jail/jail.c
+@@ -6664,7 +6664,12 @@ int main(int argc, char **argv)
+ {
+ 	uid_t uid = getuid();
+ 	const char log[] = "/dev/log";
+-	const char ubus[] = "/var/run/ubus/ubus.sock";
++	/*
++	 * The directory, not the socket: a restarted ubusd puts a new socket in
++	 * it, and a bind of the old socket would keep the jail on the dead one.
++	 * Read-only, so a jailed service cannot replace the socket for everyone.
++	 */
++	const char ubus[] = "/var/run/ubus";
+ 	const char udebug[] = "/var/run/udebug.sock";
+ 	int ret = EXIT_FAILURE;
+ 	int credidx;
+@@ -6825,7 +6830,7 @@ int main(int argc, char **argv)
+ 			break;
+ 		case 'u':
+ 			opts.namespace |= CLONE_NEWNS;
+-			add_mount_bind(ubus, 0, -1);
++			add_mount_bind(ubus, 1, -1);
+ 			break;
+ 		case 'D':
+ 			opts.namespace |= CLONE_NEWNS;
+-- 
+2.43.0
