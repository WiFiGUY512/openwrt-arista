diff --git a/package/network/ipv6/odhcp6c/patches/100-ubus-keep-the-context-and-reconnect-when-ubusd-drops-it.patch b/package/network/ipv6/odhcp6c/patches/100-ubus-keep-the-context-and-reconnect-when-ubusd-drops-it.patch
new file mode 100644
index 0000000000..cff52ce45a
--- /dev/null
+++ b/package/network/ipv6/odhcp6c/patches/100-ubus-keep-the-context-and-reconnect-when-ubusd-drops-it.patch
@@ -0,0 +1,134 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Mon, 26 Oct 2026 22:00:00 -0500
+Subject: [PATCH] ubus: keep the context and reconnect when ubusd drops it
+
+When ubusd went away, ubus_disconnect_cb() tried one reconnect at once,
+while ubusd was still down, and then freed the context. The main loop
+kept its own pointer to it and its socket in the poll set, so it polled
+a stale descriptor, and ubus_destroy() freed the context a second time
+when odhcp6c stopped. The odhcp6c.<interface> object never came back.
+
+Only note the loss in the callback. The main loop takes the socket to
+poll from ubus_poll_fd(), which reconnects at most once a second while
+the connection is lost (-1 until then, which poll() ignores), and wakes
+at least once a second meanwhile. ubus_reconnect() registers the object
+again.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+  src/odhcp6c.c | 10 +++++++++-
+  src/ubus.c    | 48 ++++++++++++++++++++++++++++++++++++++++--------
+  src/ubus.h    |  1 +
+  3 files changed, 50 insertions(+), 9 deletions(-)
+
+diff --git a/src/odhcp6c.c b/src/odhcp6c.c
+index d05a9ba..cf7d1ae 100644
+--- a/src/odhcp6c.c
++++ b/src/odhcp6c.c
+@@ -841,7 +841,15 @@ int main(_o_unused int argc, char* const argv[])
+ 		if (signal_usr2 || signal_term)
+ 			dhcpv6_set_state(DHCPV6_EXIT);
+ 
+-		poll_res = poll(fds, nfds, dhcpv6_get_state_timeout());
++		int timeout = dhcpv6_get_state_timeout();
++#ifdef WITH_UBUS
++		/* while ubusd is away, poll without it and wake to retry */
++		fds[UBUS_FD_INDEX].fd = ubus_poll_fd();
++		if (fds[UBUS_FD_INDEX].fd < 0 && timeout > 1000)
++			timeout = 1000;
++#endif /* WITH_UBUS */
++
++		poll_res = poll(fds, nfds, timeout);
+ 		dhcpv6_reset_state_timeout();
+ 		if (poll_res == -1 && (errno == EINTR || errno == EAGAIN)) {
+ 			continue;
+diff --git a/src/ubus.c b/src/ubus.c
+index 9d72944..21c7907 100644
+--- a/src/ubus.c
++++ b/src/ubus.c
+@@ -127,6 +127,7 @@ enum {
+ struct ubus_context *ubus = NULL;
+ static struct blob_buf b;
+ static char ubus_name[24];
++static bool ubus_lost;
+ 
+ static int ubus_handle_get_state(struct ubus_context *ctx, struct ubus_object *obj,
+ 		struct ubus_request_data *req, const char *method, struct blob_attr *msg);
+@@ -188,15 +189,46 @@ static struct ubus_object odhcp6c_object = {
+ 	.n_methods = ARRAY_SIZE(odhcp6c_object_methods),
+ };
+ 
+-static void ubus_disconnect_cb(struct ubus_context *ubus)
++/*
++ * ubusd went away (it was restarted).  The main loop connects again through
++ * ubus_poll_fd().  The context is not freed here: the main loop still holds
++ * it, and freeing it left the loop polling a stale descriptor and freeing the
++ * context a second time on exit.
++ */
++static void ubus_disconnect_cb(_o_unused struct ubus_context *ubus)
+ {
+-	int ret;
++	notice("Lost the connection to ubus");
++	ubus_lost = true;
++}
+ 
+-	ret = ubus_reconnect(ubus, NULL);
+-	if (ret) {
+-		error("Cannot reconnect to ubus: %s", ubus_strerror(ret));
+-		ubus_destroy(ubus);
+-	}
++/*
++ * The socket for the main loop to poll.  After the connection was lost, try
++ * again, at most once a second; -1 until ubusd is back.  ubus_reconnect()
++ * registers the object again.
++ */
++int ubus_poll_fd(void)
++{
++	static uint64_t last;
++	uint64_t now;
++
++	if (!ubus)
++		return -1;
++
++	if (!ubus_lost)
++		return ubus->sock.fd;
++
++	now = odhcp6c_get_milli_time();
++	if (now - last < 1000)
++		return -1;
++
++	last = now;
++	if (ubus_reconnect(ubus, NULL))
++		return -1;
++
++	ubus_lost = false;
++	notice("Reconnected to ubus");
++
++	return ubus->sock.fd;
+ }
+ 
+ char *ubus_init(const char* interface)
+@@ -989,7 +1021,7 @@ static int ubus_handle_release(_o_unused struct ubus_context *ctx, _o_unused str
+ 
+ int ubus_dhcp_event(const char *status)
+ {
+-	if (!ubus || !odhcp6c_object.has_subscribers)
++	if (!ubus || ubus_lost || !odhcp6c_object.has_subscribers)
+ 		return UBUS_STATUS_UNKNOWN_ERROR;
+ 
+ 	CHECK(states_to_blob());
+diff --git a/src/ubus.h b/src/ubus.h
+index 3c2ce97..01e48ce 100644
+--- a/src/ubus.h
++++ b/src/ubus.h
+@@ -68,6 +68,7 @@
+ 
+ char *ubus_init(const char* interface);
+ struct ubus_context *ubus_get_ctx(void);
++int ubus_poll_fd(void);
+ void ubus_destroy(struct ubus_context *ubus);
+ int ubus_dhcp_event(const char *status);
+ 
+-- 
+2.43.0
