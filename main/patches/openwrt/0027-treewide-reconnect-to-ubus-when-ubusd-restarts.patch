new file mode 100644
index 0000000000..7a2ffb16e2
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/300-ubus-reconnect-when-ubusd-goes-away.patch
@@ -0,0 +1,96 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Mon, 26 Oct 2026 22:00:00 -0500
+Subject: [PATCH] ubus: reconnect when ubusd goes away
+
+When ubusd went away, ubus_disconnect_cb() tried one reconnect at once,
+while ubusd was still down, then freed the context inside libubus'
+callback; check_ubus_listeners() then read the freed context. The main
+loop retries ubus_init() only when poll() happens to wake, which on a
+quiet system may be never.
+
+Only note the loss in the callback; check_ubus_listeners() drops the
+connection after ubus_handle_event() has returned. While there is no
+connection, wake every quarter second, as for the dbus, so the main
+loop's ubus_init() runs until ubusd is back. ubus_destroy() also resets
+the dnsmasq.dns object's IDs (200-ubus_dns.patch added it but not its
+reset): a stale type ID made the object come back without a type, or
+with another client's type.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+  src/dnsmasq.c |  7 +++++++
+  src/ubus.c    | 21 ++++++++++++---------
+  2 files changed, 19 insertions(+), 9 deletions(-)
+
+diff --git a/src/dnsmasq.c b/src/dnsmasq.c
+index 0e22668..6121468 100644
+--- a/src/dnsmasq.c
++++ b/src/dnsmasq.c
+@@ -1108,6 +1108,13 @@ int main (int argc, char **argv)
+       if ((daemon->tftp_trans || (option_bool(OPT_DBUS) && !daemon->dbus)) &&
+ 	  (timeout == -1 || timeout > 250))
+ 	timeout = 250;
++
++#ifdef HAVE_UBUS
++      /* Whilst reconnecting to the ubus, likewise: nothing else may wake us */
++      else if (option_bool(OPT_UBUS) && !daemon->ubus &&
++	       (timeout == -1 || timeout > 250))
++	timeout = 250;
++#endif
+       
+       /* Wake every second whilst waiting for DAD to complete */
+       else if (is_dad_listeners() &&
+diff --git a/src/ubus.c b/src/ubus.c
+index 7dba879..ce8ef19 100644
+--- a/src/ubus.c
++++ b/src/ubus.c
+@@ -22,6 +22,7 @@
+ 
+ static struct blob_buf b;
+ static int error_logged = 0;
++static int ubus_lost = 0;
+ 
+ static int ubus_handle_metrics(struct ubus_context *ctx, struct ubus_object *obj,
+ 			       struct ubus_request_data *req, const char *method,
+@@ -94,19 +95,21 @@ static void ubus_destroy(struct ubus_context *ubus)
+   /* Forces re-initialization when we're reusing the same definitions later on. */
+   ubus_object.id = 0;
+   ubus_object_type.id = 0;
++  ubus_dns_object.id = 0;
++  ubus_dns_object_type.id = 0;
++  ubus_lost = 0;
+ }
+ 
++/* ubusd went away (it was restarted).  Only note it here: freeing the
++   context inside libubus' callback left check_ubus_listeners() reading it
++   afterwards.  check_ubus_listeners() drops the connection, and the main
++   loop connects again with ubus_init(), every quarter second until ubusd
++   is back. */
+ static void ubus_disconnect_cb(struct ubus_context *ubus)
+ {
+-  int ret;
++  (void)ubus;
+ 
+-  ret = ubus_reconnect(ubus, NULL);
+-  if (ret)
+-    {
+-      my_syslog(LOG_ERR, _("Cannot reconnect to UBus: %s"), ubus_strerror(ret));
+-
+-      ubus_destroy(ubus);
+-    }
++  ubus_lost = 1;
+ }
+ 
+ char *ubus_init()
+@@ -178,7 +181,7 @@ void check_ubus_listeners()
+   if (poll_check(ubus->sock.fd, POLLIN))
+     ubus_handle_event(ubus);
+   
+-  if (poll_check(ubus->sock.fd, POLLHUP | POLLERR))
++  if (ubus_lost || poll_check(ubus->sock.fd, POLLHUP | POLLERR))
+     {
+       my_syslog(LOG_INFO, _("Disconnecting from UBus"));
+ 
+-- 
+2.43.0
