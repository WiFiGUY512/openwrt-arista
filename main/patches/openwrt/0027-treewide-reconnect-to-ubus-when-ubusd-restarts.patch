new file mode 100644
index 0000000000..75bd44c586
--- /dev/null
+++ b/package/system/rpcd/patches/100-main-reconnect-when-ubusd-drops-the-connection.patch
@@ -0,0 +1,84 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Mon, 26 Oct 2026 22:00:00 -0500
+Subject: [PATCH] main: reconnect when ubusd drops the connection
+
+rpcd connects once and keeps libubus' default connection_lost, which
+does nothing once uloop has dropped the hung-up socket. After a ubusd
+restart rpcd ran on with no session, uci, file, rc or plugin objects,
+so LuCI stopped working, and procd never respawned it because nothing
+exited.
+
+Connect again once a second, as ubus_auto_connect() does, until ubusd
+is back. ubus_reconnect() registers every object again; rpcd keeps no
+object IDs and no event registrations, so nothing else needs renewing.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+  main.c | 30 +++++++++++++++++++++++++++++-
+  1 file changed, 29 insertions(+), 1 deletion(-)
+
+diff --git a/main.c b/main.c
+index 824ab4a..059b179 100644
+--- a/main.c
++++ b/main.c
+@@ -32,6 +32,7 @@
+ #include <rpcd/uci.h>
+ 
+ static struct ubus_context *ctx;
++static const char *ubus_socket = NULL;
+ static bool respawn = false;
+ 
+ int rpc_exec_timeout = RPC_EXEC_DEFAULT_TIMEOUT;
+@@ -44,6 +45,33 @@ handle_signal(int sig)
+ 	respawn = (sig == SIGHUP);
+ }
+ 
++static void
++rpc_ubus_reconnect(struct uloop_timeout *t)
++{
++	if (ubus_reconnect(ctx, ubus_socket)) {
++		uloop_timeout_set(t, 1000);
++		return;
++	}
++
++	ubus_add_uloop(ctx);
++}
++
++static struct uloop_timeout reconnect_timer = {
++	.cb = rpc_ubus_reconnect,
++};
++
++/*
++ * ubusd went away (it was restarted): connect again, once a second until it
++ * is back.  ubus_reconnect() registers every object again.  libubus' default
++ * handler does nothing once uloop has dropped the hung-up socket, so rpcd
++ * would otherwise run on with no objects, and LuCI with no session or uci.
++ */
++static void
++rpc_ubus_connection_lost(struct ubus_context *c)
++{
++	uloop_timeout_set(&reconnect_timer, 1000);
++}
++
+ static void
+ exec_self(int argc, char **argv)
+ {
+@@ -70,7 +98,6 @@ int main(int argc, char **argv)
+ {
+ 	struct stat s;
+ 	const char *hangup;
+-	const char *ubus_socket = NULL;
+ 	int ch;
+ 
+ 	while ((ch = getopt(argc, argv, "s:t:")) != -1) {
+@@ -112,6 +139,7 @@ int main(int argc, char **argv)
+ 		return -1;
+ 	}
+ 
++	ctx->connection_lost = rpc_ubus_connection_lost;
+ 	ubus_add_uloop(ctx);
+ 
+ 	rpc_session_api_init(ctx);
+-- 
+2.43.0
-- 
