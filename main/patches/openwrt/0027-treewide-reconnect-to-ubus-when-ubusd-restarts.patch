diff --git a/package/network/services/odhcpd/patches/100-ubus-reconnect-when-ubusd-drops-the-connection.patch b/package/network/services/odhcpd/patches/100-ubus-reconnect-when-ubusd-drops-the-connection.patch
new file mode 100644
index 0000000000..b5f6047344
--- /dev/null
+++ b/package/network/services/odhcpd/patches/100-ubus-reconnect-when-ubusd-drops-the-connection.patch
@@ -0,0 +1,71 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Mon, 26 Oct 2026 22:00:00 -0500
+Subject: [PATCH] ubus: reconnect when ubusd drops the connection
+
+odhcpd connects once (retrying only at startup) and keeps libubus'
+default connection_lost, which does nothing once uloop has dropped the
+hung-up socket. After a ubusd restart the dhcp object was gone for good
+and odhcpd no longer heard about netifd's interfaces.
+
+Connect again once a second until ubusd is back. ubus_reconnect()
+registers the dhcp object and the netifd subscriber again; renew the
+ubus.object.add event registration and the network.interface
+subscription, whose object has a new ID. If netifd is not back yet, the
+event brings it as at startup.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+  src/ubus.c | 30 ++++++++++++++++++++++++++++++
+  1 file changed, 30 insertions(+)
+
+diff --git a/src/ubus.c b/src/ubus.c
+index d6b3c0a..a1bec11 100644
+--- a/src/ubus.c
++++ b/src/ubus.c
+@@ -444,6 +444,34 @@ static void handle_event(_o_unused struct ubus_context *ctx,
+ static struct ubus_event_handler event_handler = { .cb = handle_event };
+ 
+ 
++static void reconnect(struct uloop_timeout *t)
++{
++	if (ubus_reconnect(ubus, NULL)) {
++		uloop_timeout_set(t, 1000);
++		return;
++	}
++
++	/* ubus_reconnect() has added the dhcp object and the netifd subscriber
++	 * again; the event pattern and the subscription are ours to renew, and
++	 * network.interface has a new ID (if netifd is not back yet, the
++	 * ubus.object.add event brings it) */
++	ubus_add_uloop(ubus);
++	ubus_register_event_handler(ubus, &event_handler, "ubus.object.add");
++	if (!ubus_lookup_id(ubus, "network.interface", &objid))
++		update_netifd(true);
++}
++
++static struct uloop_timeout reconnect_timer = { .cb = reconnect };
++
++/* ubusd went away (it was restarted): connect again, once a second until it
++ * is back.  libubus' default handler does nothing once uloop has dropped the
++ * hung-up socket, which left odhcpd off ubus for good. */
++static void handle_connection_lost(_o_unused struct ubus_context *ctx)
++{
++	uloop_timeout_set(&reconnect_timer, 1000);
++}
++
++
+ const char* ubus_get_ifname(const char *name)
+ {
+ 	struct blob_attr *c;
+@@ -510,6 +538,8 @@ int ubus_init(void)
+ 		return -1;
+ 	}
+ 
++	ubus->connection_lost = handle_connection_lost;
++
+ 	netifd.cb = handle_update;
+ 	ubus_register_subscriber(ubus, &netifd);
+ 
+-- 
+2.43.0
