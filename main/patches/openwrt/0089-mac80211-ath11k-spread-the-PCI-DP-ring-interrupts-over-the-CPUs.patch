From 20a7447558b1afee02a73d03bd4a3dc1bac3db0b Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Thu, 5 Nov 2026 09:45:43 -0600
Subject: [PATCH] mac80211: ath11k: spread the PCI DP ring interrupts over the
 CPUs

From openwrt/openwrt#26253 (Julius Bairaktaris, draft): ath11k on PCI
leaves every DP ring interrupt on CPU0 (QCN9074/QCN9072: 8 multi-MSI
vectors, all counted on CPU0 on the C-360s and the W-318), so the
REO ring spread is lost. The patch places each REO destination ring
and TX completion ring interrupt on its own CPU.

Tested on the W-318 QCN9072 (6 GHz AP, ch 5 HE160, a QCN9074 station
uploading to a wired host, 4 runs per arm): the rings land on CPUs
0-3 as designed, and AP receive went from ~865 to ~1093 Mbit/s (+26%,
every run); download unchanged. Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/kernel/mac80211/Makefile              |  2 +-
 ...PCI-DP-ring-interrupts-over-the-CPUs.patch | 75 +++++++++++++++++++
 2 files changed, 76 insertions(+), 1 deletion(-)
 create mode 100644 package/kernel/mac80211/patches/ath11k/959-wifi-ath11k-spread-the-PCI-DP-ring-interrupts-over-the-CPUs.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index 1465dc8..65d092d 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
 
 PKG_SOURCE_VERSION:=7.2
 PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
-PKG_RELEASE:=30
+PKG_RELEASE:=31
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
diff --git a/package/kernel/mac80211/patches/ath11k/959-wifi-ath11k-spread-the-PCI-DP-ring-interrupts-over-the-CPUs.patch b/package/kernel/mac80211/patches/ath11k/959-wifi-ath11k-spread-the-PCI-DP-ring-interrupts-over-the-CPUs.patch
new file mode 100644
index 0000000..5878671
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/959-wifi-ath11k-spread-the-PCI-DP-ring-interrupts-over-the-CPUs.patch
@@ -0,0 +1,75 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Wed, 28 Oct 2026 08:41:26 +0100
+Subject: [PATCH] wifi: ath11k: spread the PCI DP ring interrupts over the CPUs
+
+ath11k on PCI gives each DP interrupt group its own MSI vector when the
+device grants the full set (8 DP vectors on QCN9074, 18 on WCN6855 and
+QCA6390 in ath11k_msi_config[]), but leaves their affinity at the
+default. Every REO destination ring and TX completion ring interrupt
+then runs on the same CPU, and the spread the hardware gives received
+frames over the four REO rings is lost before the stack sees them.
+
+Place each REO destination ring interrupt on its own CPU and each TX
+completion ring interrupt on the CPU after its ring number. Only groups
+with a vector of their own are placed; with a single shared MSI vector
+nothing changes. The affinity hint is cleared before the interrupt is
+freed.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/drivers/net/wireless/ath/ath11k/pcic.c
++++ b/drivers/net/wireless/ath/ath11k/pcic.c
+@@ -333,8 +333,12 @@ static void ath11k_pcic_free_ext_irq(str
+ 	for (i = 0; i < ATH11K_EXT_IRQ_GRP_NUM_MAX; i++) {
+ 		struct ath11k_ext_irq_grp *irq_grp = &ab->ext_irq_grp[i];
+ 
+-		for (j = 0; j < irq_grp->num_irq; j++)
+-			free_irq(ab->irq_num[irq_grp->irqs[j]], irq_grp);
++		for (j = 0; j < irq_grp->num_irq; j++) {
++			int irq = ab->irq_num[irq_grp->irqs[j]];
++
++			irq_update_affinity_hint(irq, NULL);
++			free_irq(irq, irq_grp);
++		}
+ 
+ 		netif_napi_del(&irq_grp->napi);
+ 		free_netdev(irq_grp->napi_ndev);
+@@ -578,6 +582,27 @@ ath11k_pcic_get_msi_irq(struct ath11k_ba
+ 	return ab->pci.ops->get_msi_irq(ab, vector);
+ }
+ 
++static void ath11k_pcic_ext_irq_set_affinity(struct ath11k_base *ab,
++					     int grp_id, int irq)
++{
++	const struct ath11k_hw_ring_mask *ring_mask = ab->hw_params.ring_mask;
++	unsigned int cpu;
++
++	/* Put each REO destination ring, over which the hardware hashes
++	 * the received frames, on its own CPU, and each TX completion ring
++	 * on the CPU after its number.
++	 */
++	if (ring_mask->rx[grp_id])
++		cpu = __ffs(ring_mask->rx[grp_id]);
++	else if (ring_mask->tx[grp_id])
++		cpu = __ffs(ring_mask->tx[grp_id]) + 1;
++	else
++		return;
++
++	cpu = cpumask_local_spread(cpu, dev_to_node(ab->dev));
++	irq_set_affinity_and_hint(irq, cpumask_of(cpu));
++}
++
+ static int ath11k_pcic_ext_irq_config(struct ath11k_base *ab)
+ {
+ 	int i, j, n, ret, num_vectors = 0;
+@@ -651,6 +676,10 @@ static int ath11k_pcic_ext_irq_config(st
+ 				}
+ 				return ret;
+ 			}
++
++			if (test_bit(ATH11K_FLAG_MULTI_MSI_VECTORS,
++				     &ab->dev_flags) && i < num_vectors)
++				ath11k_pcic_ext_irq_set_affinity(ab, i, irq);
+ 		}
+ 		ath11k_pcic_ext_grp_disable(irq_grp);
+ 	}
-- 
