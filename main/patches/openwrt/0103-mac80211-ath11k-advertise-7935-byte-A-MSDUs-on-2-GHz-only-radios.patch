From 8f396426d7ed0075061e3a95282f3ae11a729479 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sat, 7 Nov 2026 00:33:34 -0600
Subject: [PATCH] mac80211: ath11k: advertise 7935-byte A-MSDUs on 2 GHz-only
 radios

B160: every 2 GHz-only ath11k radio (C-360, C-260, W-318, C-200) said
HT max A-MSDU 3839 (cap 0x11e7) while every 5 GHz radio and the 2 GHz
band of a dual-band pdev said 7935: ath11k takes the HT max A-MSDU bit
from the pdev's VHT capabilities, which it fills from the 5 GHz ones
only. The firmware reports 2 GHz VHT capabilities too (IPQ6018:
0x73997992, max MPDU 11454); take the bit from them on a pdev without
5 GHz. Tested on a W-318: 0x11e7 -> 0x19e7, its beacons say 7935.
Going upstream. Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/kernel/mac80211/Makefile              |   2 +-
 ...35-byte-A-MSDUs-on-2-GHz-only-radios.patch | 104 ++++++++++++++++++
 2 files changed, 105 insertions(+), 1 deletion(-)
 create mode 100644 package/kernel/mac80211/patches/ath11k/981-wifi-ath11k-advertise-7935-byte-A-MSDUs-on-2-GHz-only-radios.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index 1b54db9..1618383 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
 
 PKG_SOURCE_VERSION:=7.2
 PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
-PKG_RELEASE:=35
+PKG_RELEASE:=36
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
diff --git a/package/kernel/mac80211/patches/ath11k/981-wifi-ath11k-advertise-7935-byte-A-MSDUs-on-2-GHz-only-radios.patch b/package/kernel/mac80211/patches/ath11k/981-wifi-ath11k-advertise-7935-byte-A-MSDUs-on-2-GHz-only-radios.patch
new file mode 100644
index 0000000..821e02f
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/981-wifi-ath11k-advertise-7935-byte-A-MSDUs-on-2-GHz-only-radios.patch
@@ -0,0 +1,104 @@
+From 2efef4aa1d1f5cf08a9978802b8b432055bdb364 Mon Sep 17 00:00:00 2001
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Sat, 7 Nov 2026 00:28:06 -0600
+Subject: [PATCH] wifi: ath11k: advertise 7935-byte A-MSDUs on 2 GHz-only
+ radios
+
+ath11k_create_ht_cap() sets IEEE80211_HT_CAP_MAX_AMSDU when the pdev's
+VHT capabilities allow an MPDU longer than 3895 bytes. ath11k fills the
+pdev's VHT capabilities from vht_cap_info_5g only, so on a pdev without
+5 GHz they are zero and its 2 GHz band advertises a maximum A-MSDU of
+3839 bytes. The 2 GHz band of a dual-band pdev and every 5 GHz radio
+advertise 7935 bytes with the same MAC.
+
+The firmware reports VHT capabilities for 2 GHz too, in
+vht_cap_info_2g. On IPQ6018 the 2 GHz pdev reports 0x73997992, a
+maximum MPDU length of 11454 bytes, and the 5 GHz pdev 0x7399f9b2.
+
+Keep the 2 GHz VHT capabilities with the band's other capabilities, and
+take the max A-MSDU bit from them when the pdev has no VHT capabilities
+of its own. Pdevs with 5 GHz are unchanged.
+
+On IPQ6018 the 2 GHz radio's HT capabilities change from 0x11e7 to
+0x19e7, and hostapd adds [MAX-AMSDU-7935] to its ht_capab. Its beacons,
+read by another AP, advertise a maximum A-MSDU length of 7935 bytes,
+where the 2 GHz-only radio of an IPQ8074 AP without the change
+advertises 3839. Beaconing and channel switches on both radios work as
+before.
+
+Tested-on: IPQ6018 hw1.0 AHB WLAN.HK.2.5.0.1-03982-QCAHKSWPL_SILICONZ-3
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+ drivers/net/wireless/ath/ath11k/core.h |  1 +
+ drivers/net/wireless/ath/ath11k/mac.c  | 14 +++++++++-----
+ drivers/net/wireless/ath/ath11k/wmi.c  |  1 +
+ 3 files changed, 11 insertions(+), 5 deletions(-)
+
+--- a/drivers/net/wireless/ath/ath11k/core.h
++++ b/drivers/net/wireless/ath/ath11k/core.h
+@@ -831,6 +831,7 @@ struct ath11k_band_cap {
+ 	u32 phy_id;
+ 	u32 max_bw_supported;
+ 	u32 ht_cap_info;
++	u32 vht_cap_info;
+ 	u32 he_cap_info[2];
+ 	u32 he_mcs;
+ 	u32 he_cap_phy_info[PSOC_HOST_MAX_PHY_SIZE];
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -5559,11 +5559,10 @@ exit:
+ }
+ 
+ static struct ieee80211_sta_ht_cap
+-ath11k_create_ht_cap(struct ath11k *ar, u32 ar_ht_cap)
++ath11k_create_ht_cap(struct ath11k *ar, u32 ar_ht_cap, u32 ar_vht_cap)
+ {
+ 	int i;
+ 	struct ieee80211_sta_ht_cap ht_cap = {};
+-	u32 ar_vht_cap = ar->pdev->cap.vht_cap;
+ 
+ 	if (!(ar_ht_cap & WMI_HT_CAP_ENABLED))
+ 		return ht_cap;
+@@ -5768,14 +5767,19 @@ static void ath11k_mac_setup_ht_vht_cap(
+ 					u32 *ht_cap_info)
+ {
+ 	struct ieee80211_supported_band *band;
+-	u32 ht_cap;
++	u32 ht_cap, vht_cap;
+ 
+ 	if (cap->supported_bands & WMI_HOST_WLAN_2G_CAP) {
+ 		band = &ar->mac.sbands[NL80211_BAND_2GHZ];
+ 		ht_cap = cap->band[NL80211_BAND_2GHZ].ht_cap_info;
+ 		if (ht_cap_info)
+ 			*ht_cap_info = ht_cap;
+-		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap);
++		/* A pdev without 5 GHz has no VHT capabilities of its own, but
++		 * the firmware reports them for 2 GHz too: use those for the
++		 * max A-MSDU length.
++		 */
++		vht_cap = cap->vht_cap ?: cap->band[NL80211_BAND_2GHZ].vht_cap_info;
++		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap, vht_cap);
+ 	}
+ 
+ 	/* A 6 GHz capable radio may cover 5 GHz as well, as a QCN9074 does:
+@@ -5788,7 +5792,7 @@ static void ath11k_mac_setup_ht_vht_cap(
+ 		ht_cap = cap->band[NL80211_BAND_5GHZ].ht_cap_info;
+ 		if (ht_cap_info)
+ 			*ht_cap_info = ht_cap;
+-		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap);
++		band->ht_cap = ath11k_create_ht_cap(ar, ht_cap, cap->vht_cap);
+ 		band->vht_cap = ath11k_create_vht_cap(ar);
+ 	}
+ }
+--- a/drivers/net/wireless/ath/ath11k/wmi.c
++++ b/drivers/net/wireless/ath/ath11k/wmi.c
+@@ -454,6 +454,7 @@ ath11k_pull_mac_phy_cap_svc_ready_ext(st
+ 		cap_band->phy_id = mac_phy_caps->phy_id;
+ 		cap_band->max_bw_supported = mac_phy_caps->max_bw_supported_2g;
+ 		cap_band->ht_cap_info = mac_phy_caps->ht_cap_info_2g;
++		cap_band->vht_cap_info = mac_phy_caps->vht_cap_info_2g;
+ 		cap_band->he_cap_info[0] = mac_phy_caps->he_cap_info_2g;
+ 		cap_band->he_cap_info[1] = mac_phy_caps->he_cap_info_2g_ext;
+ 		cap_band->he_mcs = mac_phy_caps->he_supp_mcs_2g;
