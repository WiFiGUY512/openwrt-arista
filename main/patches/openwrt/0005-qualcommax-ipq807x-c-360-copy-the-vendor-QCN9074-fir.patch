From 6c13048e2658fdd1313d5d14586ecbc97580e710 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Fri, 16 Oct 2026 11:51:59 -0500
Subject: [PATCH 05/18] qualcommax: ipq807x: c-360: copy the vendor QCN9074
 firmware

The C-360's QCN9074 and QCN9072 cards start only with Arista's own build
of the QCN9074 firmware (WLAN.HK.2.5.r4). With every public
ath11k-firmware build tested, 2.5.0.1 to 2.9.0.1, the firmware stops
answering at the QMI capability request. That build cannot be shipped,
but every C-360 carries it in the Arista system kept in its second NAND
slot.

When ath11k asks for a QCN9074 amss.bin or m3.bin that is missing, copy
both, unmodified, from that system, as the caldata hotplug scripts do
for calibration data. The slot is attached read-only. Arista's squashfs
stores xz compressor options the kernel rejects, so unsquashfs reads
it. Without the Arista system both cards stay down.

ath11k-firmware-qcn9074 is no longer installed, since its files would
be used instead.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 target/linux/qualcommax/image/ipq807x.mk      |  5 +-
 .../firmware/12-ath11k-vendor-firmware        | 59 +++++++++++++++++++
 2 files changed, 62 insertions(+), 2 deletions(-)
 create mode 100644 target/linux/qualcommax/ipq807x/base-files/etc/hotplug.d/firmware/12-ath11k-vendor-firmware

diff --git a/target/linux/qualcommax/image/ipq807x.mk b/target/linux/qualcommax/image/ipq807x.mk
index 2100ed47..5e139921 100644
--- a/target/linux/qualcommax/image/ipq807x.mk
+++ b/target/linux/qualcommax/image/ipq807x.mk
@@ -89,8 +89,9 @@ define Device/arista_c-360
 	PAGESIZE := 4096
 	DEVICE_DTS_CONFIG := config@hk09
 	SOC := ipq8074
-	DEVICE_PACKAGES := ipq-wifi-arista_c-360 kmod-ath11k-pci ath11k-firmware-qcn9074 \
-		kmod-spi-gpio kmod-gpio-nxp-74hc164 kmod-tpm-tis-spi bluetooth-uart
+	DEVICE_PACKAGES := ipq-wifi-arista_c-360 kmod-ath11k-pci \
+		kmod-spi-gpio kmod-gpio-nxp-74hc164 kmod-tpm-tis-spi bluetooth-uart \
+		ubi-utils squashfs-tools-unsquashfs
 endef
 TARGET_DEVICES += arista_c-360
 
diff --git a/target/linux/qualcommax/ipq807x/base-files/etc/hotplug.d/firmware/12-ath11k-vendor-firmware b/target/linux/qualcommax/ipq807x/base-files/etc/hotplug.d/firmware/12-ath11k-vendor-firmware
new file mode 100644
index 00000000..bd2b1718
--- /dev/null
+++ b/target/linux/qualcommax/ipq807x/base-files/etc/hotplug.d/firmware/12-ath11k-vendor-firmware
@@ -0,0 +1,59 @@
+#!/bin/sh
+#
+# Some boards' ath11k cards start only with their vendor's own build of the
+# firmware, which OpenWrt cannot ship. Each such board still carries it, in
+# the vendor system on its own flash. When the driver first asks for a file
+# that is missing, copy it from there, unmodified.
+
+[ -e /lib/firmware/$FIRMWARE ] && exit 0
+
+. /lib/functions.sh
+
+# vendor_firmware_extract PART VOLUME SRC FILE...: the FILEs, from the
+# directory SRC of the squashfs in UBI volume VOLUME of mtd partition PART,
+# into the directory of $FIRMWARE
+vendor_firmware_extract() {
+	local part=$1 volume=$2 src=$3 mtd ubi v vol node tmp f
+	shift 3
+
+	mtd=$(find_mtd_index "$part")
+	[ -n "$mtd" ] || return 1
+	ubi=$(ubiattach -m "$mtd" 2>/dev/null | \
+		sed -n 's/.*UBI device number \([0-9]*\).*/\1/p')
+	[ -n "$ubi" ] || return 1
+
+	for v in /sys/class/ubi/ubi${ubi}_*; do
+		[ "$(cat "$v/name" 2>/dev/null)" = "$volume" ] && vol=${v##*/}
+	done
+	if [ -n "$vol" ]; then
+		# the node's own hotplug event waits behind this one
+		node=/dev/$vol
+		[ -c "$node" ] || mknod "$node" c $(sed 's/:/ /' /sys/class/ubi/$vol/dev)
+		tmp=$(mktemp -d)
+		unsquashfs -n -d "$tmp" "$node" \
+			$(for f in "$@"; do echo "$src/$f"; done) > /dev/null 2>&1
+		mkdir -p "/lib/firmware/${FIRMWARE%/*}"
+		for f in "$@"; do
+			[ -s "$tmp/$src/$f" ] && cp "$tmp/$src/$f" "/lib/firmware/${FIRMWARE%/*}/$f"
+		done
+		rm -rf "$tmp"
+	fi
+	ubidetach -d "$ubi" > /dev/null 2>&1
+	[ -s "/lib/firmware/$FIRMWARE" ]
+}
+
+board=$(board_name)
+
+case "$FIRMWARE" in
+"ath11k/QCN9074/hw1.0/amss.bin"|\
+"ath11k/QCN9074/hw1.0/m3.bin")
+	case "$board" in
+	arista,c-360)
+		# Arista's build of WLAN.HK.2.5.r4, in its system in NAND slot 1
+		vendor_firmware_extract rootfs_1 ubi_rootfs \
+			lib/firmware/IPQ8074/WIFI_FW/qcn9000 amss.bin m3.bin ||
+			logger -t ath11k-vendor-firmware "no $FIRMWARE in the Arista system"
+		;;
+	esac
+	;;
+esac
