From a9ce0ad01f2a720d511d6d79edb5a5d00cb28309 Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Fri, 6 Nov 2026 15:14:26 -0600
Subject: [PATCH] hostapd: add [VHT160] for a channel switch to 160 MHz

The wifi scripts leave [VHT160] out of vht_capab when a radio is set up
narrower than 160 MHz (openwrt#22436; with it, some clients' uplink
suffered at 80 MHz, openwrt#22435). hostapd checks the configured
vht_capab for a channel switch, so a radio started at 40 or 80 MHz could
never be widened to 160 MHz by CSA (ubus switch_chan, CHAN_SWITCH):
"160 MHz channel width is not supported!".

Patch 895: hostapd_switch_channel() adds [VHT160] (and [SHORT-GI-160]
where the hardware has it) for a switch to 160 MHz, and takes it out
again on a later switch below 160 MHz or when the switch fails, so
nothing advertises 160 MHz support while the radio runs narrower. ubus
switch_chan checks the new chandef against the hardware's 160 MHz bit,
and get_features answers "csa160": true.

Tested on an Arista C-360 (Garage, ipq807x), stock wifi config (HE40, no
vht160): with a DFS pre-check of 52-64 on the scan radio, switch_chan to
36-64 @160 succeeded (rc 0) and the beacon advertised "Supported Channel
Width: 160 MHz"; a switch back to 36/40 removed it ("neither 160 nor
80+80"). Without the patch the same switch is refused.

Replaces port 0101 (kept a configured vht160 below 160), which brought
back the openwrt#22435 regression for radios set to widen later.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/network/services/hostapd/Makefile     |   2 +-
 ...T160-for-a-channel-switch-to-160-MHz.patch | 118 ++++++++++++++++++
 .../services/hostapd/src/src/ap/ubus.c        |  14 ++-
 3 files changed, 132 insertions(+), 2 deletions(-)
 create mode 100644 package/network/services/hostapd/patches/895-hostapd-add-VHT160-for-a-channel-switch-to-160-MHz.patch

diff --git a/package/network/services/hostapd/Makefile b/package/network/services/hostapd/Makefile
index 7fe56107e7..608ccdfbe8 100644
--- a/package/network/services/hostapd/Makefile
+++ b/package/network/services/hostapd/Makefile
@@ -5,7 +5,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=hostapd
-PKG_RELEASE:=16
+PKG_RELEASE:=17
 
 PKG_SOURCE_URL:=https://w1.fi/hostap.git
 PKG_SOURCE_PROTO:=git
diff --git a/package/network/services/hostapd/patches/895-hostapd-add-VHT160-for-a-channel-switch-to-160-MHz.patch b/package/network/services/hostapd/patches/895-hostapd-add-VHT160-for-a-channel-switch-to-160-MHz.patch
new file mode 100644
index 0000000000..7f5e66f2a9
--- /dev/null
+++ b/package/network/services/hostapd/patches/895-hostapd-add-VHT160-for-a-channel-switch-to-160-MHz.patch
@@ -0,0 +1,118 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Subject: [PATCH] hostapd: add [VHT160] for a channel switch to 160 MHz
+
+OpenWrt's wifi scripts leave [VHT160] and [SHORT-GI-160] out of vht_capab
+when a radio is set up narrower than 160 MHz (openwrt#22436): advertised at
+80 MHz they slowed some clients' uplink (openwrt#22435). But
+hostapd_set_freq_params() checks the configured vht_capab, so every channel
+switch to 160 MHz on such a radio (ubus switch_chan, CHAN_SWITCH) fails with
+"160 MHz channel width is not supported!".
+
+Add them to the running configuration for a switch to 160 MHz when the
+hardware has them, and take them out again on a later switch below 160 MHz
+or when the switch fails, so nothing advertises 160 MHz support while the
+radio runs narrower.
+
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+--- a/src/ap/hostapd.c
++++ b/src/ap/hostapd.c
+@@ -6155,19 +6155,65 @@ void hostapd_chan_switch_config(struct h
+ }
+ 
+ 
++/*
++ * OpenWrt's wifi scripts leave [VHT160] and [SHORT-GI-160] out of the configured
++ * vht_capab when the radio is set up narrower than 160 MHz: advertised at 80 MHz
++ * they slowed some clients' uplink (openwrt#22435). hostapd then refuses any
++ * channel switch to 160 MHz, which checks the configured vht_capab. Add them for
++ * a switch to 160 MHz when the hardware has them, and take them out again on a
++ * later switch below 160 MHz, or when this switch fails.
++ */
++static bool hostapd_csa_vht160(struct hostapd_iface *iface,
++			       const struct csa_settings *settings)
++{
++	struct hostapd_config *conf = iface->conf;
++	struct hostapd_hw_modes *mode = iface->current_mode;
++	u32 hw_width;
++
++	if (!mode || !conf->ieee80211ac)
++		return false;
++
++	if (settings->freq_params.bandwidth != 160 ||
++	    settings->freq_params.center_freq2) {
++		if (iface->csa_vht160_added) {
++			conf->vht_capab &= ~(VHT_CAP_SUPP_CHAN_WIDTH_160MHZ |
++					     VHT_CAP_SHORT_GI_160);
++			iface->csa_vht160_added = false;
++			wpa_printf(MSG_DEBUG,
++				   "CSA: [VHT160] taken out again below 160 MHz");
++		}
++		return false;
++	}
++
++	hw_width = mode->vht_capab & VHT_CAP_SUPP_CHAN_WIDTH_MASK;
++	if (!hw_width || (conf->vht_capab & VHT_CAP_SUPP_CHAN_WIDTH_MASK))
++		return false;
++
++	conf->vht_capab |= VHT_CAP_SUPP_CHAN_WIDTH_160MHZ;
++	if (mode->vht_capab & VHT_CAP_SHORT_GI_160)
++		conf->vht_capab |= VHT_CAP_SHORT_GI_160;
++	iface->csa_vht160_added = true;
++	wpa_printf(MSG_DEBUG, "CSA: [VHT160] added for a switch to 160 MHz");
++	return true;
++}
++
++
+ int hostapd_switch_channel(struct hostapd_data *hapd,
+ 			   struct csa_settings *settings)
+ {
+ 	int ret;
++	bool vht160_now;
+ 
+ 	if (!(hapd->iface->drv_flags & WPA_DRIVER_FLAGS_AP_CSA)) {
+ 		wpa_printf(MSG_INFO, "CSA is not supported");
+ 		return -1;
+ 	}
+ 
++	vht160_now = hostapd_csa_vht160(hapd->iface, settings);
++
+ 	ret = hostapd_fill_csa_settings(hapd, settings);
+ 	if (ret)
+-		return ret;
++		goto undo_vht160;
+ 
+ 	ret = hostapd_drv_switch_channel(hapd, settings);
+ 	free_beacon_data(&settings->beacon_csa);
+@@ -6179,11 +6225,19 @@ int hostapd_switch_channel(struct hostap
+ 	if (ret) {
+ 		/* if we failed, clean cs parameters */
+ 		hostapd_cleanup_cs_params(hapd);
+-		return ret;
++		goto undo_vht160;
+ 	}
+ 
+ 	hapd->csa_in_progress = 1;
+ 	return 0;
++
++undo_vht160:
++	if (vht160_now) {
++		hapd->iface->conf->vht_capab &= ~(VHT_CAP_SUPP_CHAN_WIDTH_160MHZ |
++						  VHT_CAP_SHORT_GI_160);
++		hapd->iface->csa_vht160_added = false;
++	}
++	return ret;
+ }
+ 
+ 
+--- a/src/ap/hostapd.h
++++ b/src/ap/hostapd.h
+@@ -639,6 +639,8 @@ struct hostapd_mld {
+  */
+ struct hostapd_iface {
+ 	struct hapd_interfaces *interfaces;
++	/* [VHT160] was added to conf->vht_capab for a channel switch to 160 MHz */
++	bool csa_vht160_added;
+ 	struct hostapd_ucode_iface ucode;
+ 	void *owner;
+ 	char *config_fname;
diff --git a/package/network/services/hostapd/src/src/ap/ubus.c b/package/network/services/hostapd/src/src/ap/ubus.c
index 72d92027d8..d873d37f4d 100644
--- a/package/network/services/hostapd/src/src/ap/ubus.c
+++ b/package/network/services/hostapd/src/src/ap/ubus.c
@@ -525,6 +525,9 @@ hostapd_bss_get_features(struct ubus_context *ctx, struct ubus_object *obj,
 	blob_buf_init(&b, 0);
 	blobmsg_add_u8(&b, "ht_supported", ht_supported(hapd->iface->hw_features));
 	blobmsg_add_u8(&b, "vht_supported", vht_supported(hapd->iface->hw_features));
+	/* a channel switch (switch_chan, CHAN_SWITCH) can widen to 160 MHz on a
+	 * radio set up narrower: hostapd adds [VHT160] for it (patch 895) */
+	blobmsg_add_u8(&b, "csa160", 1);
 #ifdef CONFIG_WPS
 	blobmsg_add_u8(&b, "wps_link_start", 1);
 	blobmsg_add_u8(&b, "wps_link_cancel", 1);
@@ -1152,6 +1155,7 @@ hostapd_switch_chan(struct ubus_context *ctx, struct ubus_object *obj,
 	};
 	u8 chwidth = hostapd_get_oper_chwidth(iconf);
 	u8 seg0 = 0, seg1 = 0;
+	u32 vht_capab;
 	int ret = UBUS_STATUS_OK;
 	int i;
 
@@ -1218,6 +1222,14 @@ hostapd_switch_chan(struct ubus_context *ctx, struct ubus_object *obj,
 		break;
 	}
 
+	/* the configured vht_capab has no [VHT160] below 160 MHz (openwrt#22436);
+	 * hostapd_switch_channel() adds it for a switch to 160 MHz (patch 895), so
+	 * check the new chandef against the hardware's here as well */
+	vht_capab = iconf->vht_capab;
+	if (chwidth == CHANWIDTH_160MHZ && mode &&
+	    (mode->vht_capab & VHT_CAP_SUPP_CHAN_WIDTH_MASK))
+		vht_capab |= VHT_CAP_SUPP_CHAN_WIDTH_160MHZ;
+
 	hostapd_set_freq_params(&css.freq_params, iconf->hw_mode,
 				css.freq_params.freq,
 				css.freq_params.channel, iconf->enable_edmg,
@@ -1228,7 +1240,7 @@ hostapd_switch_chan(struct ubus_context *ctx, struct ubus_object *obj,
 				css.freq_params.eht_enabled,
 				css.freq_params.sec_channel_offset,
 				chwidth, seg0, seg1,
-				iconf->vht_capab,
+				vht_capab,
 				mode ? &mode->he_capab[IEEE80211_MODE_AP] :
 				NULL,
 				mode ? &mode->eht_capab[IEEE80211_MODE_AP] :
-- 
2.43.0

