From 7667f0dddc3bff611d412ef12a505a014c3004cb Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Wed, 28 Oct 2026 11:15:00 -0500
Subject: [PATCH] wifi-scripts: a disabled radio doesn't set the regulatory
 domain

The regulatory domain is the whole system's, but setup_phy() ran
"iw reg set" with each radio's own country, disabled radios included,
and every time, whatever the domain already was; and hostapd.uc gave
every hostapd the country of the last radio in network.wireless status,
disabled or not. The default config gives a 6 GHz radio country '00',
so on an Arista C-360 with its 6 GHz radio disabled and the others set
to US, the disabled radio put the system in the world domain about two
seconds after the others set US, at every boot. ath11k hands each change
to its firmware; the IPQ8074's refused the world domain ("Failed to set
the requested Country regulatory setting"), and the 5 GHz radio's radar
check could not start (DFS start_dfs_cac() failed), on 3 of 4 boots.

Skip a disabled radio in both places, and don't set the domain again
when nl80211 reports it is already that country.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/network/config/wifi-scripts/Makefile               | 2 +-
 .../files-ucode/lib/netifd/wireless/mac80211.sh            | 7 ++++++-
 .../files-ucode/usr/share/ucode/wifi/hostapd.uc            | 3 ++-
 3 files changed, 9 insertions(+), 3 deletions(-)
 mode change 100755 => 100644 package/network/config/wifi-scripts/files-ucode/lib/netifd/wireless/mac80211.sh

diff --git a/package/network/config/wifi-scripts/Makefile b/package/network/config/wifi-scripts/Makefile
index a2c88bffdbd..da7cfa6f887 100644
--- a/package/network/config/wifi-scripts/Makefile
+++ b/package/network/config/wifi-scripts/Makefile
@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=wifi-scripts
 PKG_VERSION:=1.0
-PKG_RELEASE:=6
+PKG_RELEASE:=7
 PKG_LICENSE:=GPL-2.0
 
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
diff --git a/package/network/config/wifi-scripts/files-ucode/lib/netifd/wireless/mac80211.sh b/package/network/config/wifi-scripts/files-ucode/lib/netifd/wireless/mac80211.sh
old mode 100755
new mode 100644
index 506be9f47a4..c100ec1fa0a
--- a/package/network/config/wifi-scripts/files-ucode/lib/netifd/wireless/mac80211.sh
+++ b/package/network/config/wifi-scripts/files-ucode/lib/netifd/wireless/mac80211.sh
@@ -70,7 +70,12 @@ function setup_phy(phy, config, data) {
 	config.channel = +config.channel;
 	config.frequency = get_channel_frequency(config.band, config.channel);
 
-	if (config.country_code) {
+	/* the regulatory domain is the whole system's: a disabled radio does not
+	 * set it, and it is not set again to what it already is (each change goes
+	 * to the drivers, and ath11k firmware refuses the world domain, which
+	 * then breaks DFS on the radios in use) */
+	let reg = nl80211.request(nl80211.const.NL80211_CMD_GET_REG);
+	if (config.country_code && !config.disabled && config.country_code != reg?.reg_alpha2) {
 		log(`Setting country code to ${config.country_code}`);
 		system(`iw reg set ${config.country_code}`);
 	}
diff --git a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc
index 5bddafe5f9f..bdf0cd70720 100644
--- a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc
+++ b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/hostapd.uc
@@ -102,7 +102,8 @@ function device_log_append(config) {
 function device_country_code(config) {
 	let status = global.ubus.call('network.wireless', 'status');
 	for (let name, radio in status) {
-		if (!radio.config.country)
+		/* a disabled radio's country is not the system's */
+		if (!radio.config.country || radio.disabled || radio.config.disabled)
 			continue;
 		config.country_code = radio.config.country;
 	}
-- 
