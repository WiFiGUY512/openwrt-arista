From 5c9a84d5c324b6863f7a6b88bfc059fd1f016ead Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Sat, 31 Oct 2026 10:38:06 -0500
Subject: [PATCH] ucode: decode the new timestamp messages on 32-bit

ucode patch 016 (for upstream), B74: on a 32-bit system with a 64-bit
time_t (the W-118's armv7 musl), ucode-mod-socket decoded every
SO_TIMESTAMP and SO_TIMESTAMPNS message with the old layout, so every
receive timestamp came out in whole seconds ({ sec, usec: 0 },
{ sec, nsec: 0 }). musl names only SO_TIMESTAMP and SO_TIMESTAMPNS, the
kernel's _NEW values there, so ucode left its _NEW decoders out and its
_OLD fallbacks took those values. Build the 64-bit-field decoders always,
decode a libc's single name with the layout its time_t gives, and give
st_timeval_new its own size. Still in upstream master.

The first version of this patch (in -82) only put the _NEW entries first,
which changes nothing on musl, where there are none: on the W-118, -82's
ucode-mod-socket still gave whole seconds; this one gives
{ sec, usec: 291918 } and { sec, nsec: 293721501 }.

On 32-bit this also undoes a step back from 0052 (2e0b25a2): before it
SO_TIMESTAMPNS arrived raw and a script could decode it itself; with it
the message was decoded, but wrongly, in whole seconds. 64-bit targets
(qualcommax: C-230, C-260, C-360, W-318) decode both right either way.

Bump PKG_RELEASE.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/utils/ucode/Makefile                  |  2 +-
 ...timestamp-control-messages-on-time64.patch | 96 +++++++++++++++++++
 2 files changed, 97 insertions(+), 1 deletion(-)
 create mode 100644 package/utils/ucode/patches/016-socket-decode-the-new-timestamp-control-messages-on-time64.patch

diff --git a/package/utils/ucode/Makefile b/package/utils/ucode/Makefile
index 6dfb79c073..4fe6cc8600 100644
--- a/package/utils/ucode/Makefile
+++ b/package/utils/ucode/Makefile
@@ -8,7 +8,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=ucode
-PKG_RELEASE:=2
+PKG_RELEASE:=4
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=https://github.com/ucode-lang/ucode.git
diff --git a/package/utils/ucode/patches/016-socket-decode-the-new-timestamp-control-messages-on-time64.patch b/package/utils/ucode/patches/016-socket-decode-the-new-timestamp-control-messages-on-time64.patch
new file mode 100644
index 0000000000..8636554a7f
--- /dev/null
+++ b/package/utils/ucode/patches/016-socket-decode-the-new-timestamp-control-messages-on-time64.patch
@@ -0,0 +1,96 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Sat, 31 Oct 2026 15:22:38 -0500
+Subject: [PATCH] socket: decode receive timestamps on a 32-bit system with a
+ 64-bit time_t
+
+musl names one SO_TIMESTAMP and one SO_TIMESTAMPNS, with no _OLD and
+_NEW variants, and on a 32-bit system they are the kernel's _NEW values
+(63 and 64 on ARM), whose control messages carry 64-bit fields. Without
+SO_TIMESTAMP_NEW, the _NEW decoders were left out and the _OLD fallbacks,
+defined to SO_TIMESTAMP and SO_TIMESTAMPNS, decoded those messages with
+the old layout: tv_sec from the low half of the 64-bit seconds and the
+fraction from the high half, which is 0. Every receive timestamp came
+out in whole seconds.
+
+Build the 64-bit-field decoders on every Linux system. Where the libc
+names both variants, keep an entry for each; where it names only one,
+decode it with the layout its time_t gives: the 64-bit fields where
+time_t is wider than long. Also give st_timeval_new its own size; it had
+the size of the old struct.
+
+Seen on an Arista W-118 (IPQ4019, armv7, musl): SO_TIMESTAMP gave
+{ sec, usec: 0 } and SO_TIMESTAMPNS { sec, nsec: 0 } for every packet.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+ lib/socket.c | 20 ++++++++++++--------
+ 1 file changed, 12 insertions(+), 8 deletions(-)
+
+diff --git a/lib/socket.c b/lib/socket.c
+index 16eae444..c2b91297 100644
+--- a/lib/socket.c
++++ b/lib/socket.c
+@@ -1677,17 +1677,18 @@ static struct_t st_timeval_old = {
+ 	}
+ };
+ 
+-# ifdef SO_TIMESTAMP_NEW
++/* the kernel's SO_TIMESTAMP_NEW and SO_TIMESTAMPNS_NEW layouts, 64-bit
++ * fields everywhere; also what a libc with only one SO_TIMESTAMP (musl)
++ * gets where its time_t is wider than long */
+ struct timeval_new_local { int64_t tv_sec; int64_t tv_usec; };
+ static struct_t st_timeval_new = {
+-	.size = sizeof(struct timeval_old_local),
++	.size = sizeof(struct timeval_new_local),
+ 	.members = (member_t []){
+ 		STRUCT_MEMBER(timeval_new_local, tv, sec, DT_SIGNED),
+ 		STRUCT_MEMBER(timeval_new_local, tv, usec, DT_SIGNED),
+ 		{ 0 }
+ 	}
+ };
+-# endif
+ 
+ struct timespec_old_local { long tv_sec; long tv_nsec; };
+ static struct_t st_timespec_old = {
+@@ -1699,7 +1700,6 @@ static struct_t st_timespec_old = {
+ 	}
+ };
+ 
+-# ifdef SO_TIMESTAMPNS_NEW
+ struct timespec_new_local { long long tv_sec; long long tv_nsec; };
+ static struct_t st_timespec_new = {
+ 	.size = sizeof(struct timespec_new_local),
+@@ -1709,7 +1709,6 @@ static struct_t st_timespec_new = {
+ 		{ 0 }
+ 	}
+ };
+-# endif
+ #endif
+ 
+ #define SV_VOID		(struct_t *)0
+@@ -1906,13 +1905,18 @@ static cmsgtype_t cmsgtypes[] = {
+ #if defined(__linux__)
+ 	{ SOL_PACKET, PACKET_AUXDATA, &st_tpacket_auxdata },
+ 
++# if defined(SO_TIMESTAMP_NEW) && defined(SO_TIMESTAMPNS_NEW)
+ 	{ SOL_SOCKET, SO_TIMESTAMP_OLD, &st_timeval_old },
+-# ifdef SO_TIMESTAMP_NEW
+ 	{ SOL_SOCKET, SO_TIMESTAMP_NEW, &st_timeval_new },
+-# endif
+ 	{ SOL_SOCKET, SO_TIMESTAMPNS_OLD, &st_timespec_old },
+-# ifdef SO_TIMESTAMPNS_NEW
+ 	{ SOL_SOCKET, SO_TIMESTAMPNS_NEW, &st_timespec_new },
++# else
++	/* a libc without the _OLD and _NEW names (musl) has one SO_TIMESTAMP,
++	 * the kernel's _NEW where its time_t is wider than long */
++	{ SOL_SOCKET, SO_TIMESTAMP,
++	  sizeof(time_t) > sizeof(long) ? &st_timeval_new : &st_timeval_old },
++	{ SOL_SOCKET, SO_TIMESTAMPNS,
++	  sizeof(time_t) > sizeof(long) ? &st_timespec_new : &st_timespec_old },
+ # endif
+ 
+ 	{ SOL_SOCKET, SCM_CREDENTIALS, &st_ucred },
+-- 
+2.43.0
