From faa91872b51e3aa91068ed6e788c8d3e79a94b5e Mon Sep 17 00:00:00 2001
From: Christopher Griffin <christophergriffin05@gmail.com>
Date: Thu, 5 Nov 2026 13:24:27 -0600
Subject: [PATCH] wifi-scripts: refuse only the BSS with an unsupported option

B48, from openwrt/openwrt#26467 (branch b48-unsupported-hostapd-options) as it stands, its
PKG_RELEASE changes replaced by the port's own bumps.

With the default wpad-basic, `option bss_transition '1'` (802.11v) on one
wifi-iface takes down every BSS of its radio: hostapd refuses the whole
generated configuration at the unknown line, and netifd reports only
HOSTAPD_START_FAILED. `option bss_transition '0'` does the same, because
append() writes false as 0. wnm_sleep_mode, wnm_sleep_mode_no_keys and
proxy_arp behave alike on wpad-basic, and mbo on a build without
WPA_MBO_SUPPORT.

When one of these options is set, ask hostapd whether its build parses
it (hostapd -vwnm-ap, -vmbo, -vproxyarp). Without the feature, leave the
option out when it is off, and when it is on refuse just that BSS, with
WNM_NOT_SUPPORTED, MBO_NOT_SUPPORTED or PROXYARP_NOT_SUPPORTED as its
error, as bss_refusal() does for a key that cannot work. A configuration
without these options runs no check.

Tested on an Arista W-118 (ipq40xx, ath10k), radio on channel 36 with
two PSK BSSes, one of them carrying bss_transition:
- wpad-basic-mbedtls, before: neither BSS starts, with '1' and with '0'
  ("Line 44: unknown configuration item 'bss_transition'").
- wpad-basic-mbedtls, after: with '1' that BSS is left out
  (WNM_NOT_SUPPORTED) and the other one beacons; with '0' both beacon
  and the line is left out.
- wpad-mbedtls with the hostapd change: both beacon, bss_transition=1
  kept.

Fixes: https://github.com/openwrt/openwrt/issues/24625

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
---
 package/network/config/wifi-scripts/Makefile  |  2 +-
 .../files-ucode/usr/share/ucode/wifi/ap.uc    | 42 +++++++++++++++++++
 package/network/services/hostapd/Makefile     |  2 +-
 ...tures-indicate-WNM-MBO-and-proxy-ARP.patch | 38 +++++++++++++++++
 4 files changed, 82 insertions(+), 2 deletions(-)
 create mode 100644 package/network/services/hostapd/patches/886-build_features-indicate-WNM-MBO-and-proxy-ARP.patch

diff --git a/package/network/config/wifi-scripts/Makefile b/package/network/config/wifi-scripts/Makefile
index 4821c2ff18e..f41a4f2d5bf 100644
--- a/package/network/config/wifi-scripts/Makefile
+++ b/package/network/config/wifi-scripts/Makefile
@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=wifi-scripts
 PKG_VERSION:=1.0
-PKG_RELEASE:=12
+PKG_RELEASE:=13
 PKG_LICENSE:=GPL-2.0
 
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
diff --git a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/ap.uc b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/ap.uc
index c82c1e3044d..8d2ef45c8d0 100644
--- a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/ap.uc
+++ b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/ap.uc
@@ -54,6 +54,44 @@ function sae_password_available(config) {
 		sae_password_option(config);
 }
 
+/* options hostapd parses only when built with a feature that wpad-basic and
+ * wpad-mini leave out; hostapd refuses its whole configuration, every BSS of
+ * the radio, at a line it cannot parse */
+const FEATURE_OPTIONS = [
+	{ feature: 'wnm-ap', refusal: 'WNM_NOT_SUPPORTED',
+	  options: [ 'bss_transition', 'wnm_sleep_mode', 'wnm_sleep_mode_no_keys' ] },
+	{ feature: 'mbo', refusal: 'MBO_NOT_SUPPORTED', options: [ 'mbo' ] },
+	{ feature: 'proxyarp', refusal: 'PROXYARP_NOT_SUPPORTED', options: [ 'proxy_arp' ] },
+];
+
+let hostapd_features = {};
+
+function hostapd_has_feature(feature) {
+	hostapd_features[feature] ??= system(`/usr/sbin/hostapd -v${feature} >/dev/null 2>&1`) == 0;
+
+	return hostapd_features[feature];
+}
+
+/* without the feature, leave such an option out when it is off, and refuse
+ * only this BSS when it is on */
+function feature_refusal(config) {
+	for (let entry in FEATURE_OPTIONS) {
+		let set = filter(entry.options, (option) => config[option] != null);
+
+		if (!length(set) || hostapd_has_feature(entry.feature))
+			continue;
+
+		for (let option in set) {
+			if (config[option])
+				return entry.refusal;
+
+			delete config[option];
+		}
+	}
+
+	return null;
+}
+
 function bss_refusal(config, band) {
 	const personal = config.auth_type in [ 'psk', 'psk2', 'sae', 'psk-sae', 'psk-sae-compat' ];
 	const kind = key_kind(config.key);
@@ -722,6 +760,10 @@ export function owe_transition(config, band) {
 };
 
 export function generate(interface, data, config, vlans, stas, phy_features) {
+	const unsupported = feature_refusal(config);
+	if (unsupported)
+		return unsupported;
+
 	config.ctrl_interface = '/var/run/hostapd';
 
 	config.start_disabled = data.ap_start_disabled;
diff --git a/package/network/services/hostapd/Makefile b/package/network/services/hostapd/Makefile
index ffaa0965d59..dcf5d61df2c 100644
--- a/package/network/services/hostapd/Makefile
+++ b/package/network/services/hostapd/Makefile
@@ -5,7 +5,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=hostapd
-PKG_RELEASE:=13
+PKG_RELEASE:=14
 
 PKG_SOURCE_URL:=https://w1.fi/hostap.git
 PKG_SOURCE_PROTO:=git
diff --git a/package/network/services/hostapd/patches/886-build_features-indicate-WNM-MBO-and-proxy-ARP.patch b/package/network/services/hostapd/patches/886-build_features-indicate-WNM-MBO-and-proxy-ARP.patch
new file mode 100644
index 00000000000..256059d894e
--- /dev/null
+++ b/package/network/services/hostapd/patches/886-build_features-indicate-WNM-MBO-and-proxy-ARP.patch
@@ -0,0 +1,38 @@
+From: Christopher Griffin <christophergriffin05@gmail.com>
+Date: Tue, 3 Nov 2026 23:40:00 -0600
+Subject: [PATCH] build_features: indicate WNM, MBO and proxy ARP
+
+A program that configures hostapd cannot tell whether the build parses
+bss_transition, wnm_sleep_mode and wnm_sleep_mode_no_keys (CONFIG_WNM_AP),
+mbo (CONFIG_MBO) or proxy_arp (CONFIG_PROXYARP); a build without one
+refuses the whole configuration at such a line, as an unknown item.
+Answer "wnm-ap", "mbo" and "proxyarp" in has_feature(), so that
+`hostapd -vwnm-ap` and the others tell it.
+
+CONFIG_WNM alone does not tell it: wpa_supplicant's Makefile sets
+CONFIG_WNM for CONFIG_MBO, so a multicall wpad-basic defines CONFIG_WNM
+but not CONFIG_WNM_AP, and refuses bss_transition.
+
+Signed-off-by: Christopher Griffin <christophergriffin05@gmail.com>
+---
+--- a/src/utils/build_features.h
++++ b/src/utils/build_features.h
+@@ -79,6 +79,18 @@ static inline int has_feature(const char
+ 	if (!strcmp(feat, "robust-av-scs"))
+ 		return 1;
+ #endif
++#ifdef CONFIG_WNM_AP
++	if (!strcmp(feat, "wnm-ap"))
++		return 1;
++#endif
++#ifdef CONFIG_MBO
++	if (!strcmp(feat, "mbo"))
++		return 1;
++#endif
++#ifdef CONFIG_PROXYARP
++	if (!strcmp(feat, "proxyarp"))
++		return 1;
++#endif
+ 	return 0;
+ }
+ 
-- 
