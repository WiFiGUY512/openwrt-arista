diff --git a/target/linux/qualcommax/dts/ipq8071-c-230.dts b/target/linux/qualcommax/dts/ipq8071-c-230.dts
new file mode 100644
index 0000000000..36cc1c9039
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq8071-c-230.dts
@@ -0,0 +1,545 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq8074.dtsi"
+#include "ipq8074-ac-cpu.dtsi"
+#include "ipq8074-ess.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Arista C-230";
+	compatible = "arista,c-230", "qcom,ipq8074";
+
+	aliases {
+		serial0 = &blsp1_uart5;
+		serial1 = &blsp1_uart3;
+		led-boot = &led_power_orange;
+		led-failsafe = &led_power_orange;
+		led-running = &led_power_green;
+		led-upgrade = &led_power_orange;
+		label-mac-device = &port_lan1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x40000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		reset {
+			label = "reset";
+			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	led-spi {
+		compatible = "spi-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		sck-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+		mosi-gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
+
+		led_gpio: led-gpio@0 {
+			compatible = "fairchild,74hc595";
+			reg = <0>;
+			enable-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+			spi-max-frequency = <100000>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			registers-number = <2>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <2>;
+			gpios = <&led_gpio 0 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-1 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <2>;
+			gpios = <&led_gpio 1 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-2 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <1>;
+			gpios = <&led_gpio 2 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-3 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <1>;
+			gpios = <&led_gpio 3 GPIO_ACTIVE_HIGH>;
+		};
+
+		/* the QCA9882: "multifunction" on the panel */
+		led-4 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN;
+			gpios = <&led_gpio 4 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-5 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_WLAN;
+			gpios = <&led_gpio 5 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-8 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_5GHZ;
+			gpios = <&led_gpio 8 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-9 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_WLAN_5GHZ;
+			gpios = <&led_gpio 9 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-10 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_2GHZ;
+			gpios = <&led_gpio 10 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-11 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_WLAN_2GHZ;
+			gpios = <&led_gpio 11 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_power_green: led-12 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&led_gpio 12 GPIO_ACTIVE_HIGH>;
+		};
+
+		/* the one the bootloader lights ("LED INIT with value 0x2000") */
+		led_power_orange: led-13 {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&led_gpio 13 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
+
+&soc {
+	/* QUP6 as SPI, for the TPM (ipq8074.dtsi has it only as I2C) */
+	blsp1_spi6: spi@78ba000 {
+		compatible = "qcom,spi-qup-v2.2.1";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0x078ba000 0x600>;
+		interrupts = <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_BLSP1_QUP6_SPI_APPS_CLK>,
+			 <&gcc GCC_BLSP1_AHB_CLK>;
+		clock-names = "core", "iface";
+		dmas = <&blsp_dma 22>, <&blsp_dma 23>;
+		dma-names = "tx", "rx";
+		pinctrl-0 = <&tpm_spi_pins>;
+		pinctrl-names = "default";
+
+		/* Infineon SLB 9670 TPM 2.0 */
+		tpm@0 {
+			compatible = "tcg,tpm_tis-spi";
+			reg = <0>;
+			spi-max-frequency = <12000000>;
+		};
+	};
+};
+
+&blsp1_spi1 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:sbl1";
+				reg = <0x0 0x50000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "0:mibib";
+				reg = <0x50000 0x10000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "0:bootconfig";
+				reg = <0x60000 0x20000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "0:bootconfig1";
+				reg = <0x80000 0x20000>;
+				read-only;
+			};
+
+			partition@a0000 {
+				label = "0:qsee";
+				reg = <0xa0000 0x180000>;
+				read-only;
+			};
+
+			partition@220000 {
+				label = "0:qsee_1";
+				reg = <0x220000 0x180000>;
+				read-only;
+			};
+
+			partition@3a0000 {
+				label = "0:devcfg";
+				reg = <0x3a0000 0x10000>;
+				read-only;
+			};
+
+			partition@3b0000 {
+				label = "0:devcfg_1";
+				reg = <0x3b0000 0x10000>;
+				read-only;
+			};
+
+			partition@3c0000 {
+				label = "0:apdp";
+				reg = <0x3c0000 0x10000>;
+				read-only;
+			};
+
+			partition@3d0000 {
+				label = "0:apdp_1";
+				reg = <0x3d0000 0x10000>;
+				read-only;
+			};
+
+			partition@3e0000 {
+				label = "0:rpm";
+				reg = <0x3e0000 0x40000>;
+				read-only;
+			};
+
+			partition@420000 {
+				label = "0:rpm_1";
+				reg = <0x420000 0x40000>;
+				read-only;
+			};
+
+			partition@460000 {
+				label = "0:cdt";
+				reg = <0x460000 0x10000>;
+				read-only;
+			};
+
+			partition@470000 {
+				label = "0:cdt_1";
+				reg = <0x470000 0x10000>;
+				read-only;
+			};
+
+			partition@480000 {
+				label = "0:appsblenv";
+				reg = <0x480000 0x10000>;
+			};
+
+			partition@490000 {
+				label = "0:appsbl";
+				reg = <0x490000 0x100000>;
+				read-only;
+			};
+
+			partition@590000 {
+				label = "0:appsbl_1";
+				reg = <0x590000 0x100000>;
+				read-only;
+			};
+
+			partition@690000 {
+				label = "0:art";
+				reg = <0x690000 0x40000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					/* 0x6-0x12 and 0x1e hold the reference design's placeholders */
+					macaddr_art_0: macaddr@0 {
+						reg = <0x0 0x6>;
+					};
+
+					macaddr_art_18: macaddr@18 {
+						reg = <0x18 0x6>;
+					};
+
+					caldata_ipq8074: calibration@1000 {
+						reg = <0x1000 0x20000>;
+					};
+
+					caldata_qca988x: calibration@33000 {
+						reg = <0x33000 0x844>;
+					};
+				};
+			};
+
+			/* the Aquantia PHY's firmware, which the bootloader loads */
+			partition@6d0000 {
+				label = "0:ethphyfw";
+				reg = <0x6d0000 0x80000>;
+				read-only;
+			};
+
+			partition@750000 {
+				label = "0:hlos";
+				reg = <0x750000 0x800000>;
+				read-only;
+			};
+
+			partition@f50000 {
+				label = "0:hlos_1";
+				reg = <0xf50000 0x800000>;
+				read-only;
+			};
+
+			partition@1750000 {
+				label = "config";
+				reg = <0x1750000 0x400000>;
+				read-only;
+			};
+
+			partition@1b50000 {
+				label = "logging";
+				reg = <0x1b50000 0x100000>;
+				read-only;
+			};
+
+			partition@1c50000 {
+				label = "devcert";
+				reg = <0x1c50000 0x20000>;
+				read-only;
+			};
+
+			partition@1c70000 {
+				label = "reserved";
+				reg = <0x1c70000 0x390000>;
+				read-only;
+			};
+		};
+	};
+};
+
+/*
+ * the CSR8811 Bluetooth controller (RTS/CTS; enable on gpio51); it needs
+ * its PS keys loaded over BCSP before it runs as an H4 controller
+ */
+&blsp1_uart3 {
+	status = "okay";
+};
+
+&blsp1_uart5 {
+	status = "okay";
+};
+
+&edma {
+	status = "okay";
+};
+
+/* no reset-gpios: a reset of the AQR114C (gpio44) loses the firmware the bootloader loaded */
+&mdio {
+	status = "okay";
+
+	/* Ethernet 2 */
+	ar8033: ethernet-phy@2 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <2>;
+	};
+
+	/* Ethernet 1 */
+	aqr114c_8: ethernet-phy@8 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <8>;
+	};
+};
+
+&pcie0 {
+	status = "okay";
+	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
+
+	pcie@0 {
+		/* QCA9882: the third radio, 2.4/5 GHz */
+		wifi@0,0 {
+			compatible = "qcom,ath10k";
+			reg = <0x00010000 0 0 0 0>;
+			nvmem-cells = <&caldata_qca988x>;
+			nvmem-cell-names = "calibration";
+		};
+	};
+};
+
+&pcie_qmp0 {
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	/* absorbs the partitions the bootloader adds at boot */
+	partitions {
+		status = "disabled";
+	};
+
+	nand@0 {
+		reg = <0>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* the stock firmware's first slot */
+			partition@0 {
+				label = "rootfs";
+				reg = <0x0 0x10000000>;
+				linux,rootfs;
+			};
+
+			/* the stock firmware's second slot, kept as a fallback */
+			partition@10000000 {
+				label = "rootfs_1";
+				reg = <0x10000000 0x10000000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&qusb_phy_0 {
+	status = "okay";
+};
+
+&ssphy_0 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			ethernet = <&edma>;
+			phy-mode = "internal";
+
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			label = "lan2";
+			phy-handle = <&ar8033>;
+			phy-mode = "sgmii";
+			pcs-handle = <&uniphy0 0>;
+			nvmem-cells = <&macaddr_art_18>;
+			nvmem-cell-names = "mac-address";
+		};
+
+		port_lan1: port@5 {
+			reg = <5>;
+			label = "lan1";
+			phy-handle = <&aqr114c_8>;
+			phy-mode = "usxgmii";
+			managed = "in-band-status";
+			pcs-handle = <&uniphy1 0>;
+			nvmem-cells = <&macaddr_art_0>;
+			nvmem-cell-names = "mac-address";
+		};
+	};
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio52";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	/* the TPM is held in reset while gpio62 is low */
+	tpm-reset-hog {
+		gpio-hog;
+		gpios = <62 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "tpm-reset";
+	};
+
+	tpm_spi_pins: tpm-spi-state {
+		pins = "gpio0", "gpio2", "gpio9", "gpio16";
+		function = "blsp5_spi";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
