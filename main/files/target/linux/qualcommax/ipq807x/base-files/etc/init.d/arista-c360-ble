#!/bin/sh /etc/rc.common
# Arista C-360: power the nRF52833 BLE controller on once bluetooth-uart has
# attached it (hci0), with a static random address from this unit's BLE MAC
# (0:ART at 0x40, the top two bits set), as Arista's system does: an LE-only
# controller cannot be powered on without an identity address. It is left
# not advertising. C-360 only.

START=99

# btmgmt registers stdin with its event loop: give it a pipe, and a bound.
run_bounded() {
	local secs=$1 pid s=0
	shift
	true | "$@" >/dev/null 2>&1 &
	pid=$!
	while kill -0 $pid 2>/dev/null; do
		if [ $s -ge $secs ]; then
			kill $pid 2>/dev/null
			sleep 1
			kill -9 $pid 2>/dev/null
			return 124
		fi
		sleep 1
		s=$((s + 1))
	done
	wait $pid
}

ble_static_addr() {
	local mtd addr b0
	mtd=$(grep -i '"0:art"' /proc/mtd | cut -d: -f1)
	[ -n "$mtd" ] || return 1
	addr=$(hexdump -s 0x40 -n 6 -e '6/1 "%02x "' "/dev/$mtd" 2>/dev/null)
	case "$addr" in
	""|"ff ff ff ff ff ff"*|"00 00 00 00 00 00"*) return 1 ;;
	esac
	set -- $addr
	b0=$(printf '%02x' $((0x$1 | 0xc0)))
	echo "$b0:$2:$3:$4:$5:$6"
}

boot() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in arista,c360|arista,c-360) ;; *) return 0 ;; esac
	command -v btmgmt >/dev/null || return 0
	( exec 1000>&-
	  i=0
	  while [ ! -d /sys/class/bluetooth/hci0 ] && [ $i -lt 60 ]; do
		sleep 1
		i=$((i + 1))
	  done
	  [ -d /sys/class/bluetooth/hci0 ] || { logger -t arista-c360-ble "no hci0"; exit 0; }
	  i=0
	  until run_bounded 5 btmgmt --index 0 info; do
		i=$((i + 1))
		[ $i -ge 30 ] && { logger -t arista-c360-ble "hci0 never became available to mgmt"; exit 0; }
		sleep 1
	  done
	  addr=$(ble_static_addr)
	  [ -n "$addr" ] && { run_bounded 10 btmgmt --index 0 static-addr "$addr" ||
		logger -t arista-c360-ble "static-addr $addr rejected or timed out"; }
	  if run_bounded 10 btmgmt --index 0 power on; then
		logger -t arista-c360-ble "hci0 powered on, static address ${addr:-none} (not advertising)"
	  else
		logger -t arista-c360-ble "hci0 power on failed or timed out"
	  fi
	) &
}
