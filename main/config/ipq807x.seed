CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_arista_c-360=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_arista_c-260=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_arista_c-230=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_arista_c-360="airscan luci-app-airscan arista-c360-power arista-c360-radio bluetooth-uart tpm2-tools kmod-usb-storage kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1 kmod-bonding"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_arista_c-260="airscan luci-app-airscan arista-c260-power arista-c260-bluetooth kmod-usb-storage kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1 kmod-bonding"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_arista_c-230="airscan luci-app-airscan arista-c230-power arista-c230-bluetooth tpm2-tools kmod-usb-storage kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1"
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_ATH_DEBUG=y
CONFIG_PACKAGE_ATH_SPECTRAL=y
CONFIG_ALL_KMODS=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_kmod-hci-uart=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_airscan=y
CONFIG_PACKAGE_luci-app-airscan=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_arista-c360-power=m
CONFIG_PACKAGE_arista-c360-radio=m
CONFIG_PACKAGE_bluetooth-uart=m
CONFIG_PACKAGE_tpm2-tools=m
CONFIG_PACKAGE_arista-c260-power=m
CONFIG_PACKAGE_arista-c260-bluetooth=m
CONFIG_PACKAGE_arista-c230-bluetooth=m
CONFIG_PACKAGE_arista-c230-power=m
CONFIG_PACKAGE_kmod-bonding=y
# IPsec with the factory identity in the TPM: built for the feed, not in the images
CONFIG_PACKAGE_strongswan=m
CONFIG_PACKAGE_strongswan-charon=m
CONFIG_PACKAGE_strongswan-swanctl=m
CONFIG_PACKAGE_strongswan-mod-tpm=m
CONFIG_PACKAGE_strongswan-mod-openssl=m
CONFIG_PACKAGE_strongswan-mod-x509=m
CONFIG_PACKAGE_strongswan-mod-pem=m
CONFIG_PACKAGE_strongswan-mod-pkcs1=m
CONFIG_PACKAGE_strongswan-mod-pkcs8=m
CONFIG_PACKAGE_strongswan-mod-pubkey=m
CONFIG_PACKAGE_strongswan-mod-constraints=m
CONFIG_PACKAGE_strongswan-mod-random=m
CONFIG_PACKAGE_strongswan-mod-kernel-netlink=m
CONFIG_PACKAGE_strongswan-mod-socket-default=m
