CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_arista_w-118=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_ATH_DEBUG=y
CONFIG_PACKAGE_ATH_SPECTRAL=y
CONFIG_ALL_KMODS=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_kmod-hci-uart=y
CONFIG_PACKAGE_bluetooth-uart=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_bluez-utils-btmon=y
CONFIG_PACKAGE_airscan=y
CONFIG_PACKAGE_luci-app-airscan=y
CONFIG_PACKAGE_dfs-look=y
CONFIG_PACKAGE_ubi-utils=y
# optional network packages: built into the feed (not the image), so they
# install on this build's kernel and ucode ABI
CONFIG_PACKAGE_ucode-mod-uclient=m
CONFIG_PACKAGE_ucode-mod-math=m
CONFIG_PACKAGE_vxlan=m
CONFIG_PACKAGE_usteer=m
CONFIG_PACKAGE_snmpd-ssl=m
CONFIG_PACKAGE_udebugd=m
CONFIG_PACKAGE_ucode-mod-udebug=m
CONFIG_PACKAGE_udebug-cli=m
CONFIG_PACKAGE_tcpdump-mini=m
CONFIG_PACKAGE_ustp=m
CONFIG_PACKAGE_nmap=m
