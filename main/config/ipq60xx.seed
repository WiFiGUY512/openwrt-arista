CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_arista_w-318=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_arista_c-200=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_arista_w-318="airscan luci-app-airscan arista-w318-power bluetooth-uart kmod-bluetooth kmod-hci-uart bluez-utils bluez-utils-extra bluez-utils-btmon kmod-usb-storage kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1"
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_ALL_KMODS=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_dfs-look=y
CONFIG_PACKAGE_tpm2-tools=y
# in every model's images (on the others they come with airscan and the power
# policies, which the C-200 does not have)
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_lldpd=y
# the W-318's alone (no scan radio, Bluetooth or USB on the C-200): built,
# and in the W-318's image through its device packages above
CONFIG_PACKAGE_kmod-bluetooth=m
CONFIG_PACKAGE_kmod-hci-uart=m
CONFIG_PACKAGE_bluez-utils=m
CONFIG_PACKAGE_bluez-utils-extra=m
CONFIG_PACKAGE_bluez-utils-btmon=m
CONFIG_PACKAGE_arista-w318-power=m
CONFIG_PACKAGE_airscan=m
CONFIG_PACKAGE_luci-app-airscan=m
CONFIG_PACKAGE_kmod-usb-storage=m
CONFIG_PACKAGE_kmod-fs-vfat=m
CONFIG_PACKAGE_kmod-nls-cp437=m
CONFIG_PACKAGE_kmod-nls-iso8859-1=m
# IPsec with the factory identity in the TPM: built for the feed, not in the images
CONFIG_PACKAGE_strongswan=m
CONFIG_PACKAGE_strongswan-charon=m
CONFIG_PACKAGE_strongswan-swanctl=m
CONFIG_PACKAGE_strongswan-mod-tpm=m
CONFIG_PACKAGE_strongswan-mod-openssl=m
CONFIG_PACKAGE_strongswan-mod-x509=m
CONFIG_PACKAGE_strongswan-mod-pem=m
CONFIG_PACKAGE_strongswan-mod-pkcs1=m
CONFIG_PACKAGE_strongswan-mod-pkcs8=m
CONFIG_PACKAGE_strongswan-mod-pubkey=m
CONFIG_PACKAGE_strongswan-mod-constraints=m
CONFIG_PACKAGE_strongswan-mod-random=m
CONFIG_PACKAGE_strongswan-mod-kernel-netlink=m
CONFIG_PACKAGE_strongswan-mod-socket-default=m
# optional network packages: built into the feed (not the image), so they
# install on this build's kernel and ucode ABI
CONFIG_PACKAGE_ucode-mod-uclient=m
CONFIG_PACKAGE_ucode-mod-math=m
CONFIG_PACKAGE_vxlan=m
CONFIG_PACKAGE_usteer=m
CONFIG_PACKAGE_snmpd-ssl=m
CONFIG_PACKAGE_udebugd=m
CONFIG_PACKAGE_ucode-mod-udebug=m
CONFIG_PACKAGE_udebug-cli=m
CONFIG_PACKAGE_tcpdump-mini=m
CONFIG_PACKAGE_ustp=m
CONFIG_PACKAGE_nmap=m
CONFIG_PACKAGE_ATH_DEBUG=y
