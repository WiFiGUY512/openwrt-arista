#!/bin/sh
# Arista W-318: tie the radio LEDs to their phys by device path (phy numbers
# follow the order the drivers probe in). 2.4G and 5G are the IPQ6010's
# radios, 6G the QCN9072 card on pcie0. "phyNradio" lights while the radio
# is enabled.

[ "$ACTION" = add ] || exit 0
[ -n "$DEVICENAME" ] || exit 0
. /lib/functions.sh
case "$(board_name)" in arista,w318|arista,w-318) ;; *) exit 0 ;; esac

dev=$(readlink /sys/class/ieee80211/$DEVICENAME/device)
case "${dev##*/}" in
c000000.wifi)
	if iw phy "$DEVICENAME" info | grep -q "Band 1:"; then
		led=green:wlan-2ghz
	else
		led=green:wlan-5ghz
	fi
	;;
0000:01:00.0)
	led=green:wlan-6ghz
	;;
*)
	exit 0
	;;
esac

[ -w /sys/class/leds/$led/trigger ] && echo "${DEVICENAME}radio" > /sys/class/leds/$led/trigger
