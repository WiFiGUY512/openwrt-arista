// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Arista W-318 -- Qualcomm IPQ6010 based Wi-Fi 6E wall-plate access point
 *
 * Arista's own device tree is Qualcomm's IPQ6018 AP-CP01-C3 reference
 * ("qcom,ipq6018-cp01"), machid 0x8030002; the kernel names the part IPQ6010,
 * SoC version 1.0. 2 GiB DDR; 32 MiB SPI NOR (MX25U25635F) and a 3.7 GiB eMMC
 * (Kioxia 004GA0, GPT). The pins and addresses below are Arista's, read from
 * its tree (U-Boot `fdt print` of the FIT in 0:HLOS); the layout follows
 * OpenWrt's Cambium XE3-4, the same reference board.
 *
 * Here: the console, Ethernet (the 2.5 GbE uplink and three LAN ports), the
 * radios (the IPQ6010's own 2.4 and 5 GHz, and the QCN9072 on PCIe), the
 * nRF52833 Bluetooth module, the TPM, USB, the button and the LEDs; the MACs
 * from 0:ART, as Arista's system reads them. So far it is booted from RAM
 * only: every NOR partition is read-only, the environment included, until
 * the install is settled.
 */

/dts-v1/;

#include "ipq6018.dtsi"
#include "ipq6018-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Arista W-318";
	compatible = "arista,w318", "qcom,ipq6018-cp01", "qcom,ipq6018";

	aliases {
		serial0 = &blsp1_uart3;
		serial1 = &blsp1_uart2;
		ethernet0 = &dp5;
		ethernet1 = &dp2;
		ethernet2 = &dp3;
		ethernet3 = &dp4;
		label-mac-device = &dp5;
		led-boot = &led_power_amber;
		led-failsafe = &led_power_amber;
		led-running = &led_power_green;
		led-upgrade = &led_power_amber;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " pcie_ports=compat";
	};

	/*
	 * The one button outside: gpio23, low while pressed (seen on a unit).
	 * Arista's tree calls it "wps"; its "reset" (a power key) at gpio19 is
	 * driven by no button outside, so it is left out.
	 */
	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	/*
	 * Nine direct GPIO LEDs, named by an LED walk on a unit (Arista's names
	 * in brackets): the power LED green (pwr) and amber (conf), the uplink's
	 * green and orange (lan1-g/o), one per radio, and one green/amber LED,
	 * "Network 1/2/3", for the three LAN ports (lan2-g/o).
	 */
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_power_green: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
		};

		led_power_amber: led-1 {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
		};

		led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = "uplink";
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};

		led-3 {
			color = <LED_COLOR_ID_ORANGE>;
			function = "uplink";
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		};

		led-6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_6GHZ;
			gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		};

		led-7 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		};

		led-8 {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_LAN;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&rpm {
	status = "disabled";
};

&tlmm {
	/* TZ has exclusive control over GPIO20 (as on the XE3-4) */
	gpio-reserved-ranges = <20 1>;

	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi_0_pins: spi-0-state {
		pins = "gpio38", "gpio39", "gpio40", "gpio41";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-pull-down;
	};

	button_pins: button-state {
		pins = "gpio23";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	/* the nRF52833's UART, four wires (Arista's hsuart_pins) */
	ble_uart_pins: ble-uart-state {
		pins = "gpio69", "gpio70", "gpio71", "gpio72";
		function = "blsp1_uart";
		drive-strength = <8>;
		bias-disable;
	};

	/* the TPM's SPI (Arista's spi_4_pins) */
	tpm_spi_pins: tpm-spi-state {
		pins = "gpio55", "gpio56", "gpio57", "gpio58";
		function = "blsp4_spi";
		drive-strength = <8>;
		bias-disable;
	};

	/*
	 * The nRF52833's reset, active low (Arista's ble_functions drives it
	 * at 0x102a000): held high, so the controller runs. gpio69, the
	 * UART's flow-control line, is the bootloader's strap, used only to
	 * update the module's firmware.
	 */
	ble-nreset-hog {
		gpio-hog;
		gpios = <42 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ble-nreset";
	};

	led_pins: led-state {
		pins = "gpio18", "gpio24", "gpio25", "gpio29", "gpio30", "gpio31",
		       "gpio33", "gpio36", "gpio43";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&sdhc {
	bus-width = <8>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&edma {
	status = "okay";
};

/*
 * Bluetooth: the nRF52833 runs Arista's Zephyr HCI controller firmware, H4
 * at 115200 without flow control, as Arista attaches it (hciattach ... any
 * 115200 noflow). serial1, so ttyMSM1.
 */
&blsp1_uart2 {
	pinctrl-0 = <&ble_uart_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* the TPM: TIS over SPI at chip select 0, 500 kHz as in Arista's tree */
&blsp1_spi5 {
	pinctrl-0 = <&tpm_spi_pins>;
	pinctrl-names = "default";
	status = "okay";

	tpm@0 {
		compatible = "tcg,tpm_tis-spi";
		reg = <0>;
		spi-max-frequency = <500000>;
	};
};

/*
 * The IPQ6010's own radios (2.4 and 5 GHz). Calibration from 0:ART at
 * 0x1000, which also holds their MACs; board data from Arista's system.
 */
&wifi {
	status = "okay";
	qcom,ath11k-calibration-variant = "Arista-W318";
};

/*
 * The QCN9072 (6 GHz, ath11k's QCN9074) on pcie0, reset gpio60 as in
 * Arista's tree. Calibration from 0:ART at 0x26800; like the C-360's cards,
 * it is expected to start only with Arista's build of its firmware.
 */
&pcie_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* ath11k has no DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-fw-memory-mode = <0>;
			qcom,ath11k-calibration-variant = "Arista-W318";
		};
	};
};

/*
 * Arista's switch: LAN ports 2, 3 and 4 on the QCA8075 (PHYs 1, 2, 3), the
 * uplink on port 5, the QCA8081 2.5 GbE PHY at 24 with PoE in. Arista's tree
 * leaves UNIPHY 0's mode unset and gives UNIPHY 1 SGMII channel 0; here
 * UNIPHY 0 is PSGMII (the QCA8075, as on the XE3-4) and UNIPHY 1 SGMII+ (the
 * QCA8081 at 2.5 Gb/s, as on the WAX610).
 */
&switch {
	status = "okay";

	switch_lan_bmp = <(ESS_PORT2 | ESS_PORT3 | ESS_PORT4)>;
	switch_wan_bmp = <ESS_PORT5>;
	switch_mac_mode = <MAC_MODE_PSGMII>;
	switch_mac_mode1 = <MAC_MODE_SGMII_PLUS>;

	qcom,port_phyinfo {
		port@2 {
			port_id = <2>;
			phy_address = <1>;
		};

		port@3 {
			port_id = <3>;
			phy_address = <2>;
		};

		port@4 {
			port_id = <4>;
			phy_address = <3>;
		};

		port@5 {
			port_id = <5>;
			phy_address = <24>;
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	ethernet-phy-package@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,qca8075-package";
		reg = <0>;

		qcom,package-mode = "psgmii";

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};
	};

	qca8081: ethernet-phy@24 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <24>;
		reset-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;
	};
};

/*
 * The panel numbers the LAN ports the other way round from the PHYs (a link
 * test on a unit): Network 1 is PHY 3 (dp4), Network 3 is PHY 1 (dp2).
 */
&dp2 {
	status = "okay";
	phy-handle = <&qca8075_1>;
	nvmem-cells = <&macaddr_art_6>;
	nvmem-cell-names = "mac-address";
	label = "lan3";
};

&dp3 {
	status = "okay";
	phy-handle = <&qca8075_2>;
	nvmem-cells = <&macaddr_art_c>;
	nvmem-cell-names = "mac-address";
	label = "lan2";
};

&dp4 {
	status = "okay";
	phy-handle = <&qca8075_3>;
	nvmem-cells = <&macaddr_art_12>;
	nvmem-cell-names = "mac-address";
	label = "lan1";
};

&dp5 {
	status = "okay";
	phy-mode = "sgmii";
	phy-handle = <&qca8081>;
	nvmem-cells = <&macaddr_art_0>;
	nvmem-cell-names = "mac-address";
	label = "uplink";
};

&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		reg = <0>;
		/* U-Boot looks for the "n25q128a11" node */
		linux,modalias = "m25p80", "n25q128a11";
		compatible = "micron,n25q128a11", "jedec,spi-nor";
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 { label = "0:SBL1"; reg = <0x0 0xc0000>; read-only; };
			partition@c0000 { label = "0:MIBIB"; reg = <0xc0000 0x10000>; read-only; };
			partition@d0000 { label = "0:BOOTCONFIG"; reg = <0xd0000 0x20000>; read-only; };
			partition@f0000 { label = "0:BOOTCONFIG1"; reg = <0xf0000 0x20000>; read-only; };
			partition@110000 { label = "0:QSEE"; reg = <0x110000 0x1a0000>; read-only; };
			partition@2b0000 { label = "0:QSEE_1"; reg = <0x2b0000 0x1a0000>; read-only; };
			partition@450000 { label = "0:DEVCFG"; reg = <0x450000 0x10000>; read-only; };
			partition@460000 { label = "0:DEVCFG_1"; reg = <0x460000 0x10000>; read-only; };
			partition@470000 { label = "0:RPM"; reg = <0x470000 0x40000>; read-only; };
			partition@4b0000 { label = "0:RPM_1"; reg = <0x4b0000 0x40000>; read-only; };
			partition@4f0000 { label = "0:CDT"; reg = <0x4f0000 0x10000>; read-only; };
			partition@500000 { label = "0:CDT_1"; reg = <0x500000 0x10000>; read-only; };

			/* read-only while the W-318 is only RAM-booted */
			partition@510000 { label = "0:APPSBLENV"; reg = <0x510000 0x10000>; read-only; };

			partition@520000 { label = "0:APPSBL"; reg = <0x520000 0x100000>; read-only; };
			partition@620000 { label = "0:APPSBL_1"; reg = <0x620000 0x100000>; read-only; };

			partition@720000 {
				label = "0:ART";
				reg = <0x720000 0x80000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/*
					 * Arista's four Ethernet MACs, the same as U-Boot's
					 * ethaddr to eth3addr: the unit's base (the uplink)
					 * and the three below it. The radios' MACs are in
					 * their calibration (0x1000, 0x26800), the BLE
					 * module's at 0x40.
					 */
					macaddr_art_0: macaddr@0 {
						reg = <0x0 0x6>;
					};

					macaddr_art_6: macaddr@6 {
						reg = <0x6 0x6>;
					};

					macaddr_art_c: macaddr@c {
						reg = <0xc 0x6>;
					};

					macaddr_art_12: macaddr@12 {
						reg = <0x12 0x6>;
					};
				};
			};

			partition@7a0000 { label = "0:HLOS"; reg = <0x7a0000 0x800000>; read-only; };
			partition@fa0000 { label = "0:HLOS_1"; reg = <0xfa0000 0x800000>; read-only; };
			partition@17a0000 { label = "CONFIG"; reg = <0x17a0000 0x400000>; read-only; };
			partition@1ba0000 { label = "DEVCERT"; reg = <0x1ba0000 0x20000>; read-only; };
			partition@1bc0000 { label = "SYS_DATA"; reg = <0x1bc0000 0x220000>; read-only; };
			partition@1de0000 { label = "RESERVED"; reg = <0x1de0000 0x220000>; read-only; };
		};
	};
};
