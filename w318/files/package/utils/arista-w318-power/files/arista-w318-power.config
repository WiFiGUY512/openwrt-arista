config policy 'main'
	# Arista's PoE power policy: on 802.3at (or af) power without a DC
	# supply, cut the USB port's power and cap the radios' transmit power
	# (dBm, Arista's). 0 here: full power whatever the supply.
	option enabled '1'
	option usb '1'
	option radios '1'
	option txpower_2g '18'
	option txpower_5g '17'
	option txpower_6g '17'
	# Network 1's PoE output, on when the W-318 itself runs on 802.3bt
	option pse '1'
	# the power LED: amber while the power is reduced, green at full power;
	# 0 leaves it green
	option led '1'
	# the power a switch allocated by LLDP decides the class
	option lldp '1'
	# seconds between readings of the input
	option interval '30'
