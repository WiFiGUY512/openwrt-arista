config policy 'main'
	# Arista's PoE power policy: on 802.3af power without a DC supply, run
	# the 5 GHz radio on 2 of its 4 chains (antenna mask, TX and RX), cap
	# the serving radios' transmit power (dBm), and turn the USB port and the
	# Bluetooth controller off. 0 here: full power whatever the supply.
	option enabled '1'
	option usb '1'
	option bluetooth '1'
	option radios '1'
	option txpower_2g '20'
	option txpower_5g '22'
	option chains '1'
	option chains_5g '48'
	# the beamformer's antennas with them (hostapd's sounding dimension)
	option beamformer_5g '2'
	# the power LED: orange while the power is reduced, green at full power;
	# 0 leaves it green
	option led '1'
	# the power a switch allocated by LLDP decides Ethernet 1's class
	option lldp '1'
	# seconds between readings of the inputs
	option interval '30'
