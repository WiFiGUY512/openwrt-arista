#!/bin/sh
# Arista C-230: LLDP on both Ethernet ports, sent and received, as on
# Arista's system. The power policy reads from it the power the switch
# allocated on Ethernet 1. CDP, FDP, EDP and SONMP stay off. An lldpd
# configuration changed from the package's default is left alone.

. /lib/functions.sh

[ "$(board_name)" = arista,c-230 ] || exit 0
[ "$(uci -q get lldpd.config)" = lldpd ] || exit 0
[ "$(uci -q get lldpd.config.interface)" = "loopback lan" ] || exit 0

uci -q delete lldpd.config.interface
for p in lan1 lan2; do
	uci add_list lldpd.config.interface=$p
done
for p in enable_cdp enable_fdp enable_edp enable_sonmp; do
	uci set lldpd.config.$p=0
done
uci set lldpd.config.enable_lldp=1
# the switch shows the ports by name rather than by MAC
uci set lldpd.config.lldp_portidsubtype=ifname
uci -q delete lldpd.config.readonly_mode
uci -q delete lldpd.config.lldp_location
uci commit lldpd

# installed into a running system: start over with the new configuration
[ -n "$IPKG_INSTROOT" ] || ! /etc/init.d/lldpd running 2>/dev/null || /etc/init.d/lldpd restart
exit 0
