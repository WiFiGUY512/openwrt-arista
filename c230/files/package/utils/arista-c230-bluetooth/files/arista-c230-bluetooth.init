#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
#
# The Arista C-230's Bluetooth controller (/usr/sbin/arista-c230-bluetooth):
# started and powered on as the C-360's is, but left NOT advertising.

START=60
USE_PROCD=1

start_service() {
	grep -qx 'arista,c-230' /tmp/sysinfo/board_name 2>/dev/null || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/arista-c230-bluetooth
	procd_set_param respawn 3600 10 5
	procd_set_param stderr 1
	procd_close_instance
}
