#!/bin/sh
# arista-c230-install: install OpenWrt to NAND slot 0 of an Arista C-230, from
# the RAM installer: arista-c260-install (the C-260's) with the C-230's boot
# configuration (config@ac02), its slot-1 check (Arista's C-230 system holds
# the board data, but no Bluetooth PS keys), and --no-backup.
#
#	arista-c230-install [--dry-run] [--yes] [--no-backup] [--stick DIR]
#
# Run it from the OpenWrt RAM installer (initramfs). DIR (or c230/ on a FAT32
# USB stick) holds factory.ubi and SHA256SUMS: a line "<sha256>  factory.ubi",
# and "<sha256> volume:kernel <bytes>" and "<sha256> volume:rootfs <bytes>".
# Steps, each refusing to go on if the one before failed:
#
#   1. Checks: a C-230; running from RAM, not from NAND; the expected flash
#      layout; the image's checksums; and slot 1, which OpenWrt always keeps:
#      it must hold an Arista root filesystem with the IPQ8074 board data,
#      and its kernel (NOR 0:HLOS_1), for the fallback. On the C-230 Arista
#      may run from slot 0 (pri=0); installing replaces it, with a warning.
#   2. Backup of every flash partition to DIR, gzipped (see the C-260's).
#      --no-backup skips it, for a unit whose flash was backed up and checked
#      by other means; the environment before and after is still kept, in
#      /tmp/c230-install.
#   3. (not with --dry-run) The U-Boot environment, written once with
#      fw_setenv -s, and not at all when it is already right: the boot
#      command, which boots OpenWrt from slot 0 and falls back to Arista's own
#      boot with Arista's own settings put back (arista_boot), and pri=1, so
#      that fallback is slot 1's Arista. It is written before slot 0 is.
#   4. (not with --dry-run) ubiformat of slot 0 with factory.ubi, and a read
#      back of its kernel and rootfs volumes against the checksums.
#
# Nothing else is written: in NOR only the U-Boot environment (0:APPSBLENV).
# Without --yes it asks for the last four hex digits of the unit's MAC before
# writing. The last line is C230-INSTALL-RESULT: OK ... or FAILED: ...

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin

DRY=0 YES=0 NOBACKUP=0 STICK=
while [ $# -gt 0 ]; do
	case $1 in
	--dry-run) DRY=1 ;;
	--yes) YES=1 ;;
	--no-backup) NOBACKUP=1 ;;
	--stick) [ $# -ge 2 ] || { echo "usage: --stick DIR" >&2; exit 2; }; STICK=$2; shift ;;
	*) echo "usage: arista-c230-install [--dry-run] [--yes] [--no-backup] [--stick DIR]" >&2; exit 2 ;;
	esac
	shift
done

# The U-Boot environment the install writes, one variable a line: the C-260's
# (OpenWrt main) with the C-230's FIT configuration, config@ac02, the name its
# U-Boot gives its board. Arista's own boot comes after OpenWrt's with what
# OpenWrt's boot set put back first: its bootkernel sets bootargs only when
# pri changes, and then saves the environment, so without this a fallback
# would boot, and save, OpenWrt's bootargs, fdt_high and partition table.
BOOTCMD='setenv bootargs ${owrt_args}; run owrt_boot; run arista_boot'
ENV="owrt_args console=ttyMSM0,115200n8 rootwait panic=10
owrt_parts setenv mtdids nand0=nand0; setenv mtdparts mtdparts=nand0:0x10000000@0x0(ubi)
owrt_load ubi part ubi && ubi read 0x44000000 kernel
owrt_boot setenv fdt_high 0x4A3E0000; run owrt_parts owrt_load && bootm 0x44000000#config@ac02
arista_unset setenv mtdids; setenv mtdparts; setenv fdt_high 0x4A400000
arista_args if test \${pri} = 0; then setenv bootargs \${ba0}; else setenv bootargs \${ba1}; fi
arista_boot run arista_unset arista_args ubootscript"
ENV="$ENV
bootcmd $BOOTCMD
pri 1"

# env_is_set: every variable of $ENV reads back as it is there
env_is_set() {
	echo "$ENV" | while read -r name value; do
		[ "$(fw_printenv -n "$name" 2>/dev/null)" = "$value" ] || exit 1
	done
}

say() { echo "c230-install: $*"; }
fail() {
	echo "c230-install: ERROR: $*" >&2
	[ -n "${MNT_OURS:-}" ] && { sync; umount "$MNT_OURS" 2>/dev/null; }
	echo "C230-INSTALL-RESULT: FAILED: $*"
	exit 1
}

mkdir /tmp/arista-c230-install.lock 2>/dev/null || fail "another arista-c230-install is running"
trap 'rmdir /tmp/arista-c230-install.lock 2>/dev/null' EXIT

# --- 1. checks ---------------------------------------------------------------

case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in arista,c-230) ;; *) fail "this is not an Arista C-230" ;; esac
# From RAM, / is a tmpfs (rootfs on older kernels). From NAND it is OpenWrt's
# squashfs: ubi.mtd= on the command line does not tell, as main's device tree
# appends it to every boot's.
case "$(awk '$2 == "/" {print $3; exit}' /proc/mounts)" in
tmpfs|rootfs|ramfs) ;;
*) fail "running from NAND; boot the RAM installer first" ;;
esac

# /proc/mtd: mtdN: size erasesize "name". The names' case differs between
# 25.12's device tree and main's.
mtd_dev() { grep -i "\"$1\"\$" /proc/mtd | cut -d: -f1; }
mtd_size() { printf '%d' "0x$(grep -i "\"$1\"\$" /proc/mtd | awk '{print $2}')"; }
# slot 0: "ubi" in 25.12's device tree, "rootfs" in main's
S0=ubi
[ -n "$(mtd_dev ubi)" ] || S0=rootfs
# ubi_node /sys/class/ubi/ubiX_Y: its /dev node, made from sysfs if udev has
# not made it yet
ubi_node() {
	n=/dev/$(basename "$1")
	[ -c "$n" ] || mknod "$n" c "$(cut -d: -f1 "$1/dev")" "$(cut -d: -f2 "$1/dev")"
	echo "$n"
}
for p in $S0 rootfs_1 LOGGING 0:ART 0:APPSBLENV; do
	[ -n "$(mtd_dev "$p")" ] || fail "no flash partition \"$p\": not the expected C-230 layout"
done
[ "$(mtd_size $S0)" = $((0x10000000)) ] || fail "slot 0 (\"$S0\") is $(mtd_size $S0) bytes, not 0x10000000"
fw_printenv bootcmd >/dev/null 2>&1 || fail "cannot read the U-Boot environment (fw_printenv)"
for v in ba0 ba1 ubootscript; do
	[ -n "$(fw_printenv -n $v 2>/dev/null)" ] ||
		fail "the U-Boot environment has no $v, which Arista's boot (the fallback) needs"
done

pri=$(fw_printenv -n pri 2>/dev/null)

# Slot 1 is kept, whatever pri says, and must hold Arista's root filesystem
# with the IPQ8074 board data (bdwlan.bin) the lab image also carries. Arista's
# C-230 system has no Bluetooth PS keys. rootfs_1 is read-only in the device
# tree, so attaching it cannot write it.
NEED="lib/boarddata/bdwlan.bin"
R1=$(mtd_dev rootfs_1)
ubidetach -p /dev/$R1 >/dev/null 2>&1
ubiattach -p /dev/$R1 -d 7 >/dev/null 2>&1 || fail "slot 1 (rootfs_1) has no UBI"
node=
for v in /sys/class/ubi/ubi7_*; do
	[ "$(cat $v/name 2>/dev/null)" = ubi_rootfs ] && node=$(ubi_node $v)
done
S1=/tmp/c230-slot1
rm -rf $S1
if [ -n "$node" ] && [ "$(head -c 4 $node)" = hsqs ]; then
	unsquashfs -n -d $S1 $node $NEED >/dev/null 2>&1
fi
ubidetach -d 7 >/dev/null 2>&1
[ -n "$node" ] || fail "slot 1 has no Arista root filesystem (no ubi_rootfs volume)"
for f in $NEED; do
	[ -s $S1/$f ] || fail "slot 1's Arista system has no $f, which OpenWrt copies from it"
done
rm -rf $S1
say "C-230, running from RAM; slot 1 holds Arista, with its board data"
# The fallback also needs slot 1's Arista kernel, in NOR 0:HLOS_1: on the
# C-230 a FIT image from its first byte. (hexdump: the image's BusyBox has no od.)
H1=$(mtd_dev 0:HLOS_1)
[ -n "$H1" ] || fail "no flash partition \"0:HLOS_1\" (slot 1's Arista kernel)"
[ "$(head -c 4 /dev/$H1 | hexdump -v -e '1/1 "%02x"')" = d00dfeed ] ||
	fail "0:HLOS_1 holds no Arista kernel, so slot 1 could not boot as the fallback"
[ "$pri" = 1 ] || say "WARNING: Arista calls slot ${pri:-?} its primary (pri=${pri:-unset}); installing replaces what is in slot 0, perhaps Arista's newest system. Slot 1's Arista stays as the fallback, and pri is set to 1"

# the stick
MNT_OURS=
if [ -z "$STICK" ]; then
	for d in /dev/sd[a-z]1 /dev/sd[a-z]; do
		[ -b "$d" ] || continue
		mkdir -p /mnt/c230usb
		if mount -t vfat -o rw "$d" /mnt/c230usb 2>/dev/null; then
			if [ -f /mnt/c230usb/c230/factory.ubi ]; then
				MNT_OURS=/mnt/c230usb STICK=/mnt/c230usb/c230
				break
			fi
			umount /mnt/c230usb
		fi
	done
fi
[ -n "$STICK" ] && [ -f "$STICK/factory.ubi" ] || fail "no factory.ubi (--stick DIR, or c230/ on a FAT32 USB stick)"
[ -f "$STICK/SHA256SUMS" ] || fail "no SHA256SUMS beside factory.ubi"
want=$(awk '$2 == "factory.ubi" {print $1}' "$STICK/SHA256SUMS")
have=$(sha256sum "$STICK/factory.ubi" | cut -d' ' -f1)
[ -n "$want" ] && [ "$want" = "$have" ] || fail "factory.ubi does not match its checksum"
say "image: factory.ubi $(wc -c <"$STICK/factory.ubi") bytes, checksum ok"

# --- 2. backup ---------------------------------------------------------------

mac=$(tr -d ':' </sys/class/net/lan1/address 2>/dev/null)
[ -n "$mac" ] || mac=unknown
if [ $NOBACKUP = 1 ]; then
	BK=/tmp/c230-install
	mkdir -p $BK
	cp /proc/mtd "$BK/proc-mtd.txt"
	fw_printenv >"$BK/u-boot-env.txt" 2>&1
	cat /proc/cmdline /tmp/sysinfo/model >"$BK/info.txt" 2>/dev/null
	say "--no-backup: no flash backup taken; the environment is kept in $BK"
else
	BK="$STICK/backup-$mac-$(date +%Y%m%d-%H%M%S)"
	need=0
	for n in $(cut -d: -f1 /proc/mtd | grep '^mtd'); do
		need=$((need + $(printf '%d' "0x$(grep "^$n:" /proc/mtd | awk '{print $2}')")))
	done
	# Gzipped, erased flash takes almost nothing; Arista's two systems are what
	# take room, a few hundred MiB at most.
	free=$(($(df -k "$STICK" | awk 'NR == 2 {print $4}') * 1024))
	[ $free -gt $((512 * 1048576)) ] || fail "$STICK has only $((free / 1048576)) MiB free; a backup can need up to 512 MiB"
	mkdir -p "$BK" || fail "cannot write to $STICK"
	say "backing up $((need / 1048576)) MiB of flash, gzipped, to ${BK#$STICK/}"
	cp /proc/mtd "$BK/proc-mtd.txt"
	fw_printenv >"$BK/u-boot-env.txt" 2>&1
	cat /proc/cmdline /tmp/sysinfo/model >"$BK/info.txt" 2>/dev/null
	for n in $(cut -d: -f1 /proc/mtd | grep '^mtd'); do
		name=$(grep "^$n:" /proc/mtd | sed 's/.*"\(.*\)"$/\1/' | tr ':/' '__')
		f="$BK/$n-$name.bin.gz"
		# The flash's checksum, then a second read compressed: the file must
		# decompress to exactly what the flash held, both times.
		a=$(sha256sum /dev/$n | cut -d' ' -f1)
		[ -n "$a" ] || fail "reading $n ($name) failed"
		gzip -c </dev/$n >"$f" || fail "writing the backup of $n ($name) failed (full?)"
		b=$(gunzip -c "$f" | sha256sum | cut -d' ' -f1)
		[ "$a" = "$b" ] || fail "backup of $n ($name) does not verify (flash $a, file $b)"
		echo "$a  $n-$name.bin" >>"$BK/SHA256SUMS"
		say "  $n $name: ok, $(($(wc -c <"$f") / 1024)) KiB"
	done
	sync
	say "backup complete and verified: ${BK#$STICK/} (gunzip each .bin.gz to restore)"
fi

if [ $DRY = 1 ]; then
	say "dry run: nothing written to flash or to the U-Boot environment"
	[ -n "$MNT_OURS" ] && { sync; umount "$MNT_OURS"; }
	echo "C230-INSTALL-RESULT: OK dry-run backup=${BK#$STICK/}"
	exit 0
fi

if [ $YES != 1 ]; then
	tail4=$(echo "$mac" | tail -c 5)
	printf 'Write OpenWrt to slot 0 of this C-230 (MAC %s)? Type %s to go on: ' "$mac" "$tail4"
	read answer
	[ "$answer" = "$tail4" ] || fail "not confirmed; nothing was written"
fi

# --- 3. boot command ---------------------------------------------------------

# pri=1: Arista's own boot (arista_boot), the fallback, starts slot 1, the
# Arista system the install keeps, not slot 0, which is about to be OpenWrt.
# Written before slot 0: a unit stopped at any point from here (a failed
# write, the power gone) tries OpenWrt, does not find it, and boots slot 1.
if env_is_set; then
	say "the U-Boot boot command is already set; the environment is not written"
else
	echo "$ENV" >/tmp/c230-env.txt
	say "setting the U-Boot boot command and pri=1 (one environment write)"
	fw_setenv -s /tmp/c230-env.txt || fail "fw_setenv failed"
	env_is_set || fail "the U-Boot environment does not read back as written"
fi
fw_printenv >"$BK/u-boot-env-after.txt" 2>&1

# --- 4. slot 0 ---------------------------------------------------------------

M=$(mtd_dev $S0)
ubidetach -p /dev/$M >/dev/null 2>&1
say "writing factory.ubi to slot 0 (/dev/$M)"
ubiformat /dev/$M -y -f "$STICK/factory.ubi" >/tmp/ubiformat.log 2>&1 || { tail -5 /tmp/ubiformat.log; fail "ubiformat failed"; }
ubiattach -p /dev/$M -d 0 >/dev/null 2>&1 || fail "slot 0 does not attach after ubiformat"
for vol in kernel rootfs; do
	line=$(awk -v v="volume:$vol" '$2 == v {print $1, $3}' "$STICK/SHA256SUMS")
	[ -n "$line" ] || fail "no checksum for volume $vol in SHA256SUMS"
	sum=${line% *} size=${line#* }
	dev=
	for v in /sys/class/ubi/ubi0_*; do
		[ "$(cat $v/name 2>/dev/null)" = $vol ] && dev=$(ubi_node $v)
	done
	[ -n "$dev" ] || fail "slot 0 has no $vol volume after ubiformat"
	got=$(head -c "$size" "$dev" | sha256sum | cut -d' ' -f1)
	[ "$got" = "$sum" ] || fail "slot 0 volume $vol reads back wrong"
	say "  volume $vol: reads back identical ($size bytes)"
done
ubidetach -d 0 >/dev/null 2>&1

[ -n "$MNT_OURS" ] && { sync; umount "$MNT_OURS"; }
say "done: reboot to start OpenWrt from NAND. To boot Arista once, stop U-Boot and run arista_boot."
echo "C230-INSTALL-RESULT: OK installed backup=${BK#$STICK/}"
