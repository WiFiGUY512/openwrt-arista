#!/bin/sh /etc/rc.common
# The IPQ8074's board data follows the wireless country: at boot, and when
# the wireless configuration changes, /etc/hotplug.d/firmware/13-arista-c230-
# board-data takes the file the country now wants, if it is not the one
# there. The radio reads it at its next start (a reboot).

START=99
USE_PROCD=1

refresh() {
	REFRESH=1 FIRMWARE=ath11k/IPQ8074/hw2.0/board.bin \
		sh /etc/hotplug.d/firmware/13-arista-c230-board-data
}

start_service() {
	. /lib/functions.sh
	[ "$(board_name)" = arista,c-230 ] || return 0
	refresh
}

service_triggers() {
	procd_add_reload_trigger wireless
}

reload_service() {
	. /lib/functions.sh
	[ "$(board_name)" = arista,c-230 ] || return 0
	refresh
}
